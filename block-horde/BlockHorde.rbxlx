      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
-- Minimal signal for talking between modules on the same machine.

local Signal = {}
Signal.__index = Signal

export type Signal = typeof(setmetatable({} :: { handlers: { (...any) -> () } }, Signal))

function Signal.new(): Signal
	return setmetatable({ handlers = {} }, Signal)
end

-- Returns a function that disconnects the handler.
function Signal.Connect(self: Signal, handler: (...any) -> ()): () -> ()
	table.insert(self.handlers, handler)
	return function()
		local index = table.find(self.handlers, handler)
		if index then
			table.remove(self.handlers, index)
		end
	end
end

function Signal.Fire(self: Signal, ...: any)
	for _, handler in table.clone(self.handlers) do
		handler(...)
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Snapshot</string>
          <string name="Source"><![CDATA[--!strict
-- Packs enemy positions into small binary buffers for the 15-per-second
-- position updates. Unreliable remote messages must stay under 900 bytes, so
-- big hordes are split across several packets.
--
-- Layout: f64 server time, then per enemy 9 bytes:
--   u16 id, u8 kind, i16 x*10, i16 z*10, u8 facing, u8 health (0-255)

local Snapshot = {}

Snapshot.HEADER = 8
Snapshot.ENTRY = 9
Snapshot.MAX_PER_PACKET = 90

local TAU = math.pi * 2

function Snapshot.create(count: number, time: number): buffer
	local buf = buffer.create(Snapshot.HEADER + count * Snapshot.ENTRY)
	buffer.writef64(buf, 0, time)
	return buf
end

local function fixed(value: number): number
	return math.clamp(math.round(value * 10), -32768, 32767)
end

-- slot is 0-based. facing is an angle in radians; health is 0-1.
function Snapshot.write(buf: buffer, slot: number, id: number, kind: number, x: number, z: number, facing: number, health: number)
	local at = Snapshot.HEADER + slot * Snapshot.ENTRY
	buffer.writeu16(buf, at, id)
	buffer.writeu8(buf, at + 2, kind)
	buffer.writei16(buf, at + 3, fixed(x))
	buffer.writei16(buf, at + 5, fixed(z))
	buffer.writeu8(buf, at + 7, math.floor((facing % TAU) / TAU * 256) % 256)
	buffer.writeu8(buf, at + 8, if health > 0 then math.clamp(math.ceil(health * 255), 1, 255) else 0)
end

function Snapshot.time(buf: buffer): number
	return buffer.readf64(buf, 0)
end

-- Calls visit for every enemy in the packet and returns the packet's server time.
function Snapshot.read(buf: buffer, visit: (id: number, kind: number, x: number, z: number, facing: number, health: number) -> ()): number
	local count = (buffer.len(buf) - Snapshot.HEADER) // Snapshot.ENTRY
	for slot = 0, count - 1 do
		local at = Snapshot.HEADER + slot * Snapshot.ENTRY
		visit(
			buffer.readu16(buf, at),
			buffer.readu8(buf, at + 2),
			buffer.readi16(buf, at + 3) / 10,
			buffer.readi16(buf, at + 5) / 10,
			buffer.readu8(buf, at + 7) / 256 * TAU,
			buffer.readu8(buf, at + 8) / 255
		)
	end
	return buffer.readf64(buf, 0)
end

return Snapshot
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Unlocks</string>
          <string name="Source"><![CDATA[--!strict
-- The unlock ladder, in the order of the original game.
-- When a player's multiplier first reaches `mult` during a run, they get the entry.
-- An entry with no `upgrade` unlocks the weapon itself; otherwise it upgrades that weapon.

export type Upgrade =
	"FastFire"
	| "RapidFire"
	| "DoubleAmmo"
	| "QuadAmmo"
	| "DoubleDamage"
	| "WideShot"
	| "WiderShot"
	| "LongShot"
	| "BigBang"
	| "BiggerBang"
	| "BigShot"
	| "UnlimitedAmmo"

export type Entry = {
	mult: number,
	weapon: string,
	upgrade: Upgrade?,
}

local Unlocks = {}

Unlocks.LADDER = {
	{ mult = 5, weapon = "uzi" },
	{ mult = 10, weapon = "shotgun" },
	{ mult = 15, weapon = "barrels" },
	{ mult = 20, weapon = "grenades" },
	{ mult = 25, weapon = "uzi", upgrade = "RapidFire" },
	{ mult = 30, weapon = "shotgun", upgrade = "BigShot" },
	{ mult = 35, weapon = "fakewalls" },
	{ mult = 40, weapon = "uzi", upgrade = "UnlimitedAmmo" },
	{ mult = 50, weapon = "mines" },
	{ mult = 55, weapon = "rockets" },
	{ mult = 60, weapon = "barrels", upgrade = "BiggerBang" },
	{ mult = 65, weapon = "grenades", upgrade = "BiggerBang" },
	{ mult = 70, weapon = "shotgun", upgrade = "RapidFire" },
	{ mult = 75, weapon = "railgun" },
	{ mult = 80, weapon = "railgun", upgrade = "RapidFire" },
	{ mult = 85, weapon = "rockets", upgrade = "RapidFire" },
	{ mult = 90, weapon = "turret" },
	{ mult = 100, weapon = "turret", upgrade = "RapidFire" },
} :: { Entry }

-- How each upgrade is written on screen, e.g. "SHOTGUN + WIDE SHOT".
Unlocks.UPGRADE_NAMES = {
	FastFire = "FAST FIRE",
	RapidFire = "RAPID FIRE",
	DoubleAmmo = "DOUBLE AMMO",
	QuadAmmo = "QUAD AMMO",
	DoubleDamage = "DOUBLE DAMAGE",
	WideShot = "WIDE SHOT",
	WiderShot = "WIDER SHOT",
	LongShot = "LONG SHOT",
	BigBang = "BIG BANG",
	BiggerBang = "BIGGER BANG",
	BigShot = "BIG SHOT",
	UnlimitedAmmo = "UNLIMITED AMMO",
} :: { [string]: string }

return Unlocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">WaveMath</string>
          <string name="Source"><![CDATA[--!strict
-- Wave sizes, enemy speed and which enemy types appear in which wave.

local Config = require(script.Parent.Config)

local WaveMath = {}

function WaveMath.count(wave: number, players: number, difficulty: Config.DifficultyDef): number
	local base = Config.WAVE_BASE + Config.WAVE_PER_WAVE * wave
	local crowd = 1 + Config.WAVE_PER_EXTRA_PLAYER * math.max(0, players - 1)
	return math.max(1, math.floor(base * crowd * difficulty.count))
end

function WaveMath.speedMultiplier(wave: number, difficulty: Config.DifficultyDef): number
	return math.min(1 + Config.WAVE_SPEED_PER_WAVE * wave, Config.WAVE_SPEED_CAP) * difficulty.speed
end

-- Fraction of the wave that is each special enemy type.
function WaveMath.shares(wave: number): { [string]: number }
	local shares: { [string]: number } = {}
	for kind, mix in Config.ENEMY_MIX do
		if wave >= mix.fromWave then
			shares[kind] = math.min(mix.share + mix.growth * (wave - mix.fromWave), mix.max)
		end
	end
	return shares
end

-- Picks an enemy type for one spawn; roll is a random number in [0, 1).
function WaveMath.pickKind(wave: number, roll: number): string
	local acc = 0
	-- Fixed order so the same roll always gives the same answer.
	for _, kind in Config.ENEMY_KINDS do
		local share = WaveMath.shares(wave)[kind]
		if share then
			acc += share
			if roll < acc then
				return kind
			end
		end
	end
	return "Zombie"
end

return WaveMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WeaponStats</string>
          <string name="Source"><![CDATA[--!strict
-- A weapon's numbers after its upgrades, with every field filled in.

local Config = require(script.Parent.Config)

export type Stats = {
	id: string,
	name: string,
	short: string,
	slot: number,
	kind: string,
	place: string?,
	fireInterval: number,
	maxAmmo: number?, -- nil = infinite
	damage: number,
	range: number,
	pierce: number,
	pellets: number,
	spread: number,
	blastRadius: number,
	speed: number,
	fuse: number,
	throwDistance: number,
	throwStep: number,
	throwMax: number,
	throwComboWindow: number,
	beam: boolean,
	tracerColor: Color3,
	turretFireInterval: number,
}

local WeaponStats = {}

local DEFAULT_TRACER = Color3.fromRGB(255, 226, 64)

-- upgrades: set of upgrade names this weapon has, e.g. { RapidFire = true }
function WeaponStats.get(weaponId: string, upgrades: { [string]: boolean }?): Stats
	local def = Config.WEAPONS[weaponId]
	assert(def, "Unknown weapon " .. weaponId)
	local stats: Stats = {
		id = weaponId,
		name = def.name,
		short = def.short,
		slot = def.slot,
		kind = def.kind,
		place = def.place,
		fireInterval = def.fireInterval,
		maxAmmo = def.maxAmmo,
		damage = def.damage or 0,
		range = def.range or 0,
		pierce = def.pierce or 1,
		pellets = def.pellets or 1,
		spread = def.spread or 0,
		blastRadius = def.blastRadius or 0,
		speed = def.speed or 0,
		fuse = def.fuse or 0,
		throwDistance = def.throwDistance or 0,
		throwStep = def.throwStep or 0,
		throwMax = def.throwMax or 0,
		throwComboWindow = def.throwComboWindow or 0,
		beam = def.beam == true,
		tracerColor = def.tracerColor or DEFAULT_TRACER,
		turretFireInterval = Config.TURRET_FIRE_INTERVAL,
	}
	if not upgrades then
		return stats
	end
	for upgrade in upgrades do
		local effect = Config.UPGRADE_EFFECTS[upgrade]
		if not effect then
			continue
		end
		if upgrade == "UnlimitedAmmo" then
			stats.maxAmmo = nil
		end
		for field, amount in effect do
			if field == "fireInterval" then
				if def.place == "turret" then
					stats.turretFireInterval *= amount
				else
					stats.fireInterval *= amount
				end
			elseif field == "maxAmmo" then
				if stats.maxAmmo then
					stats.maxAmmo = math.floor(stats.maxAmmo * amount)
				end
			elseif field == "damage" then
				stats.damage *= amount
			elseif field == "spread" then
				stats.spread *= amount
			elseif field == "pellets" then
				if stats.pellets > 1 then
					stats.pellets += amount
				end
			elseif field == "range" then
				stats.range *= amount
			elseif field == "blastRadius" then
				stats.blastRadius *= amount
			end
		end
	end
	return stats
end

-- Directions of each bullet in one shot: pellets fan out evenly across the
-- spread, with a little wobble. The seed makes the server and the shooter's
-- client pick the same wobble. Returns { {x, z}, ... } unit vectors.
function WeaponStats.pelletDirections(dirX: number, dirZ: number, stats: Stats, seed: number): { { number } }
	-- Small deterministic random generator (Park-Miller), so both sides agree.
	local state = math.max(1, math.floor(seed) % 2147483647)
	local function random(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	local spread = math.rad(stats.spread)
	local count = math.max(1, stats.pellets)
	local dirs: { { number } } = {}
	for i = 1, count do
		local angle
		if count > 1 then
			angle = -spread / 2 + spread * (i - 1) / (count - 1) + (random() - 0.5) * spread / (count * 2)
		else
			angle = (random() - 0.5) * spread
		end
		local cos, sin = math.cos(angle), math.sin(angle)
		table.insert(dirs, { dirX * cos - dirZ * sin, dirX * sin + dirZ * cos })
	end
	return dirs
end

-- "UZI + RAPID FIRE" style label for an unlock.
function WeaponStats.unlockLabel(weaponId: string, upgrade: string?, upgradeNames: { [string]: string }): string
	local def = Config.WEAPONS[weaponId]
	local name = if def then def.name else string.upper(weaponId)
	if upgrade then
		return name .. " + " .. (upgradeNames[upgrade] or string.upper(upgrade))
	end
	return "NEW WEAPON: " .. name
end

return WeaponStats
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">AmmoBoxes</string>
          <string name="Source"><![CDATA[--!strict
-- Wooden ammo crates appear on the room's 'A' cells every AMMO_BOX_INTERVAL
-- seconds (at most AMMO_BOX_MAX at once). Walking over one refills part of
-- every weapon you own.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local PropModels = require(ReplicatedStorage.Shared.Models.PropModels)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Arena = require(script.Parent.Arena)
local Loadout = require(script.Parent.Loadout)
local Placeables = require(script.Parent.Placeables)
local RunState = require(script.Parent.RunState)

local Announce = Net.event("Announce")

type Crate = { c: number, r: number, x: number, z: number, model: Model }

local AmmoBoxes = {}

local grid: RoomGrid.RoomGrid? = nil
local crates: { Crate } = {}
local timer = 0
local rng = Random.new()

function AmmoBoxes.start(g: RoomGrid.RoomGrid)
	AmmoBoxes.clear()
	grid = g
	timer = Config.AMMO_BOX_INTERVAL
end

function AmmoBoxes.clear()
	for _, crate in crates do
		crate.model:Destroy()
	end
	table.clear(crates)
end

local function spawnCrate(g: RoomGrid.RoomGrid)
	local free: { RoomGrid.Cell } = {}
	for _, cell in g:find("A") do
		local taken = false
		for _, crate in crates do
			if crate.c == cell.c and crate.r == cell.r then
				taken = true
			end
		end
		if not taken and not g:isBlocked(cell.c, cell.r) then
			local blocking = false
			for _, placeable in Placeables.list() do
				if placeable.c == cell.c and placeable.r == cell.r then
					blocking = true
				end
			end
			if not blocking then
				table.insert(free, cell)
			end
		end
	end
	if #free == 0 then
		return
	end
	local cell = free[rng:NextInteger(1, #free)]
	local x, z = g:cellCenter(cell.c, cell.r)
	local model = PropModels.ammoCrate(CFrame.new(x, 0, z))
	model.Parent = Arena.props()
	table.insert(crates, { c = cell.c, r = cell.r, x = x, z = z, model = model })
end

function AmmoBoxes.update(dt: number)
	local g = grid
	if not g then
		return
	end
	timer -= dt
	if timer <= 0 then
		timer = Config.AMMO_BOX_INTERVAL
		if #crates < Config.AMMO_BOX_MAX then
			spawnCrate(g)
		end
	end

	local reach = Config.AMMO_BOX_PICKUP_RADIUS
	for _, participant in RunState.alive() do
		local character = participant.player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			continue
		end
		for i = #crates, 1, -1 do
			local crate = crates[i]
			local dx, dz = root.Position.X - crate.x, root.Position.Z - crate.z
			if dx * dx + dz * dz <= reach * reach then
				crate.model:Destroy()
				table.remove(crates, i)
				Loadout.refill(participant.player, Config.AMMO_BOX_REFILL)
				Announce:FireClient(participant.player, "AMMO", "pickup")
			end
		end
	end
end

return AmmoBoxes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--!strict
-- Owns the arena room being played: builds it and keeps its grid for hit
-- tests, pathfinding and spawns. Clients rebuild the same grid from the
-- RoomId attribute on ReplicatedStorage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local RoomBuilder = require(script.Parent.RoomBuilder)

local Arena = {}

Arena.FOLDER = "Arena"

local current: RoomGrid.RoomGrid? = nil

function Arena.load(roomId: string): RoomGrid.RoomGrid
	local def = Rooms.ARENAS[roomId]
	assert(def, "Unknown room: " .. roomId)
	local grid = RoomGrid.new(def, Config.CELL_SIZE)
	local folder = RoomBuilder.build(grid, Arena.FOLDER)
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = folder
	current = grid
	ReplicatedStorage:SetAttribute("RoomId", roomId)
	return grid
end

function Arena.grid(): RoomGrid.RoomGrid
	return assert(current, "No arena loaded")
end

function Arena.loaded(): boolean
	return current ~= nil
end

-- Folder for placeables and ammo crates, cleared with the room.
function Arena.props(): Instance
	local folder = workspace:FindFirstChild(Arena.FOLDER)
	local props = folder and folder:FindFirstChild("Props")
	return assert(props, "No arena loaded")
end

-- World position of a spawn cell for the given player slot.
function Arena.spawnFor(slot: number): CFrame
	local grid = Arena.grid()
	local cells = grid:find("P")
	local cell = cells[(slot - 1) % #cells + 1]
	local x, z = grid:cellCenter(cell.c, cell.r)
	return CFrame.new(x, 3.5, z)
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--!strict
-- Spawns players and dresses them as blocky heroes: the Roblox avatar is
-- hidden and block parts are welded on top of it. Each player has a slot
-- (1-6) that picks their shirt color. Players outside a run respawn at their
-- home spawn (the lobby); players in a run stay down and spectate.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local HeroModel = require(ReplicatedStorage.Shared.Models.HeroModel)
local Signal = require(ReplicatedStorage.Shared.Signal)
local RunState = require(script.Parent.RunState)
local WorldSetup = require(script.Parent.WorldSetup)

local CharacterService = {}

CharacterService.Died = Signal.new() -- (player: Player)

-- Where a player who is not in a run spawns, or nil to not spawn them. Set by Main.
CharacterService.homeSpawn = function(_player: Player): CFrame?
	return nil
end

local SHIRT_PARTS: { [string]: boolean } = { Torso = true, LeftArm = true, RightArm = true, Ring = true }

local slots: { [Player]: number } = {}

local function takeFreeSlot(): number
	local taken: { [number]: boolean } = {}
	for _, slot in slots do
		taken[slot] = true
	end
	local slot = 1
	while taken[slot] do
		slot += 1
	end
	return slot
end

function CharacterService.slotOf(player: Player): number
	return slots[player] or 1
end

function CharacterService.shirtFor(slot: number): Color3
	return Config.SHIRT_COLORS[(slot - 1) % #Config.SHIRT_COLORS + 1]
end

local LEG_PARTS = {
	LeftLeg = { "LeftUpperLeg", "Left Leg" }, -- R15, R6
	RightLeg = { "RightUpperLeg", "Right Leg" },
}

local function findLeg(character: Model, which: string): BasePart?
	for _, name in LEG_PARTS[which] do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

-- Hides one piece of the Roblox avatar. Hero parts are tagged and left alone.
local function hideAvatarPiece(instance: Instance)
	if instance:IsA("Accessory") then
		task.defer(instance.Destroy, instance)
	elseif instance:IsA("BasePart") then
		instance.CollisionGroup = WorldSetup.PLAYER_GROUP
		if not instance:GetAttribute("Hero") then
			instance.Transparency = 1
			instance.CastShadow = false
		end
	elseif instance:IsA("Decal") then
		instance.Transparency = 1
	end
end

-- Name and health bar over the head. Clients keep the bar's fill up to date.
local function addNameTag(head: BasePart, player: Player, shirt: Color3)
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(120, 34)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.Name = "PlayerName"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 20)
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 16
	label.TextColor3 = shirt:Lerp(Color3.new(1, 1, 1), 0.35)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = player.DisplayName
	label.Parent = tag

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.AnchorPoint = Vector2.new(0.5, 0)
	bar.Position = UDim2.new(0.5, 0, 0, 23)
	bar.Size = UDim2.fromOffset(60, 7)
	bar.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
	bar.BorderSizePixel = 0
	bar.Parent = tag
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	tag.Parent = head
end

local function dress(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart

	humanoid.WalkSpeed = Config.WALK_SPEED
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = Config.PLAYER_MAX_HEALTH
	humanoid.Health = Config.PLAYER_MAX_HEALTH

	for _, descendant in character:GetDescendants() do
		hideAvatarPiece(descendant)
	end
	character.DescendantAdded:Connect(hideAvatarPiece)

	local shirt = CharacterService.shirtFor(CharacterService.slotOf(player))
	local hero = Instance.new("Folder")
	hero.Name = "Hero"
	for _, spec in HeroModel.parts(shirt) do
		local part = Instance.new("Part")
		part.Name = spec.name
		part.Size = spec.size
		part.Color = spec.color
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Transparency = spec.transparency or 0
		if spec.shape then
			part.Shape = spec.shape
			part.CastShadow = false
		end
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part:SetAttribute("Hero", true)
		part:SetAttribute("BaseTransparency", part.Transparency)

		-- Legs ride on the avatar's legs (top edges lined up) so the walk animation swings them.
		local anchor: BasePart = root
		local offset = spec.offset
		if spec.attach ~= "Root" then
			local leg = findLeg(character, spec.attach)
			if leg then
				anchor = leg
				offset = CFrame.new(0, leg.Size.Y / 2 - spec.size.Y / 2, 0)
			end
		end
		part.CFrame = anchor.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Part0 = anchor
		weld.Part1 = part
		weld.C0 = offset
		weld.Parent = part

		part.Parent = hero
		if spec.name == "Head" then
			addNameTag(part, player, shirt)
		end
	end
	hero.Parent = character
end

local function setHeroVisible(character: Model, visible: boolean)
	local hero = character:FindFirstChild("Hero")
	if not hero then
		return
	end
	for _, part in hero:GetChildren() do
		if part:IsA("BasePart") then
			local base = part:GetAttribute("BaseTransparency")
			part.Transparency = if visible and typeof(base) == "number" then base else 1
		end
	end
	local head = hero:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("NameTag")
	if tag and tag:IsA("BillboardGui") then
		tag.Enabled = visible
	end
end

-- Changes a player's slot and recolors their hero's shirt to match.
function CharacterService.setSlot(player: Player, slot: number)
	slots[player] = slot
	local shirt = CharacterService.shirtFor(slot)
	local character = player.Character
	local hero = character and character:FindFirstChild("Hero")
	if not hero then
		return
	end
	for _, part in hero:GetChildren() do
		if part:IsA("BasePart") and SHIRT_PARTS[part.Name] then
			part.Color = shirt
		end
	end
	local head = hero:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("NameTag")
	local label = tag and tag:FindFirstChild("PlayerName")
	if label and label:IsA("TextLabel") then
		label.TextColor3 = shirt:Lerp(Color3.new(1, 1, 1), 0.35)
	end
end

-- Puts the player at `cframe` with full health, spawning a new character if
-- they have none or are dead. Yields until done.
function CharacterService.spawnAt(player: Player, cframe: CFrame)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		player:LoadCharacterAsync()
		character = player.Character
	end
	if not character or not player.Parent then
		return
	end
	if not character:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	task.wait() -- let the engine finish placing a fresh character
	character:PivotTo(cframe)
	local current = character:FindFirstChildOfClass("Humanoid")
	if current and current.Health > 0 then
		current.Health = current.MaxHealth
	end
end

local function onCharacterAdded(player: Player, character: Model)
	dress(player, character)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		task.delay(0.15, setHeroVisible, character, false)
		CharacterService.Died:Fire(player)
		if RunState.isParticipant(player) then
			return -- run players spectate until the run ends
		end
		task.delay(Config.HUB_RESPAWN_DELAY, function()
			if player.Parent and player.Character == character and not RunState.isParticipant(player) then
				local home = CharacterService.homeSpawn(player)
				if home then
					CharacterService.spawnAt(player, home)
				end
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	slots[player] = takeFreeSlot()
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	local home = CharacterService.homeSpawn(player)
	if home then
		CharacterService.spawnAt(player, home)
	end
end

function CharacterService.start()
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		slots[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--!strict
-- The server's enemy table and simulation. Enemies are plain data (no
-- Humanoids) so the server can run hundreds of them. Each frame they follow
-- the flow field toward the nearest player, push apart from each other, slide
-- along walls, and attack players or placeables they bump into. Positions go
-- to clients as compact snapshots 15 times a second; clients draw the models.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FlowField = require(ReplicatedStorage.Shared.FlowField)
local Net = require(ReplicatedStorage.Shared.Net)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Snapshot = require(ReplicatedStorage.Shared.Snapshot)
local KillContext = require(script.Parent.KillContext)
local RoomBuilder = require(script.Parent.RoomBuilder)

local SnapshotRemote = Net.unreliable("EnemySnapshot")
local EnemyDied = Net.event("EnemyDied")
local EnemyEvent = Net.event("EnemyEvent")

export type Enemy = {
	id: number,
	kind: string,
	kindIndex: number,
	def: Config.EnemyDef,
	x: number,
	z: number,
	facing: number, -- radians; 0 faces north (-Z)
	health: number,
	maxHealth: number,
	radius: number,
	speed: number,
	damage: number,
	entering: boolean, -- still walking in through an entry gap
	enterX: number,
	enterZ: number,
	attackReadyAt: number,
	fireReadyAt: number,
	teleportReadyAt: number,
	alive: boolean,
}

export type Target = { player: Player, x: number, z: number }

local EnemyService = {}

EnemyService.Killed = Signal.new() -- (enemy: Enemy)

-- Other systems plug in here at startup (avoids modules requiring each other in a loop).
EnemyService.hooks = {
	-- The placeable blocking this cell, if any.
	blockingPlaceableAt = function(_c: number, _r: number): any
		return nil
	end,
	attackPlayer = function(_player: Player, _damage: number) end,
	attackPlaceable = function(_placeable: any, _damage: number) end,
	shootFireball = function(_enemy: Enemy, _targetX: number, _targetZ: number) end,
}

local KIND_INDEX: { [string]: number } = {}
for index, kind in Config.ENEMY_KINDS do
	KIND_INDEX[kind] = index
end

local BUCKET = 4 -- spatial hash cell size for separation
local DIRECT_CHASE = 10 -- with a clear line this close, walk straight at the player

local grid: RoomGrid.RoomGrid? = nil
local living: { Enemy } = {}
local byId: { [number]: Enemy } = {}
local lastId = 0
local field: FlowField.Field? = nil
local fieldTimer = 0
local fieldDirty = true
local snapshotTimer = 0
local pendingDeaths: { number } = {}
local buckets: { [number]: { Enemy } } = {}
local rng = Random.new()

local function angleOf(dx: number, dz: number): number
	return math.atan2(-dx, -dz)
end

local function nextId(): number
	for _ = 1, 65535 do
		lastId = lastId % 65535 + 1
		if not byId[lastId] then
			return lastId
		end
	end
	return lastId
end

local function isBlocked(g: RoomGrid.RoomGrid, c: number, r: number): (boolean, any)
	local placeable = EnemyService.hooks.blockingPlaceableAt(c, r)
	if placeable then
		return true, placeable
	end
	return g:isBlocked(c, r), nil
end

-- Whether a circle overlaps a blocked cell, and the placeable it touches (if any).
local function overlaps(g: RoomGrid.RoomGrid, x: number, z: number, radius: number): (boolean, any)
	local size = g.cellSize
	local c0 = math.floor((x - radius - g.originX) / size) + 1
	local c1 = math.floor((x + radius - g.originX) / size) + 1
	local r0 = math.floor((z - radius - g.originZ) / size) + 1
	local r1 = math.floor((z + radius - g.originZ) / size) + 1
	for r = r0, r1 do
		for c = c0, c1 do
			local blocked, placeable = isBlocked(g, c, r)
			if blocked then
				local minX = g.originX + (c - 1) * size
				local minZ = g.originZ + (r - 1) * size
				local px = math.clamp(x, minX, minX + size)
				local pz = math.clamp(z, minZ, minZ + size)
				local dx, dz = x - px, z - pz
				if dx * dx + dz * dz < radius * radius then
					return true, placeable
				end
			end
		end
	end
	return false, nil
end

-- Moves one axis at a time so enemies slide along walls. Returns the placeable
-- that stopped them, if any.
local function move(g: RoomGrid.RoomGrid, enemy: Enemy, mx: number, mz: number): any
	if overlaps(g, enemy.x, enemy.z, enemy.radius) then
		-- Already inside something (e.g. after being pushed): move freely to get out.
		enemy.x += mx
		enemy.z += mz
		return nil
	end
	local hit: any = nil
	if mx ~= 0 then
		local blocked, placeable = overlaps(g, enemy.x + mx, enemy.z, enemy.radius)
		if blocked then
			hit = placeable or hit
		else
			enemy.x += mx
		end
	end
	if mz ~= 0 then
		local blocked, placeable = overlaps(g, enemy.x, enemy.z + mz, enemy.radius)
		if blocked then
			hit = placeable or hit
		else
			enemy.z += mz
		end
	end
	return hit
end

local function bucketKey(x: number, z: number): number
	return math.floor(x / BUCKET) * 4096 + math.floor(z / BUCKET)
end

local function rebuildBuckets()
	table.clear(buckets)
	for _, enemy in living do
		local key = bucketKey(enemy.x, enemy.z)
		local bucket = buckets[key]
		if bucket then
			table.insert(bucket, enemy)
		else
			buckets[key] = { enemy }
		end
	end
end

-- Push away from overlapping neighbours.
local function separation(enemy: Enemy): (number, number)
	local sx, sz = 0, 0
	local bx, bz = math.floor(enemy.x / BUCKET), math.floor(enemy.z / BUCKET)
	for ix = bx - 1, bx + 1 do
		for iz = bz - 1, bz + 1 do
			local bucket = buckets[ix * 4096 + iz]
			if not bucket then
				continue
			end
			for _, other in bucket do
				if other == enemy then
					continue
				end
				local dx, dz = enemy.x - other.x, enemy.z - other.z
				local minDist = enemy.radius + other.radius
				local distSq = dx * dx + dz * dz
				if distSq < minDist * minDist then
					if distSq < 1e-6 then
						dx, dz = rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)
						distSq = dx * dx + dz * dz + 1e-6
					end
					local dist = math.sqrt(distSq)
					local push = (minDist - dist) / minDist
					sx += dx / dist * push
					sz += dz / dist * push
				end
			end
		end
	end
	local strength = Config.ENEMY_SEPARATION * 2
	return sx * strength, sz * strength
end

local function rebuildField(g: RoomGrid.RoomGrid, targets: { Target })
	local sources: { FlowField.CellRef } = {}
	for _, target in targets do
		local c, r = g:worldToCell(target.x, target.z)
		table.insert(sources, { c = c, r = r })
	end
	if #sources == 0 then
		field = nil
		return
	end
	field = FlowField.compute(g.width, g.height, function(c: number, r: number): number?
		if EnemyService.hooks.blockingPlaceableAt(c, r) then
			return 1 + Config.PLACEABLE_PATH_COST
		end
		if g:isBlocked(c, r) then
			return nil
		end
		return 1
	end, sources)
end

local function nearestTarget(enemy: Enemy, targets: { Target }): (Target?, number)
	local best: Target? = nil
	local bestSq = math.huge
	for _, target in targets do
		local dx, dz = target.x - enemy.x, target.z - enemy.z
		local distSq = dx * dx + dz * dz
		if distSq < bestSq then
			best, bestSq = target, distSq
		end
	end
	return best, math.sqrt(bestSq)
end

-- Vampires blink a short way toward their target.
local function teleport(g: RoomGrid.RoomGrid, enemy: Enemy, dirX: number, dirZ: number, dist: number)
	local want = math.min(enemy.def.teleportDistance or 14, dist - 3)
	if want < 3 then
		return
	end
	local wall = g:raycast(enemy.x, enemy.z, dirX, dirZ, want)
	local jump = math.min(want, wall - enemy.radius - 0.5)
	if jump < 3 then
		return
	end
	local nx, nz = enemy.x + dirX * jump, enemy.z + dirZ * jump
	if overlaps(g, nx, nz, enemy.radius) then
		return
	end
	EnemyEvent:FireAllClients("teleport", enemy.id, enemy.x, enemy.z, nx, nz)
	enemy.x, enemy.z = nx, nz
end

local function step(g: RoomGrid.RoomGrid, enemy: Enemy, dt: number, clock: number, targets: { Target })
	if enemy.entering then
		local dx, dz = enemy.enterX - enemy.x, enemy.enterZ - enemy.z
		local dist = math.sqrt(dx * dx + dz * dz)
		local stride = enemy.speed * dt
		if dist <= stride then
			enemy.x, enemy.z = enemy.enterX, enemy.enterZ
			enemy.entering = false
		else
			enemy.x += dx / dist * stride
			enemy.z += dz / dist * stride
		end
		enemy.facing = angleOf(dx, dz)
		return
	end

	local target, dist = nearestTarget(enemy, targets)
	if not target then
		return
	end
	local toX, toZ = 0, 0
	if dist > 1e-3 then
		toX, toZ = (target.x - enemy.x) / dist, (target.z - enemy.z) / dist
	end
	local clearLine = dist < 1e-3 or g:raycast(enemy.x, enemy.z, toX, toZ, dist) >= dist - 0.1

	-- Melee
	local reach = enemy.radius + Config.PLAYER_RADIUS + 0.4
	if dist <= reach and clock >= enemy.attackReadyAt then
		enemy.attackReadyAt = clock + enemy.def.attackCooldown
		EnemyService.hooks.attackPlayer(target.player, enemy.damage)
	end

	local hold = dist <= reach * 0.8 -- already touching: don't shove into the player
	if enemy.kind == "Devil" then
		if clearLine and dist <= (enemy.def.keepDistance or 0) then
			hold = true
		end
		if clearLine and dist <= (enemy.def.fireballRange or 0) and clock >= enemy.fireReadyAt then
			enemy.fireReadyAt = clock + (enemy.def.fireballInterval or 2.5) * rng:NextNumber(0.8, 1.2)
			EnemyService.hooks.shootFireball(enemy, target.x, target.z)
		end
	elseif enemy.kind == "Vampire" then
		if clock >= enemy.teleportReadyAt and dist > 7 then
			enemy.teleportReadyAt = clock + (enemy.def.teleportInterval or 4) * rng:NextNumber(0.8, 1.2)
			teleport(g, enemy, toX, toZ, dist)
		end
	end

	-- Which way to walk: straight at a nearby visible player, otherwise follow the flow field.
	local dirX, dirZ = toX, toZ
	if not (clearLine and dist < DIRECT_CHASE) and field then
		local c, r = g:worldToCell(enemy.x, enemy.z)
		local nc, nr = FlowField.next(field, c, r)
		if nc and nr then
			local cx, cz = g:cellCenter(nc, nr)
			local dx, dz = cx - enemy.x, cz - enemy.z
			local d = math.sqrt(dx * dx + dz * dz)
			if d > 1e-3 then
				dirX, dirZ = dx / d, dz / d
			end
		end
	end

	local sx, sz = separation(enemy)
	local vx = (if hold then 0 else dirX * enemy.speed) + sx
	local vz = (if hold then 0 else dirZ * enemy.speed) + sz
	local blocker = move(g, enemy, vx * dt, vz * dt)
	if blocker ~= nil and clock >= enemy.attackReadyAt then
		enemy.attackReadyAt = clock + enemy.def.attackCooldown
		EnemyService.hooks.attackPlaceable(blocker, enemy.damage)
	end

	if hold or (clearLine and dist < DIRECT_CHASE) then
		enemy.facing = angleOf(toX, toZ)
	elseif math.abs(vx) + math.abs(vz) > 0.05 then
		enemy.facing = angleOf(vx, vz)
	end
end

local function broadcast()
	local total = #living
	if total == 0 then
		return
	end
	local now = workspace:GetServerTimeNow()
	local first = 1
	while first <= total do
		local count = math.min(Snapshot.MAX_PER_PACKET, total - first + 1)
		local buf = Snapshot.create(count, now)
		for slot = 0, count - 1 do
			local enemy = living[first + slot]
			Snapshot.write(buf, slot, enemy.id, enemy.kindIndex, enemy.x, enemy.z, enemy.facing, enemy.health / enemy.maxHealth)
		end
		SnapshotRemote:FireAllClients(buf)
		first += count
	end
end

-- Sends this frame's deaths to clients in one message.
function EnemyService.flush()
	if #pendingDeaths > 0 then
		EnemyDied:FireAllClients(pendingDeaths)
		pendingDeaths = {}
	end
end

function EnemyService.start(g: RoomGrid.RoomGrid)
	EnemyService.clear()
	grid = g
end

function EnemyService.clear()
	table.clear(living)
	table.clear(byId)
	table.clear(buckets)
	pendingDeaths = {}
	field = nil
	fieldDirty = true
	EnemyEvent:FireAllClients("clear")
end

function EnemyService.markDirty()
	fieldDirty = true
end

function EnemyService.list(): { Enemy }
	return living
end

function EnemyService.count(): number
	return #living
end

-- Spawns an enemy just outside an entry gap; it walks in by itself.
function EnemyService.spawn(kind: string, cell: RoomGrid.Cell, speedMultiplier: number, damageMultiplier: number): Enemy?
	local g = grid
	local def = Config.ENEMIES[kind]
	if not g or not def then
		return nil
	end
	local cx, cz = g:cellCenter(cell.c, cell.r)
	local ox, oz = RoomBuilder.outward(g, cell.c, cell.r)
	local back = Config.ENEMY_ENTER_DISTANCE + rng:NextNumber(0, 3)
	local side = rng:NextNumber(-0.8, 0.8)
	local enemy: Enemy = {
		id = nextId(),
		kind = kind,
		kindIndex = KIND_INDEX[kind] or 1,
		def = def,
		x = cx + ox * back + (if oz ~= 0 then side else 0),
		z = cz + oz * back + (if ox ~= 0 then side else 0),
		facing = angleOf(-ox, -oz),
		health = def.health,
		maxHealth = def.health,
		radius = def.radius,
		speed = def.speed * speedMultiplier * rng:NextNumber(0.92, 1.08),
		damage = def.damage * damageMultiplier,
		entering = true,
		enterX = cx,
		enterZ = cz,
		attackReadyAt = 0,
		fireReadyAt = 0,
		teleportReadyAt = 0,
		alive = true,
	}
	enemy.fireReadyAt = rng:NextNumber(1, 2.5)
	enemy.teleportReadyAt = rng:NextNumber(2, 4)
	table.insert(living, enemy)
	byId[enemy.id] = enemy
	return enemy
end

-- Applies damage; returns true if this killed the enemy. Kills are added to
-- the context so the shooter gets the points.
function EnemyService.damage(enemy: Enemy, amount: number, context: KillContext.KillContext?): boolean
	if not enemy.alive then
		return false
	end
	enemy.health -= amount
	if enemy.health > 0 then
		return false
	end
	enemy.alive = false
	local index = table.find(living, enemy)
	if index then
		living[index] = living[#living]
		living[#living] = nil
	end
	byId[enemy.id] = nil
	if context then
		table.insert(context.kills, enemy.def.score)
	end
	table.insert(pendingDeaths, enemy.id)
	table.insert(pendingDeaths, enemy.kindIndex)
	table.insert(pendingDeaths, math.round(enemy.x * 10) / 10)
	table.insert(pendingDeaths, math.round(enemy.z * 10) / 10)
	EnemyService.Killed:Fire(enemy)
	return true
end

-- One simulation step. targets are the living run players' positions.
function EnemyService.update(dt: number, clock: number, targets: { Target })
	local g = grid
	if not g then
		return
	end
	fieldTimer -= dt
	if fieldDirty or fieldTimer <= 0 then
		rebuildField(g, targets)
		fieldTimer = Config.FLOW_FIELD_INTERVAL
		fieldDirty = false
	end
	rebuildBuckets()
	for _, enemy in living do
		step(g, enemy, dt, clock, targets)
	end
	snapshotTimer -= dt
	if snapshotTimer <= 0 then
		snapshotTimer = 1 / Config.SNAPSHOT_RATE
		broadcast()
	end
	EnemyService.flush()
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Explosions</string>
          <string name="Source"><![CDATA[--!strict
-- Every blast in the game: grenades, rockets, barrels and mines. Damages
-- enemies (full in the middle, less at the edge), the player who caused it
-- (if SELF_DAMAGE) but never teammates (unless TEAM_DAMAGE), and sets off
-- barrels and mines in range so they chain. Clients draw the fireball.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local EnemyService = require(script.Parent.EnemyService)
local KillContext = require(script.Parent.KillContext)
local Placeables = require(script.Parent.Placeables)
local PlayerHealth = require(script.Parent.PlayerHealth)
local RunState = require(script.Parent.RunState)
local Scoring = require(script.Parent.Scoring)

local ExplosionRemote = Net.event("Explosion")

local Explosions = {}

local function falloff(dist: number, radius: number): number
	local t = math.clamp(dist / math.max(radius, 1e-3), 0, 1)
	return 1 - (1 - Config.EXPLOSION_EDGE_DAMAGE) * t
end

function Explosions.explode(x: number, z: number, radius: number, damage: number, owner: Player?, cause: string)
	local context = KillContext.new(owner)
	for _, enemy in table.clone(EnemyService.list()) do
		local dx, dz = enemy.x - x, enemy.z - z
		local dist = math.sqrt(dx * dx + dz * dz)
		if dist <= radius + enemy.radius then
			EnemyService.damage(enemy, damage * falloff(math.max(0, dist - enemy.radius), radius), context)
		end
	end

	for _, participant in RunState.alive() do
		local player = participant.player
		local isOwner = player == owner
		local hurts = if isOwner then Config.SELF_DAMAGE else (owner == nil or Config.TEAM_DAMAGE)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if hurts and root and root:IsA("BasePart") then
			local dx, dz = root.Position.X - x, root.Position.Z - z
			local dist = math.sqrt(dx * dx + dz * dz)
			if dist <= radius then
				local scale = if isOwner then Config.SELF_DAMAGE_SCALE else 1
				PlayerHealth.damage(player, damage * falloff(dist, radius) * scale)
			end
		end
	end

	for _, placeable in table.clone(Placeables.list()) do
		if placeable.alive and (placeable.kind == "barrel" or placeable.kind == "mine") then
			local dx, dz = placeable.x - x, placeable.z - z
			if dx * dx + dz * dz <= radius * radius then
				Placeables.detonate(placeable, Config.BARREL_CHAIN_DELAY, owner)
			end
		end
	end

	Scoring.flush(context)
	EnemyService.flush()
	ExplosionRemote:FireAllClients(x, z, radius, cause)
end

function Explosions.start()
	Placeables.onExplode = function(placeable: Placeables.Placeable, by: Player?)
		Explosions.explode(placeable.x, placeable.z, placeable.blastRadius, placeable.blastDamage, by or placeable.owner, placeable.kind)
	end
end

return Explosions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">HighScores</string>
          <string name="Source"><![CDATA[--!strict
-- Best scores per room and difficulty, saved in OrderedDataStores.
-- Saving needs a published place with Studio API access turned on
-- (Game Settings > Security); without it, saves quietly do nothing.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

export type Row = { name: string, score: number }

local HighScores = {}

local warned = false
local names: { [number]: string } = {}

local function warnOnce(err: any)
	if not warned then
		warned = true
		warn("[Block Horde] high scores unavailable (publish the game and enable Studio API access): " .. tostring(err))
	end
end

local function store(roomId: string, difficulty: string): OrderedDataStore?
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("BlockHorde_" .. roomId .. "_" .. difficulty)
	end)
	if ok then
		return result
	end
	warnOnce(result)
	return nil
end

-- Calls fn up to three times, waiting a little longer after each failure.
local function retry(fn: () -> any): (boolean, any)
	local ok, result = false, nil
	for attempt = 1, 3 do
		ok, result = pcall(fn)
		if ok then
			return true, result
		end
		task.wait(attempt)
	end
	warnOnce(result)
	return false, result
end

local function nameFor(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and typeof(name) == "string" then name else "Player " .. userId
	names[userId] = result
	return result
end

-- Saves the score if it beats the player's best. Yields.
function HighScores.submit(roomId: string, difficulty: string, userId: number, score: number)
	local scores = store(roomId, difficulty)
	local value = math.floor(score)
	if not scores or value <= 0 or userId <= 0 then
		return
	end
	local transform: any = function(old: number?): number?
		if old and old >= value then
			return nil -- keep the old best
		end
		return value
	end
	retry(function()
		return scores:UpdateAsync(tostring(userId), transform)
	end)
end

-- The top scores for a room and difficulty, best first, or nil if unavailable. Yields.
function HighScores.top(roomId: string, difficulty: string, count: number): { Row }?
	local scores = store(roomId, difficulty)
	if not scores then
		return nil
	end
	local ok, pages = retry(function()
		return scores:GetSortedAsync(false, count)
	end)
	if not ok or not pages then
		return nil
	end
	local rows: { Row } = {}
	for _, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key) or 0
		table.insert(rows, { name = nameFor(userId), score = item.value })
	end
	return rows
end

return HighScores
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">KillContext</string>
          <string name="Source"><![CDATA[--!strict
-- Collects the kills from one shot, blast or turret burst so they can be
-- scored together (several kills at once earn a multiplier bonus).

export type KillContext = {
	owner: Player?, -- who gets the credit, if anyone
	kills: { number }, -- base score of each enemy killed
}

local KillContext = {}

function KillContext.new(owner: Player?): KillContext
	return { owner = owner, kills = {} }
end

return KillContext
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Loadout</string>
          <string name="Source"><![CDATA[--!strict
-- Which weapons and upgrades each player has this run, and their ammo.
-- Everyone starts a run with only the infinite-ammo pistol.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Unlocks = require(ReplicatedStorage.Shared.Unlocks)
local WeaponStats = require(ReplicatedStorage.Shared.WeaponStats)

local WeaponState = Net.event("WeaponState")

type State = {
	owned: { [string]: boolean },
	upgrades: { [string]: { [string]: boolean } },
	ammo: { [string]: number },
	dirty: boolean,
}

local Loadout = {}

local states: { [Player]: State } = {}

-- Sends the player's weapons, upgrades and ammo to their client.
function Loadout.sync(player: Player)
	local state = states[player]
	local owned, upgrades = {}, {}
	if state then
		for id in state.owned do
			table.insert(owned, id)
		end
		for id, set in state.upgrades do
			local names = {}
			for name in set do
				table.insert(names, name)
			end
			upgrades[id] = names
		end
		state.dirty = false
	end
	WeaponState:FireClient(player, owned, if state then state.ammo else {}, upgrades)
end

function Loadout.reset(player: Player)
	states[player] = { owned = { pistol = true }, upgrades = {}, ammo = {}, dirty = false }
	Loadout.sync(player)
end

function Loadout.clear(player: Player)
	states[player] = nil
	Loadout.sync(player)
end

function Loadout.owns(player: Player, weaponId: string): boolean
	local state = states[player]
	return state ~= nil and state.owned[weaponId] == true
end

function Loadout.stats(player: Player, weaponId: string): WeaponStats.Stats
	local state = states[player]
	return WeaponStats.get(weaponId, if state then state.upgrades[weaponId] else nil)
end

-- Spends one shot. Returns false if the weapon is empty.
function Loadout.useAmmo(player: Player, weaponId: string): boolean
	local state = states[player]
	if not state then
		return false
	end
	if Loadout.stats(player, weaponId).maxAmmo == nil then
		return true
	end
	local left = state.ammo[weaponId] or 0
	if left <= 0 then
		return false
	end
	state.ammo[weaponId] = left - 1
	state.dirty = true
	return true
end

-- Gives back a shot that could not be used (e.g. nowhere to place a barrel).
function Loadout.refund(player: Player, weaponId: string)
	local state = states[player]
	if state and Loadout.stats(player, weaponId).maxAmmo ~= nil then
		state.ammo[weaponId] = (state.ammo[weaponId] or 0) + 1
		state.dirty = true
	end
end

function Loadout.unlock(player: Player, entry: Unlocks.Entry)
	local state = states[player]
	if not state then
		return
	end
	if entry.upgrade then
		local set = state.upgrades[entry.weapon] or {}
		set[entry.upgrade] = true
		state.upgrades[entry.weapon] = set
	else
		state.owned[entry.weapon] = true
	end
	-- New weapons and ammo upgrades come fully loaded.
	local maxAmmo = Loadout.stats(player, entry.weapon).maxAmmo
	if maxAmmo and (entry.upgrade == nil or entry.upgrade == "DoubleAmmo" or entry.upgrade == "QuadAmmo") then
		state.ammo[entry.weapon] = maxAmmo
	end
	Loadout.sync(player)
end

-- Ammo box pickup: tops up every owned weapon by a fraction of its max.
function Loadout.refill(player: Player, fraction: number)
	local state = states[player]
	if not state then
		return
	end
	for id in state.owned do
		local maxAmmo = Loadout.stats(player, id).maxAmmo
		if maxAmmo then
			state.ammo[id] = math.min(maxAmmo, (state.ammo[id] or 0) + math.ceil(maxAmmo * fraction))
		end
	end
	Loadout.sync(player)
end

function Loadout.start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	-- Correct the client's ammo count now and then; it counts down on its own between syncs.
	task.spawn(function()
		while true do
			task.wait(1)
			for player, state in states do
				if state.dirty and player.Parent then
					Loadout.sync(player)
				end
			end
		end
	end)
end

-- Number key label for a weapon, e.g. "2" or "0".
function Loadout.keyLabel(weaponId: string): string
	local def = Config.WEAPONS[weaponId]
	if not def then
		return "?"
	end
	return tostring(def.slot % 10)
end

return Loadout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the lobby: a walled room south of the arena with six party pads,
-- floating score boards and the game's title. Pads are the room's '1'-'6'
-- cells, boards its 'B' cells, spawns its 'P' cells.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local RoomBuilder = require(script.Parent.RoomBuilder)

export type Pad = {
	index: number,
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
	base: Part,
	border: { Part },
	title: TextLabel,
	detail: TextLabel,
}

export type Lobby = {
	grid: RoomGrid.RoomGrid,
	pads: { Pad },
	boards: { Vector3 },
	spawns: { CFrame },
}

local LobbyBuilder = {}

local function label(parent: Instance, text: string, size: number, y: number, height: number): TextLabel
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Position = UDim2.fromScale(0, y)
	textLabel.Size = UDim2.fromScale(1, height)
	textLabel.Font = Enum.Font.FredokaOne
	textLabel.Text = text
	textLabel.TextScaled = true
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeColor3 = Color3.fromRGB(20, 20, 26)
	textLabel.TextStrokeTransparency = 0
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = size
	constraint.Parent = textLabel
	textLabel.Parent = parent
	return textLabel
end

-- An invisible anchor with a sign floating above it that always faces the camera.
function LobbyBuilder.sign(parent: Instance, at: Vector3, widthStuds: number, heightStuds: number): BillboardGui
	local anchor = Instance.new("Part")
	anchor.Name = "SignAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(at)
	anchor.Parent = parent
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(widthStuds, 0, heightStuds, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = anchor
	return gui
end

local function part(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function LobbyBuilder.build(): Lobby
	local grid = RoomGrid.new(Rooms.HUB, Config.CELL_SIZE, 0, Config.HUB_CENTER_Z)
	local folder = RoomBuilder.build(grid, "Lobby")
	local size = grid.cellSize

	local pads: { Pad } = {}
	for index = 1, 6 do
		local cells = grid:find(tostring(index))
		if #cells == 0 then
			continue
		end
		local c0, c1, r0, r1 = math.huge, -math.huge, math.huge, -math.huge
		for _, cell in cells do
			c0, c1 = math.min(c0, cell.c), math.max(c1, cell.c)
			r0, r1 = math.min(r0, cell.r), math.max(r1, cell.r)
		end
		local minX, minZ = grid.originX + (c0 - 1) * size, grid.originZ + (r0 - 1) * size
		local maxX, maxZ = grid.originX + c1 * size, grid.originZ + r1 * size
		local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
		local w, h = maxX - minX, maxZ - minZ
		local padFolder = Instance.new("Folder")
		padFolder.Name = "Pad" .. index
		padFolder.Parent = folder
		local base = part(padFolder, Vector3.new(w - 1, 0.2, h - 1), CFrame.new(cx, 0.1, cz), Color3.fromRGB(60, 200, 90))
		base.Transparency = 0.35
		local border: { Part } = {
			part(padFolder, Vector3.new(w, 0.3, 0.5), CFrame.new(cx, 0.15, minZ + 0.25), Color3.fromRGB(60, 200, 90), Enum.Material.Neon),
			part(padFolder, Vector3.new(w, 0.3, 0.5), CFrame.new(cx, 0.15, maxZ - 0.25), Color3.fromRGB(60, 200, 90), Enum.Material.Neon),
			part(padFolder, Vector3.new(0.5, 0.3, h), CFrame.new(minX + 0.25, 0.15, cz), Color3.fromRGB(60, 200, 90), Enum.Material.Neon),
			part(padFolder, Vector3.new(0.5, 0.3, h), CFrame.new(maxX - 0.25, 0.15, cz), Color3.fromRGB(60, 200, 90), Enum.Material.Neon),
		}
		local gui = LobbyBuilder.sign(padFolder, Vector3.new(cx, 7, cz), 18, 6)
		local title = label(gui, "PARTY " .. index, 40, 0, 0.5)
		local detail = label(gui, "", 26, 0.5, 0.5)
		table.insert(pads, {
			index = index,
			minX = minX,
			maxX = maxX,
			minZ = minZ,
			maxZ = maxZ,
			base = base,
			border = border,
			title = title,
			detail = detail,
		})
	end

	local boards: { Vector3 } = {}
	for _, cell in grid:find("B") do
		local x, z = grid:cellCenter(cell.c, cell.r)
		part(folder, Vector3.new(10, 0.2, 5), CFrame.new(x, 0.1, z), Color3.fromRGB(46, 46, 56))
		table.insert(boards, Vector3.new(x, 9, z))
	end

	for _, cell in grid:find("T") do
		local x, z = grid:cellCenter(cell.c, cell.r)
		local gui = LobbyBuilder.sign(folder, Vector3.new(x, 6, z), 40, 10)
		local title = label(gui, string.upper(Config.GAME_NAME), 90, 0, 0.7)
		title.TextColor3 = Color3.fromRGB(240, 196, 60)
		label(gui, "Step on a pad to start a party", 30, 0.7, 0.3)
	end

	local spawns: { CFrame } = {}
	for _, cell in grid:find("P") do
		local x, z = grid:cellCenter(cell.c, cell.r)
		table.insert(spawns, CFrame.new(x, 3.5, z))
	end

	return { grid = grid, pads = pads, boards = boards, spawns = spawns }
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="31">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point. Every server builds the world and starts the game
-- systems. A normal server is a lobby (parties form there); a party's
-- private server just plays that party's run.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CharacterService = require(script.Parent.CharacterService)
local Explosions = require(script.Parent.Explosions)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local Loadout = require(script.Parent.Loadout)
local PartyServer = require(script.Parent.PartyServer)
local PartyService = require(script.Parent.PartyService)
local PauseService = require(script.Parent.PauseService)
local Projectiles = require(script.Parent.Projectiles)
local RunManager = require(script.Parent.RunManager)
local Scoreboards = require(script.Parent.Scoreboards)
local Teleporter = require(script.Parent.Teleporter)
local WeaponService = require(script.Parent.WeaponService)
local WorldSetup = require(script.Parent.WorldSetup)

ReplicatedStorage:SetAttribute("GameName", Config.GAME_NAME)
WorldSetup.start()
Loadout.start()
PauseService.start()
WeaponService.start()
Explosions.start()
Projectiles.start()
Teleporter.start()
RunManager.init()

if PartyServer.isPartyServer() then
	ReplicatedStorage:SetAttribute("ServerKind", "Party")
	PartyServer.start()
else
	ReplicatedStorage:SetAttribute("ServerKind", "Lobby")
	local lobby = LobbyBuilder.build()
	local function lobbySpawn(player: Player): CFrame?
		local spawns = lobby.spawns
		return spawns[(CharacterService.slotOf(player) - 1) % #spawns + 1]
	end
	CharacterService.homeSpawn = lobbySpawn
	Teleporter.homeSpawn = lobbySpawn
	PartyService.start(lobby.pads)
	Scoreboards.start(lobby.boards, workspace:WaitForChild("Lobby"))
end

CharacterService.start() -- last, because it spawns players
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PartyServer</string>
          <string name="Source"><![CDATA[--!strict
-- A party's private server (reserved by the lobby's teleport). Waits for the
-- party to arrive, plays one run with the room and difficulty they picked,
-- then teleports everyone back to a lobby server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local RunManager = require(script.Parent.RunManager)
local Teleporter = require(script.Parent.Teleporter)

local Announce = Net.event("Announce")

local PartyServer = {}

-- True when this server is a party's private game rather than a lobby.
function PartyServer.isPartyServer(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

function PartyServer.start()
	Players.PlayerAdded:Connect(function(player)
		Announce:FireClient(player, "WAITING FOR YOUR PARTY...", "info")
	end)
	task.spawn(function()
		local first = Players:GetPlayers()[1] or Players.PlayerAdded:Wait()
		local data: any = first:GetJoinData().TeleportData
		local roomId = Rooms.ORDER[1]
		local difficulty = "Intermediate"
		local expected: { number } = {}
		if typeof(data) == "table" then
			if typeof(data.room) == "string" and Rooms.ARENAS[data.room] then
				roomId = data.room
			end
			if typeof(data.difficulty) == "string" and Config.DIFFICULTIES[data.difficulty] then
				difficulty = data.difficulty
			end
			if typeof(data.party) == "table" then
				for _, userId in data.party do
					if typeof(userId) == "number" then
						table.insert(expected, userId)
					end
				end
			end
		end

		-- Wait until the whole party is here (or it's taking too long).
		local deadline = os.clock() + Config.ARRIVAL_WAIT
		while os.clock() < deadline do
			local missing = false
			for _, userId in expected do
				if not Players:GetPlayerByUserId(userId) then
					missing = true
				end
			end
			if not missing then
				break
			end
			task.wait(0.5)
		end
		task.wait(1)

		RunManager.begin(Players:GetPlayers(), roomId, difficulty, function(_finished: { Player })
			Teleporter.sendHome(Players:GetPlayers())
		end)
	end)
end

return PartyServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby parties. Step onto an empty pad to start a party and become its
-- leader; the leader picks the room, difficulty, party size and friends-only,
-- then presses START. Others join by stepping onto the pad (if there is room
-- and, for friends-only parties, they are the leader's friend). Stepping off
-- leaves the party. When the countdown ends the party goes into a game.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local RunState = require(script.Parent.RunState)
local Teleporter = require(script.Parent.Teleporter)

local PartyState = Net.event("PartyState")
local PartyAction = Net.event("PartyAction")
local Announce = Net.event("Announce")

type Party = {
	pad: LobbyBuilder.Pad,
	leader: Player?,
	members: { Player },
	room: string,
	difficulty: string,
	size: number,
	friendsOnly: boolean,
	countdownEnd: number?,
	shownSeconds: number?,
}

local PartyService = {}

local COLOR_OPEN = Color3.fromRGB(60, 200, 90)
local COLOR_FORMING = Color3.fromRGB(240, 200, 40)
local COLOR_STARTING = Color3.fromRGB(240, 120, 30)

local parties: { Party } = {}
local memberOf: { [Player]: Party } = {}
local standingOn: { [Player]: number } = {} -- pad index each player stands on
local waitForStepOff: { [Player]: boolean } = {} -- just launched or turned away: ignore until they leave the pad
local friendCache: { [string]: boolean } = {}
local friendPending: { [string]: boolean } = {}

local function resetParty(party: Party)
	party.leader = nil
	party.members = {}
	party.room = Rooms.ORDER[1]
	party.difficulty = "Intermediate"
	party.size = Config.PARTY_DEFAULT_SIZE
	party.friendsOnly = false
	party.countdownEnd = nil
	party.shownSeconds = nil
end

local function secondsLeft(party: Party): number?
	local finish = party.countdownEnd
	return if finish then math.max(0, math.ceil(finish - os.clock())) else nil
end

local function refresh(party: Party)
	local pad = party.pad
	local color = COLOR_OPEN
	local seconds = secondsLeft(party)
	if #party.members == 0 then
		pad.title.Text = "PARTY " .. pad.index
		pad.detail.Text = "STEP IN TO START A PARTY"
	elseif seconds then
		color = COLOR_STARTING
		pad.title.Text = "STARTING IN " .. seconds
		pad.detail.Text = Rooms.ARENAS[party.room].name .. "  -  " .. string.upper(party.difficulty)
	else
		color = COLOR_FORMING
		pad.title.Text = Rooms.ARENAS[party.room].name .. "  -  " .. string.upper(party.difficulty)
		pad.detail.Text = #party.members .. "/" .. party.size .. " PLAYERS" .. (if party.friendsOnly then "  -  FRIENDS ONLY" else "")
	end
	pad.base.Color = color
	for _, strip in pad.border do
		strip.Color = color
	end

	local names = {}
	for _, member in party.members do
		table.insert(names, member.DisplayName)
	end
	for _, member in party.members do
		PartyState:FireClient(member, {
			pad = pad.index,
			leader = if party.leader then party.leader.DisplayName else "",
			isLeader = party.leader == member,
			members = names,
			room = party.room,
			difficulty = party.difficulty,
			size = party.size,
			friendsOnly = party.friendsOnly,
			countdown = seconds,
		})
	end
end

local function leave(player: Player)
	local party = memberOf[player]
	if not party then
		return
	end
	memberOf[player] = nil
	local index = table.find(party.members, player)
	if index then
		table.remove(party.members, index)
	end
	if #party.members == 0 then
		resetParty(party)
	elseif party.leader == player then
		party.leader = party.members[1]
	end
	if party.size < #party.members then
		party.size = #party.members
	end
	PartyState:FireClient(player, nil)
	refresh(party)
end

-- Whether a player may join; nil while a friend check is still in progress.
local function mayJoin(party: Party, player: Player): (boolean?, string?)
	if #party.members >= party.size then
		return false, "THAT PARTY IS FULL"
	end
	local leader = party.leader
	if party.friendsOnly and leader and leader ~= player then
		local pair = leader.UserId .. ":" .. player.UserId
		local cached = friendCache[pair]
		if cached == nil then
			if not friendPending[pair] then
				friendPending[pair] = true
				task.spawn(function()
					local ok, friends = pcall(function()
						return player:IsFriendsWithAsync(leader.UserId)
					end)
					friendCache[pair] = ok and friends == true
					friendPending[pair] = nil
				end)
			end
			return nil, nil
		end
		if not cached then
			return false, "THAT PARTY IS FRIENDS ONLY"
		end
	end
	return true, nil
end

local function join(party: Party, player: Player)
	memberOf[player] = party
	table.insert(party.members, player)
	if not party.leader then
		party.leader = player
	end
	refresh(party)
end

local function launch(party: Party)
	local members = table.clone(party.members)
	local room, difficulty = party.room, party.difficulty
	for _, member in members do
		memberOf[member] = nil
		waitForStepOff[member] = true
		PartyState:FireClient(member, nil)
	end
	resetParty(party)
	refresh(party)
	if #members > 0 then
		Teleporter.launch(members, room, difficulty)
	end
end

local function padAt(pads: { LobbyBuilder.Pad }, position: Vector3): number?
	for _, pad in pads do
		if position.X >= pad.minX and position.X <= pad.maxX and position.Z >= pad.minZ and position.Z <= pad.maxZ then
			return pad.index
		end
	end
	return nil
end

local function onAction(player: Player, action: unknown, value: unknown)
	local party = memberOf[player]
	if not party or party.leader ~= player or typeof(action) ~= "string" then
		return
	end
	if action == "room" and typeof(value) == "string" and Rooms.ARENAS[value] then
		party.room = value
	elseif action == "difficulty" and typeof(value) == "string" and Config.DIFFICULTIES[value] then
		party.difficulty = value
	elseif action == "size" and typeof(value) == "number" and value == value then
		party.size = math.clamp(math.floor(value), math.max(1, #party.members), Config.PARTY_MAX_PLAYERS)
	elseif action == "friends" and typeof(value) == "boolean" then
		party.friendsOnly = value
	elseif action == "start" and not party.countdownEnd then
		party.countdownEnd = os.clock() + Config.PARTY_COUNTDOWN
	elseif action == "cancel" then
		party.countdownEnd = nil
		party.shownSeconds = nil
	end
	refresh(party)
end

local function tick(pads: { LobbyBuilder.Pad })
	for _, player in Players:GetPlayers() do
		if RunState.isParticipant(player) then
			if memberOf[player] then
				leave(player)
			end
			standingOn[player] = nil
			continue
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local index: number? = nil
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			index = padAt(pads, root.Position)
		end
		if waitForStepOff[player] then
			if index == nil then
				waitForStepOff[player] = nil
			end
			continue
		end
		if index ~= standingOn[player] then
			leave(player)
			if index then
				standingOn[player] = index
			else
				standingOn[player] = nil
			end
		end
		if index and not memberOf[player] then
			local party = parties[index]
			local allowed, reason = mayJoin(party, player)
			if allowed then
				join(party, player)
			elseif allowed == false then
				Announce:FireClient(player, reason or "CAN'T JOIN", "info")
				waitForStepOff[player] = true
			end
		end
	end

	for _, party in parties do
		local seconds = secondsLeft(party)
		if seconds and #party.members == 0 then
			party.countdownEnd = nil
		elseif seconds == 0 then
			launch(party)
		elseif seconds ~= party.shownSeconds then
			party.shownSeconds = seconds
			refresh(party)
		end
	end
end

function PartyService.start(pads: { LobbyBuilder.Pad })
	for _, pad in pads do
		local party: Party = {
			pad = pad,
			leader = nil,
			members = {},
			room = Rooms.ORDER[1],
			difficulty = "Intermediate",
			size = Config.PARTY_DEFAULT_SIZE,
			friendsOnly = false,
			countdownEnd = nil,
			shownSeconds = nil,
		}
		parties[pad.index] = party
		refresh(party)
	end
	PartyAction.OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(player)
		leave(player)
		standingOn[player] = nil
		waitForStepOff[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			tick(pads)
		end
	end)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">PauseService</string>
          <string name="Source"><![CDATA[--!strict
-- P pauses the run, but only when one player is on the server. The paused
-- state is a workspace attribute so the client can show the overlay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local RunState = require(script.Parent.RunState)

local PauseService = {}

local pausedAt = 0

function PauseService.set(paused: boolean)
	if paused == RunState.paused then
		return
	end
	RunState.paused = paused
	workspace:SetAttribute("Paused", paused)
	if paused then
		pausedAt = workspace:GetServerTimeNow()
		RunState.PausedChanged:Fire(true, 0)
	else
		RunState.PausedChanged:Fire(false, workspace:GetServerTimeNow() - pausedAt)
	end
end

function PauseService.start()
	workspace:SetAttribute("Paused", false)
	Net.event("PauseRequest").OnServerEvent:Connect(function(player: Player)
		local allowed = RunState.active
			and RunState.phase ~= "Over"
			and RunState.isParticipant(player)
			and #Players:GetPlayers() == 1
		if allowed or RunState.paused then
			PauseService.set(not RunState.paused)
		end
	end)
	-- Someone joining always unpauses.
	Players.PlayerAdded:Connect(function()
		PauseService.set(false)
	end)
end

return PauseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Placeables</string>
          <string name="Source"><![CDATA[--!strict
-- Things players drop on the cell in front of them: barrels (block enemies,
-- explode when shot or caught in a blast, chaining into other barrels), fake
-- walls (only block), mines (explode when an enemy steps on them) and
-- machine-gun turrets (shoot the nearest enemy until out of ammo).
-- Blocking placeables are obstacles for enemy pathing; enemies that can't get
-- around them attack them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Hitscan = require(ReplicatedStorage.Shared.Hitscan)
local Net = require(ReplicatedStorage.Shared.Net)
local PropModels = require(ReplicatedStorage.Shared.Models.PropModels)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local WeaponStats = require(ReplicatedStorage.Shared.WeaponStats)
local Arena = require(script.Parent.Arena)
local EnemyService = require(script.Parent.EnemyService)
local KillContext = require(script.Parent.KillContext)
local RunState = require(script.Parent.RunState)
local Scoring = require(script.Parent.Scoring)

local ShotFired = Net.event("ShotFired")
local ExplosionRemote = Net.event("Explosion")

export type Placeable = {
	id: number,
	kind: string, -- barrel, wall, mine, turret
	owner: Player?,
	c: number,
	r: number,
	x: number,
	z: number,
	health: number,
	alive: boolean,
	detonating: boolean,
	model: Model,
	head: Model?,
	blastRadius: number,
	blastDamage: number,
	ammo: number,
	fireInterval: number,
	fireReadyAt: number,
}

local Placeables = {}

-- Set by Explosions at startup: makes a barrel or mine go off.
Placeables.onExplode = function(_placeable: Placeable, _by: Player?) end

local BLOCKS_ENEMIES: { [string]: boolean } = { barrel = true, wall = true, turret = true }
local HEALTH: { [string]: number } = {
	barrel = Config.BARREL_HEALTH,
	wall = Config.WALL_HEALTH,
	mine = 1,
	turret = Config.TURRET_HEALTH,
}

local grid: RoomGrid.RoomGrid? = nil
local all: { Placeable } = {}
local byCell: { [number]: Placeable } = {}
local lastId = 0

local function key(c: number, r: number): number
	return r * 10000 + c
end

function Placeables.start(g: RoomGrid.RoomGrid)
	Placeables.clear()
	grid = g
	EnemyService.hooks.blockingPlaceableAt = function(c: number, r: number): any
		local placeable = byCell[key(c, r)]
		if placeable and BLOCKS_ENEMIES[placeable.kind] then
			return placeable
		end
		return nil
	end
	EnemyService.hooks.attackPlaceable = function(placeable: any, damage: number)
		Placeables.damage(placeable :: Placeable, damage, nil)
	end
end

function Placeables.clear()
	for _, placeable in all do
		placeable.alive = false
		placeable.model:Destroy()
	end
	table.clear(all)
	table.clear(byCell)
end

function Placeables.list(): { Placeable }
	return all
end

-- Living barrels, for bullets to hit.
function Placeables.barrels(): { Placeable }
	local list = {}
	for _, placeable in all do
		if placeable.kind == "barrel" and placeable.alive and not placeable.detonating then
			table.insert(list, placeable)
		end
	end
	return list
end

function Placeables.canPlace(c: number, r: number): boolean
	local g = grid
	if not g or not g:inBounds(c, r) then
		return false
	end
	local char = g:cell(c, r)
	if char == "#" or char == "S" or g:isBlocked(c, r) or byCell[key(c, r)] then
		return false
	end
	-- Not on top of a player.
	for _, participant in RunState.alive() do
		local character = participant.player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local pc, pr = g:worldToCell(root.Position.X, root.Position.Z)
			if pc == c and pr == r then
				return false
			end
		end
	end
	return true
end

function Placeables.place(owner: Player, kind: string, c: number, r: number, stats: WeaponStats.Stats): boolean
	local g = grid
	if not g or not Placeables.canPlace(c, r) then
		return false
	end
	local x, z = g:cellCenter(c, r)
	local at = CFrame.new(x, 0, z)
	local model: Model
	local head: Model? = nil
	if kind == "barrel" then
		model = PropModels.barrel(at)
	elseif kind == "wall" then
		model = PropModels.wall(at)
	elseif kind == "mine" then
		model = PropModels.mine(at)
	elseif kind == "turret" then
		model, head = PropModels.turret(at)
	else
		return false
	end
	lastId += 1
	model:SetAttribute("Kind", kind)
	model:SetAttribute("CellC", c)
	model:SetAttribute("CellR", r)
	model.Parent = Arena.props()

	local placeable: Placeable = {
		id = lastId,
		kind = kind,
		owner = owner,
		c = c,
		r = r,
		x = x,
		z = z,
		health = HEALTH[kind] or 50,
		alive = true,
		detonating = false,
		model = model,
		head = head,
		blastRadius = stats.blastRadius,
		blastDamage = stats.damage,
		ammo = Config.TURRET_AMMO,
		fireInterval = stats.turretFireInterval,
		fireReadyAt = 0,
	}
	table.insert(all, placeable)
	byCell[key(c, r)] = placeable
	if kind == "wall" then
		g:setBlocked(c, r, true) -- fake walls stop bullets too
	end
	EnemyService.markDirty()
	return true
end

function Placeables.remove(placeable: Placeable)
	if not placeable.alive then
		return
	end
	placeable.alive = false
	local index = table.find(all, placeable)
	if index then
		table.remove(all, index)
	end
	if byCell[key(placeable.c, placeable.r)] == placeable then
		byCell[key(placeable.c, placeable.r)] = nil
	end
	local g = grid
	if placeable.kind == "wall" and g then
		g:setBlocked(placeable.c, placeable.r, false)
	end
	placeable.model:Destroy()
	EnemyService.markDirty()
end

-- Barrels and mines go off after `delay` seconds; `by` gets the credit
-- (defaults to whoever placed it).
function Placeables.detonate(placeable: Placeable, delay: number, by: Player?)
	if placeable.detonating or not placeable.alive then
		return
	end
	placeable.detonating = true
	task.delay(delay, function()
		if not placeable.alive then
			return
		end
		Placeables.remove(placeable)
		Placeables.onExplode(placeable, by)
	end)
end

function Placeables.damage(placeable: Placeable, amount: number, by: Player?)
	if not placeable.alive or placeable.detonating then
		return
	end
	placeable.health -= amount
	if placeable.health > 0 then
		return
	end
	if placeable.kind == "barrel" or placeable.kind == "mine" then
		Placeables.detonate(placeable, 0, by)
	else
		Placeables.remove(placeable)
		ExplosionRemote:FireAllClients(placeable.x, placeable.z, 0, "break")
	end
end

local function enemyCircle(enemy: EnemyService.Enemy): (number, number, number)
	return enemy.x, enemy.z, enemy.radius
end

local function updateTurret(g: RoomGrid.RoomGrid, turret: Placeable, clock: number)
	if clock < turret.fireReadyAt then
		return
	end
	-- Nearest enemy in range with a clear line of fire.
	local target: EnemyService.Enemy? = nil
	local bestSq = Config.TURRET_RANGE * Config.TURRET_RANGE
	for _, enemy in EnemyService.list() do
		local dx, dz = enemy.x - turret.x, enemy.z - turret.z
		local distSq = dx * dx + dz * dz
		if distSq < bestSq and not enemy.entering then
			local dist = math.sqrt(distSq)
			if dist < 0.5 or g:raycast(turret.x, turret.z, dx / dist, dz / dist, dist) >= dist - 0.5 then
				target, bestSq = enemy, distSq
			end
		end
	end
	if not target then
		return
	end
	local dist = math.sqrt(bestSq)
	local dx, dz = (target.x - turret.x) / math.max(dist, 1e-3), (target.z - turret.z) / math.max(dist, 1e-3)

	local context = KillContext.new(turret.owner)
	local wall = g:raycast(turret.x, turret.z, dx, dz, Config.TURRET_RANGE)
	local hits, travel = Hitscan.cast(turret.x, turret.z, dx, dz, wall, EnemyService.list(), enemyCircle, 1)
	for _, enemy in hits do
		EnemyService.damage(enemy, Config.TURRET_DAMAGE, context)
	end
	Scoring.flush(context)

	local facing = math.atan2(-dx, -dz)
	local head = turret.head
	if head then
		head:PivotTo(CFrame.new(turret.x, 3, turret.z) * CFrame.Angles(0, facing, 0))
	end
	local muzzle = Vector3.new(turret.x + dx * 2.4, 3.05, turret.z + dz * 2.4)
	local finish = Vector3.new(turret.x + dx * math.max(travel, 2.5), 3.05, turret.z + dz * math.max(travel, 2.5))
	ShotFired:FireAllClients(nil, "turret", muzzle, { finish }, 0)

	turret.fireReadyAt = clock + turret.fireInterval
	turret.ammo -= 1
	if turret.ammo <= 0 then
		Placeables.remove(turret)
		ExplosionRemote:FireAllClients(turret.x, turret.z, 0, "break")
	end
end

local function updateMine(mine: Placeable)
	local reach = Config.MINE_TRIGGER_RADIUS
	for _, enemy in EnemyService.list() do
		if not enemy.entering then
			local dx, dz = enemy.x - mine.x, enemy.z - mine.z
			local r = reach + enemy.radius
			if dx * dx + dz * dz <= r * r then
				Placeables.detonate(mine, 0, nil)
				return
			end
		end
	end
end

function Placeables.update(clock: number)
	local g = grid
	if not g then
		return
	end
	for _, placeable in table.clone(all) do
		if not placeable.alive or placeable.detonating then
			continue
		end
		if placeable.kind == "turret" then
			updateTurret(g, placeable, clock)
		elseif placeable.kind == "mine" then
			updateMine(placeable)
		end
	end
end

return Placeables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">PlayerHealth</string>
          <string name="Source"><![CDATA[--!strict
-- Damage to run players and their health regeneration
-- (HEALTH_REGEN_PER_SEC after HEALTH_REGEN_DELAY seconds without damage).
-- Roblox's own slow regen is switched off by the empty Health script in
-- StarterCharacterScripts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local RunState = require(script.Parent.RunState)

local PlayerHurt = Net.event("PlayerHurt")

local PlayerHealth = {}

local lastHurt: { [Player]: number } = {}

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

function PlayerHealth.damage(player: Player, amount: number)
	local participant = RunState.participants[player]
	local humanoid = humanoidOf(player)
	if not participant or not participant.alive or not humanoid or humanoid.Health <= 0 or amount <= 0 then
		return
	end
	humanoid:TakeDamage(amount)
	lastHurt[player] = RunState.clock
	PlayerHurt:FireClient(player, amount)
end

function PlayerHealth.heal(player: Player)
	local humanoid = humanoidOf(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = humanoid.MaxHealth
	end
	lastHurt[player] = nil
end

function PlayerHealth.update(dt: number)
	for _, participant in RunState.alive() do
		local humanoid = humanoidOf(participant.player)
		if humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
			local since = RunState.clock - (lastHurt[participant.player] or -math.huge)
			if since >= Config.HEALTH_REGEN_DELAY then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.HEALTH_REGEN_PER_SEC * dt)
			end
		end
	end
end

function PlayerHealth.forget(player: Player)
	lastHurt[player] = nil
end

return PlayerHealth
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[--!strict
-- Things that fly: thrown grenades (land, then go off after their fuse),
-- rockets (explode on the first enemy, barrel or wall they touch) and devil
-- fireballs (hurt players, burn through zombies, set off barrels).
-- The server moves them; clients draw them from the spawn message.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Hitscan = require(ReplicatedStorage.Shared.Hitscan)
local Net = require(ReplicatedStorage.Shared.Net)
local WeaponStats = require(ReplicatedStorage.Shared.WeaponStats)
local Arena = require(script.Parent.Arena)
local EnemyService = require(script.Parent.EnemyService)
local Explosions = require(script.Parent.Explosions)
local Placeables = require(script.Parent.Placeables)
local PlayerHealth = require(script.Parent.PlayerHealth)
local RunState = require(script.Parent.RunState)

local ProjectileRemote = Net.event("Projectile")

type Projectile = {
	id: number,
	kind: string, -- grenade, rocket, fireball
	owner: Player?,
	x: number,
	z: number,
	dx: number,
	dz: number,
	speed: number,
	traveled: number,
	maxRange: number,
	damage: number,
	blastRadius: number,
	explodeAt: number,
	burned: { [number]: boolean }, -- enemies a fireball already hurt
}

local Projectiles = {}

local GRENADE_FLIGHT = 0.55 -- seconds in the air (for the client's arc)

local active: { Projectile } = {}
local lastId = 0

local function add(projectile: Projectile)
	table.insert(active, projectile)
end

local function newProjectile(kind: string, owner: Player?, x: number, z: number, dx: number, dz: number): Projectile
	lastId += 1
	return {
		id = lastId,
		kind = kind,
		owner = owner,
		x = x,
		z = z,
		dx = dx,
		dz = dz,
		speed = 0,
		traveled = 0,
		maxRange = 0,
		damage = 0,
		blastRadius = 0,
		explodeAt = math.huge,
		burned = {},
	}
end

function Projectiles.throwGrenade(owner: Player, x: number, z: number, dx: number, dz: number, distance: number, stats: WeaponStats.Stats)
	local grid = Arena.grid()
	local wall = grid:raycast(x, z, dx, dz, distance)
	local land = math.max(0, math.min(distance, wall - 1.2))
	local grenade = newProjectile("grenade", owner, x + dx * land, z + dz * land, dx, dz)
	grenade.explodeAt = RunState.clock + stats.fuse
	grenade.damage = stats.damage
	grenade.blastRadius = stats.blastRadius
	add(grenade)
	ProjectileRemote:FireAllClients("spawn", grenade.id, "grenade", x, z, grenade.x, grenade.z, GRENADE_FLIGHT, stats.fuse)
end

function Projectiles.fireRocket(owner: Player, x: number, z: number, dx: number, dz: number, stats: WeaponStats.Stats)
	local rocket = newProjectile("rocket", owner, x, z, dx, dz)
	rocket.speed = stats.speed
	rocket.maxRange = stats.range
	rocket.damage = stats.damage
	rocket.blastRadius = stats.blastRadius
	add(rocket)
	ProjectileRemote:FireAllClients("spawn", rocket.id, "rocket", x, z, dx, dz, rocket.speed)
end

function Projectiles.fireball(enemy: EnemyService.Enemy, targetX: number, targetZ: number)
	local dx, dz = targetX - enemy.x, targetZ - enemy.z
	local dist = math.sqrt(dx * dx + dz * dz)
	if dist < 1e-3 then
		return
	end
	dx, dz = dx / dist, dz / dist
	local ball = newProjectile("fireball", nil, enemy.x + dx * (enemy.radius + 0.5), enemy.z + dz * (enemy.radius + 0.5), dx, dz)
	ball.speed = Config.FIREBALL_SPEED
	ball.maxRange = (enemy.def.fireballRange or 45) + 15
	ball.burned[enemy.id] = true
	add(ball)
	ProjectileRemote:FireAllClients("spawn", ball.id, "fireball", ball.x, ball.z, dx, dz, ball.speed)
end

local function finish(index: number, x: number, z: number)
	local projectile = active[index]
	table.remove(active, index)
	ProjectileRemote:FireAllClients("end", projectile.id, x, z)
end

local function enemyCircle(enemy: EnemyService.Enemy): (number, number, number)
	return enemy.x, enemy.z, enemy.radius + 0.3
end

local function barrelCircle(barrel: Placeables.Placeable): (number, number, number)
	return barrel.x, barrel.z, Config.BARREL_RADIUS
end

-- Moves a rocket; returns where it blew up, if it did.
local function stepRocket(rocket: Projectile, dt: number): (number?, number?)
	local grid = Arena.grid()
	local stride = rocket.speed * dt
	local wall = grid:raycast(rocket.x, rocket.z, rocket.dx, rocket.dz, stride)
	local reach = math.min(stride, wall)
	local _, enemyAt = Hitscan.cast(rocket.x, rocket.z, rocket.dx, rocket.dz, reach, EnemyService.list(), enemyCircle, 1)
	local _, barrelAt = Hitscan.cast(rocket.x, rocket.z, rocket.dx, rocket.dz, reach, Placeables.barrels(), barrelCircle, 1)
	local stop = math.min(enemyAt, barrelAt)
	if stop < reach or wall < stride then
		local at = math.max(0, stop - 0.4)
		return rocket.x + rocket.dx * at, rocket.z + rocket.dz * at
	end
	rocket.x += rocket.dx * stride
	rocket.z += rocket.dz * stride
	rocket.traveled += stride
	if rocket.traveled >= rocket.maxRange then
		return rocket.x, rocket.z
	end
	return nil, nil
end

-- Moves a fireball; returns true when it is used up.
local function stepFireball(ball: Projectile, dt: number): boolean
	local grid = Arena.grid()
	local stride = ball.speed * dt
	if grid:raycast(ball.x, ball.z, ball.dx, ball.dz, stride) < stride then
		return true
	end
	ball.x += ball.dx * stride
	ball.z += ball.dz * stride
	ball.traveled += stride

	for _, participant in RunState.alive() do
		local character = participant.player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local dx, dz = root.Position.X - ball.x, root.Position.Z - ball.z
			local reach = Config.FIREBALL_RADIUS + Config.PLAYER_RADIUS
			if dx * dx + dz * dz <= reach * reach then
				PlayerHealth.damage(participant.player, Config.FIREBALL_DAMAGE * (Config.DIFFICULTIES[RunState.difficulty] or Config.DIFFICULTIES.Intermediate).damage)
				return true
			end
		end
	end

	for _, barrel in Placeables.barrels() do
		local dx, dz = barrel.x - ball.x, barrel.z - ball.z
		local reach = Config.FIREBALL_RADIUS + Config.BARREL_RADIUS
		if dx * dx + dz * dz <= reach * reach then
			Placeables.detonate(barrel, 0, nil)
			return true
		end
	end

	-- Burns through zombies (but not other devils).
	for _, enemy in table.clone(EnemyService.list()) do
		if enemy.kind ~= "Devil" and not ball.burned[enemy.id] and not enemy.entering then
			local dx, dz = enemy.x - ball.x, enemy.z - ball.z
			local reach = Config.FIREBALL_RADIUS + enemy.radius
			if dx * dx + dz * dz <= reach * reach then
				ball.burned[enemy.id] = true
				EnemyService.damage(enemy, Config.FIREBALL_ENEMY_DAMAGE, nil)
			end
		end
	end
	return ball.traveled >= ball.maxRange
end

function Projectiles.update(dt: number, clock: number)
	for i = #active, 1, -1 do
		local projectile = active[i]
		if projectile.kind == "grenade" then
			if clock >= projectile.explodeAt then
				finish(i, projectile.x, projectile.z)
				Explosions.explode(projectile.x, projectile.z, projectile.blastRadius, projectile.damage, projectile.owner, "grenade")
			end
		elseif projectile.kind == "rocket" then
			local bx, bz = stepRocket(projectile, dt)
			if bx and bz then
				finish(i, bx, bz)
				Explosions.explode(bx, bz, projectile.blastRadius, projectile.damage, projectile.owner, "rocket")
			end
		elseif stepFireball(projectile, dt) then
			finish(i, projectile.x, projectile.z)
		end
	end
end

function Projectiles.clear()
	for i = #active, 1, -1 do
		finish(i, active[i].x, active[i].z)
	end
end

function Projectiles.start()
	EnemyService.hooks.shootFireball = Projectiles.fireball
end

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">RoomBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a RoomGrid into parts: a checkered tile floor and block walls.
-- Neighbouring wall cells are merged into large rectangles to keep part count
-- low. Entry gaps get a short dark tunnel outside them for enemies to walk in
-- from, and an invisible barrier so players can't walk out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)

local RoomBuilder = {}

local FLOOR_THICKNESS = 1
local TILE_RAISE = 0.04 -- the darker tiles sit a hair above the base floor to avoid flicker
local WALL_CAP = 0.4 -- thickness of the darker top of each wall
local TUNNEL_COLOR = Color3.fromRGB(58, 56, 54)

local function block(name: string, size: Vector3, cframe: CFrame, color: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildFloor(grid: RoomGrid.RoomGrid, folder: Instance)
	local size = grid.cellSize
	local w, h = grid.width * size, grid.height * size
	local base = block(
		"Floor",
		Vector3.new(w, FLOOR_THICKNESS, h),
		CFrame.new(grid.originX + w / 2, -FLOOR_THICKNESS / 2, grid.originZ + h / 2),
		Config.FLOOR_COLOR_A,
		folder
	)
	base.CastShadow = false

	for r = 1, grid.height do
		for c = 1, grid.width do
			if (c + r) % 2 == 0 and grid:cell(c, r) ~= "#" then
				local x, z = grid:cellCenter(c, r)
				local tile = block("Tile", Vector3.new(size, 0.2, size), CFrame.new(x, TILE_RAISE - 0.1, z), Config.FLOOR_COLOR_B, folder)
				tile.CanCollide = false
				tile.CanQuery = false
				tile.CanTouch = false
				tile.CastShadow = false
			end
		end
	end
end

local function buildWalls(grid: RoomGrid.RoomGrid, folder: Instance)
	local size = grid.cellSize
	local used: { [number]: boolean } = {}
	local function key(c: number, r: number): number
		return r * 10000 + c
	end
	local function free(c: number, r: number): boolean
		return grid:inBounds(c, r) and grid:cell(c, r) == "#" and not used[key(c, r)]
	end

	for r = 1, grid.height do
		for c = 1, grid.width do
			if free(c, r) then
				-- Grow the widest run on this row, then extend it down while every cell matches.
				local runW = 1
				while free(c + runW, r) do
					runW += 1
				end
				local runH = 1
				while true do
					local rowOk = true
					for cc = c, c + runW - 1 do
						if not free(cc, r + runH) then
							rowOk = false
							break
						end
					end
					if not rowOk then
						break
					end
					runH += 1
				end
				for rr = r, r + runH - 1 do
					for cc = c, c + runW - 1 do
						used[key(cc, rr)] = true
					end
				end

				local x0, z0 = grid:cellCenter(c, r)
				local cx = x0 + (runW - 1) * size / 2
				local cz = z0 + (runH - 1) * size / 2
				local footW, footH = runW * size, runH * size
				local bodyHeight = Config.WALL_HEIGHT - WALL_CAP
				block("Wall", Vector3.new(footW, bodyHeight, footH), CFrame.new(cx, bodyHeight / 2, cz), Config.WALL_COLOR, folder)
				local cap = block("WallTop", Vector3.new(footW, WALL_CAP, footH), CFrame.new(cx, bodyHeight + WALL_CAP / 2, cz), Config.WALL_TOP_COLOR, folder)
				cap.CastShadow = false
			end
		end
	end
end

-- Direction pointing out of the room from an edge cell, or (0, 0) for inner cells.
function RoomBuilder.outward(grid: RoomGrid.RoomGrid, c: number, r: number): (number, number)
	if r == 1 then
		return 0, -1
	elseif r == grid.height then
		return 0, 1
	elseif c == 1 then
		return -1, 0
	elseif c == grid.width then
		return 1, 0
	end
	return 0, 0
end

local function buildEntries(grid: RoomGrid.RoomGrid, folder: Instance)
	local size = grid.cellSize
	for _, cell in grid:find("S") do
		local x, z = grid:cellCenter(cell.c, cell.r)
		local ox, oz = RoomBuilder.outward(grid, cell.c, cell.r)
		-- Dark tunnel floor outside the gap.
		local length = Config.ENEMY_ENTER_DISTANCE + size
		local tunnel = block(
			"Tunnel",
			Vector3.new(if ox ~= 0 then length else size, 0.4, if oz ~= 0 then length else size),
			CFrame.new(x + ox * (size / 2 + length / 2), -0.2, z + oz * (size / 2 + length / 2)),
			TUNNEL_COLOR,
			folder
		)
		tunnel.CastShadow = false
		-- Invisible barrier across the outer edge of the gap.
		local barrier = block(
			"Barrier",
			Vector3.new(if ox ~= 0 then 1 else size, 12, if oz ~= 0 then 1 else size),
			CFrame.new(x + ox * (size / 2 + 0.5), 6, z + oz * (size / 2 + 0.5)),
			Color3.new(0, 0, 0),
			folder
		)
		barrier.Transparency = 1
		barrier.CanQuery = false
	end
end

-- Builds the room into workspace[folderName], replacing whatever was there.
function RoomBuilder.build(grid: RoomGrid.RoomGrid, folderName: string): Folder
	local old = workspace:FindFirstChild(folderName)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = folderName
	buildFloor(grid, folder)
	buildWalls(grid, folder)
	buildEntries(grid, folder)
	folder.Parent = workspace
	return folder
end

return RoomBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">RunManager</string>
          <string name="Source"><![CDATA[--!strict
-- Runs one game at a time: GET READY, then waves that grow bigger and faster
-- forever, with a short break and "WAVE N" between them. When every player
-- is down it shows the results, saves high scores and hands the players back
-- (to the lobby, or teleports them home from a party server).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local WaveMath = require(ReplicatedStorage.Shared.WaveMath)
local AmmoBoxes = require(script.Parent.AmmoBoxes)
local Arena = require(script.Parent.Arena)
local CharacterService = require(script.Parent.CharacterService)
local EnemyService = require(script.Parent.EnemyService)
local HighScores = require(script.Parent.HighScores)
local Loadout = require(script.Parent.Loadout)
local PauseService = require(script.Parent.PauseService)
local Placeables = require(script.Parent.Placeables)
local PlayerHealth = require(script.Parent.PlayerHealth)
local Projectiles = require(script.Parent.Projectiles)
local RunState = require(script.Parent.RunState)
local Scoring = require(script.Parent.Scoring)

local Announce = Net.event("Announce")
local RunResults = Net.event("RunResults")
local ExplosionRemote = Net.event("Explosion")

export type FinishHandler = (players: { Player }) -> ()

local RunManager = {}

local entries: { RoomGrid.Cell } = {}
local onFinished: FinishHandler? = nil
local toSpawn = 0
local spawnInterval = 1
local nextSpawnAt = 0
local phaseEndsAt = 0
local speedMultiplier = 1
local damageMultiplier = 1
local runToken = 0 -- changes whenever a run starts or is cleaned up
local rng = Random.new()

local function announce(text: string, style: string)
	for player in RunState.participants do
		Announce:FireClient(player, text, style)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function targets(): { EnemyService.Target }
	local list: { EnemyService.Target } = {}
	for _, participant in RunState.alive() do
		local root = rootOf(participant.player)
		if root then
			table.insert(list, { player = participant.player, x = root.Position.X, z = root.Position.Z })
		end
	end
	return list
end

local function beginWave(wave: number)
	local difficulty = Config.DIFFICULTIES[RunState.difficulty]
	RunState.wave = wave
	RunState.phase = "Wave"
	toSpawn = WaveMath.count(wave, RunState.count(), difficulty)
	spawnInterval = Config.WAVE_SPAWN_TIME / toSpawn
	nextSpawnAt = RunState.clock
	speedMultiplier = WaveMath.speedMultiplier(wave, difficulty)
	RunState.publish()
	if wave == 1 then
		announce("WAVE 1", "wave")
	end
end

local function spawnOne()
	if #entries == 0 then
		toSpawn = 0
		return
	end
	local cell = entries[rng:NextInteger(1, #entries)]
	EnemyService.spawn(WaveMath.pickKind(RunState.wave, rng:NextNumber()), cell, speedMultiplier, damageMultiplier)
end

local function reviveFallen()
	for player, participant in RunState.participants do
		if not participant.alive and player.Parent then
			participant.alive = true
			task.spawn(CharacterService.spawnAt, player, Arena.spawnFor(participant.slot))
			Announce:FireClient(player, "BACK IN THE FIGHT", "info")
		end
	end
end

local function cleanup()
	runToken += 1
	local players: { Player } = {}
	for player in RunState.participants do
		table.insert(players, player)
		player:SetAttribute("InRun", nil)
		Loadout.clear(player)
		PlayerHealth.forget(player)
	end
	EnemyService.clear()
	Projectiles.clear()
	Placeables.clear()
	AmmoBoxes.clear()
	Scoring.clear()
	table.clear(RunState.participants)
	RunState.active = false
	RunState.phase = "Idle"
	RunState.wave = 0
	RunState.publish()
	local finished = onFinished
	onFinished = nil
	if finished then
		finished(players)
	end
end

local function finishRun()
	if not RunState.active or RunState.phase == "Over" then
		return
	end
	RunState.phase = "Over"
	RunState.publish()
	PauseService.set(false)
	local results = Scoring.results()
	local summary = {
		wave = RunState.wave,
		room = RunState.roomId,
		difficulty = RunState.difficulty,
		players = results,
		returnIn = Config.RESULTS_TIME,
	}
	for player in RunState.participants do
		RunResults:FireClient(player, summary)
	end
	local roomId, difficulty = RunState.roomId, RunState.difficulty
	task.spawn(function()
		for _, result in results do
			HighScores.submit(roomId, difficulty, result.userId, result.score)
		end
	end)
	local token = runToken
	task.delay(Config.RESULTS_TIME, function()
		if token == runToken then
			cleanup()
		end
	end)
end

local function checkAllDown()
	if RunState.active and RunState.phase ~= "Over" and #RunState.alive() == 0 then
		finishRun()
	end
end

local function onDied(player: Player)
	local participant = RunState.participants[player]
	if not participant or not participant.alive then
		return
	end
	participant.alive = false
	local root = rootOf(player)
	if root then
		ExplosionRemote:FireAllClients(root.Position.X, root.Position.Z, 0, "death")
	end
	Announce:FireClient(player, "YOU DIED", "big")
	checkAllDown()
end

local function onLeave(player: Player)
	if not RunState.participants[player] then
		return
	end
	RunState.participants[player] = nil
	Scoring.remove(player)
	if RunState.count() == 0 then
		cleanup()
	else
		checkAllDown()
	end
end

local function step(dt: number)
	if not RunState.active or RunState.paused then
		return
	end
	if RunState.phase == "Over" then
		EnemyService.flush()
		return
	end
	RunState.clock += dt
	local clock = RunState.clock
	EnemyService.update(dt, clock, targets())
	Projectiles.update(dt, clock)
	Placeables.update(clock)
	AmmoBoxes.update(dt)
	PlayerHealth.update(dt)

	if RunState.phase == "Starting" then
		if clock >= phaseEndsAt then
			beginWave(1)
		end
	elseif RunState.phase == "Wave" then
		while toSpawn > 0 and clock >= nextSpawnAt and EnemyService.count() < Config.MAX_ALIVE_ENEMIES do
			spawnOne()
			toSpawn -= 1
			nextSpawnAt += spawnInterval
		end
		if toSpawn > 0 and EnemyService.count() >= Config.MAX_ALIVE_ENEMIES then
			nextSpawnAt = math.max(nextSpawnAt, clock) -- don't save up a burst while full
		end
		if toSpawn == 0 and EnemyService.count() == 0 then
			RunState.phase = "Break"
			phaseEndsAt = clock + Config.WAVE_BREAK
			RunState.publish()
			if Config.REVIVE_AT_WAVE_END then
				reviveFallen()
			end
			announce("WAVE " .. (RunState.wave + 1), "wave")
		end
	elseif RunState.phase == "Break" then
		if clock >= phaseEndsAt then
			beginWave(RunState.wave + 1)
		end
	end
end

-- Starts a run in this server's arena. Returns false if one is already going.
function RunManager.begin(players: { Player }, roomId: string, difficulty: string, finished: FinishHandler): boolean
	if RunState.active or #players == 0 then
		return false
	end
	if not Rooms.ARENAS[roomId] then
		roomId = Rooms.ORDER[1]
	end
	if not Config.DIFFICULTIES[difficulty] then
		difficulty = "Intermediate"
	end
	local grid = Arena.load(roomId)
	entries = grid:find("S")

	runToken += 1
	RunState.active = true
	RunState.phase = "Starting"
	RunState.clock = 0
	RunState.roomId = roomId
	RunState.difficulty = difficulty
	RunState.wave = 0
	table.clear(RunState.participants)
	for slot, player in players do
		RunState.participants[player] = { player = player, slot = slot, alive = true }
		CharacterService.setSlot(player, slot)
		player:SetAttribute("InRun", true)
		Loadout.reset(player)
		PlayerHealth.forget(player)
	end
	Scoring.reset(players)
	EnemyService.start(grid)
	Placeables.start(grid)
	AmmoBoxes.start(grid)
	onFinished = finished
	damageMultiplier = Config.DIFFICULTIES[difficulty].damage
	phaseEndsAt = Config.RUN_START_DELAY
	PauseService.set(false)
	RunState.publish()

	for player, participant in RunState.participants do
		task.spawn(CharacterService.spawnAt, player, Arena.spawnFor(participant.slot))
	end
	announce("GET READY", "wave")
	return true
end

function RunManager.init()
	EnemyService.hooks.attackPlayer = PlayerHealth.damage
	CharacterService.Died:Connect(onDied)
	Players.PlayerRemoving:Connect(onLeave)
	RunState.PausedChanged:Connect(function(paused: boolean, seconds: number)
		if not paused and seconds > 0 then
			Scoring.shiftAll(seconds)
		end
	end)
	RunState.publish()
	RunService.Heartbeat:Connect(step)
end

return RunManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">RunState</string>
          <string name="Source"><![CDATA[--!strict
-- Shared state of the current run (one at a time per server), read by every
-- server system. RunManager is the only module that changes it, apart from
-- PauseService toggling `paused`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)

export type Participant = {
	player: Player,
	slot: number, -- 1-6: spawn cell and shirt order
	alive: boolean,
}

local RunState = {}

RunState.active = false
RunState.phase = "Idle" -- Idle, Starting, Wave, Break, Over
RunState.paused = false
RunState.clock = 0 -- seconds of unpaused run time; cooldowns use this
RunState.roomId = ""
RunState.difficulty = "Intermediate"
RunState.wave = 0
RunState.participants = {} :: { [Player]: Participant }
RunState.PausedChanged = Signal.new() -- (paused: boolean, pausedForSeconds: number)

function RunState.isParticipant(player: Player): boolean
	return RunState.participants[player] ~= nil
end

-- True while this player may shoot, place and pick things up.
function RunState.canAct(player: Player): boolean
	local participant = RunState.participants[player]
	return RunState.active
		and not RunState.paused
		and participant ~= nil
		and participant.alive
		and RunState.phase ~= "Over"
		and RunState.phase ~= "Idle"
end

function RunState.alive(): { Participant }
	local list = {}
	for _, participant in RunState.participants do
		if participant.alive then
			table.insert(list, participant)
		end
	end
	return list
end

function RunState.count(): number
	local n = 0
	for _ in RunState.participants do
		n += 1
	end
	return n
end

-- Mirrors the run's state onto ReplicatedStorage so clients can show it.
function RunState.publish()
	ReplicatedStorage:SetAttribute("RunActive", RunState.active)
	ReplicatedStorage:SetAttribute("RunPhase", RunState.phase)
	ReplicatedStorage:SetAttribute("Wave", RunState.wave)
	ReplicatedStorage:SetAttribute("RoomId", RunState.roomId)
	ReplicatedStorage:SetAttribute("Difficulty", RunState.difficulty)
end

return RunState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Scoreboards</string>
          <string name="Source"><![CDATA[--!strict
-- Floating high score boards in the lobby, one per difficulty, each cycling
-- through the rooms. Data is fetched slowly in the background to stay inside
-- Roblox's DataStore request budget.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local HighScores = require(script.Parent.HighScores)
local LobbyBuilder = require(script.Parent.LobbyBuilder)

type Board = { difficulty: string, title: TextLabel, rows: { TextLabel }, roomIndex: number }
type Cached = { rows: { HighScores.Row }?, fetchedAt: number }

local Scoreboards = {}

local FETCH_GAP = 7 -- seconds between DataStore reads
local STALE_AFTER = 120

local boards: { Board } = {}
local cache: { [string]: Cached } = {}
local wanted: { string } = {}

local function key(roomId: string, difficulty: string): string
	return roomId .. "|" .. difficulty
end

local function render(board: Board)
	local roomId = Rooms.ORDER[board.roomIndex]
	board.title.Text = Rooms.ARENAS[roomId].name .. "  -  " .. string.upper(board.difficulty)
	local entry = cache[key(roomId, board.difficulty)]
	for i, row in board.rows do
		local data = entry and entry.rows and entry.rows[i]
		if data then
			row.Text = string.format("%d. %s   %d", i, data.name, data.score)
		elseif i == 1 then
			row.Text = if entry == nil then "loading..." elseif entry.rows == nil then "scores need a published game" else "no scores yet"
		else
			row.Text = ""
		end
	end
	local entryKey = key(roomId, board.difficulty)
	if (entry == nil or os.clock() - entry.fetchedAt > STALE_AFTER) and not table.find(wanted, entryKey) then
		table.insert(wanted, entryKey)
	end
end

function Scoreboards.start(anchors: { Vector3 }, parent: Instance)
	for i, at in anchors do
		local difficulty = Config.DIFFICULTY_ORDER[i]
		if not difficulty then
			break
		end
		local gui = LobbyBuilder.sign(parent, at, 20, 12)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
		frame.BackgroundTransparency = 0.25
		frame.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.06, 0)
		corner.Parent = frame
		local function line(y: number, h: number, color: Color3): TextLabel
			local text = Instance.new("TextLabel")
			text.BackgroundTransparency = 1
			text.Position = UDim2.fromScale(0.05, y)
			text.Size = UDim2.fromScale(0.9, h)
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.TextColor3 = color
			text.TextXAlignment = Enum.TextXAlignment.Left
			text.Text = ""
			text.Parent = frame
			return text
		end
		local title = line(0.03, 0.14, Color3.fromRGB(240, 196, 60))
		local rows = {}
		for r = 1, Config.SCOREBOARD_SIZE do
			table.insert(rows, line(0.2 + (r - 1) * 0.095, 0.085, Color3.new(1, 1, 1)))
		end
		local board = { difficulty = difficulty, title = title, rows = rows, roomIndex = 1 }
		table.insert(boards, board)
		render(board)
	end

	-- Cycle rooms on every board.
	task.spawn(function()
		while true do
			task.wait(Config.SCOREBOARD_CYCLE)
			for _, board in boards do
				board.roomIndex = board.roomIndex % #Rooms.ORDER + 1
				render(board)
			end
		end
	end)

	-- Fetch one board's data at a time.
	task.spawn(function()
		while true do
			local nextKey = table.remove(wanted, 1)
			if nextKey then
				local roomId, difficulty = string.match(nextKey, "^(.-)|(.*)$")
				if roomId and difficulty then
					cache[nextKey] = { rows = HighScores.top(roomId, difficulty, Config.SCOREBOARD_SIZE), fetchedAt = os.clock() }
					for _, board in boards do
						render(board)
					end
				end
			end
			task.wait(FETCH_GAP)
		end
	end)
end

return Scoreboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[--!strict
-- Each run player's multiplier, score and kills. Kills arrive in batches
-- (one shot, blast or turret burst) so several at once earn the bonus.
-- Values are mirrored onto Player attributes for the HUD and teammate list.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combo = require(ReplicatedStorage.Shared.Combo)
local Net = require(ReplicatedStorage.Shared.Net)
local Unlocks = require(ReplicatedStorage.Shared.Unlocks)
local WeaponStats = require(ReplicatedStorage.Shared.WeaponStats)
local KillContext = require(script.Parent.KillContext)
local Loadout = require(script.Parent.Loadout)

local Announce = Net.event("Announce")

type Entry = { combo: Combo.State, score: number, kills: number }

export type Result = { userId: number, name: string, score: number, kills: number }

local Scoring = {}

local entries: { [Player]: Entry } = {}

local function publish(player: Player, entry: Entry?)
	player:SetAttribute("Mult", if entry then entry.combo.base else nil)
	player:SetAttribute("MultGraceEnd", if entry then entry.combo.graceEnd else nil)
	player:SetAttribute("Score", if entry then entry.score else nil)
	player:SetAttribute("Kills", if entry then entry.kills else nil)
end

function Scoring.reset(players: { Player })
	Scoring.clear()
	for _, player in players do
		local entry = { combo = Combo.new(), score = 0, kills = 0 }
		entries[player] = entry
		publish(player, entry)
	end
end

function Scoring.clear()
	for player in entries do
		publish(player, nil)
	end
	table.clear(entries)
end

function Scoring.remove(player: Player)
	entries[player] = nil
	publish(player, nil)
end

-- Scores the kills collected in a context and hands out any unlocks earned.
function Scoring.flush(context: KillContext.KillContext)
	local owner = context.owner
	if #context.kills == 0 or not owner then
		return
	end
	local entry = entries[owner]
	if not entry then
		return
	end
	local points, reached = Combo.addKills(entry.combo, workspace:GetServerTimeNow(), context.kills)
	entry.score += points
	entry.kills += #context.kills
	table.clear(context.kills)
	publish(owner, entry)

	for _, unlock in reached do
		Loadout.unlock(owner, unlock)
		local label = WeaponStats.unlockLabel(unlock.weapon, unlock.upgrade, Unlocks.UPGRADE_NAMES)
		if not unlock.upgrade then
			label ..= "  [" .. Loadout.keyLabel(unlock.weapon) .. "]"
		end
		Announce:FireClient(owner, label, "unlock")
	end
end

-- Pushes every drain timer back, e.g. after a pause.
function Scoring.shiftAll(seconds: number)
	for player, entry in entries do
		Combo.shift(entry.combo, seconds)
		publish(player, entry)
	end
end

function Scoring.results(): { Result }
	local list: { Result } = {}
	for player, entry in entries do
		table.insert(list, { userId = player.UserId, name = player.DisplayName, score = entry.score, kills = entry.kills })
	end
	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	return list
end

return Scoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Teleporter</string>
          <string name="Source"><![CDATA[--!strict
-- Sends a party into a game. In the published game the party is teleported
-- to its own private (reserved) server of this same place. In Studio, where
-- teleports don't work, the run happens right here in this server's arena.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local CharacterService = require(script.Parent.CharacterService)
local RunManager = require(script.Parent.RunManager)

local Announce = Net.event("Announce")

local Teleporter = {}

-- Where players go when a run in this server ends. Set by Main.
Teleporter.homeSpawn = function(_player: Player): CFrame?
	return nil
end

local function present(players: { Player }): { Player }
	local list = {}
	for _, player in players do
		if player.Parent == Players then
			table.insert(list, player)
		end
	end
	return list
end

-- Plays the run in this server's own arena.
function Teleporter.playHere(players: { Player }, roomId: string, difficulty: string)
	local started = RunManager.begin(players, roomId, difficulty, function(finished: { Player })
		for _, player in finished do
			local home = Teleporter.homeSpawn(player)
			if player.Parent and home then
				task.spawn(CharacterService.spawnAt, player, home)
			end
		end
	end)
	if not started then
		for _, player in players do
			Announce:FireClient(player, "ARENA BUSY - TRY AGAIN IN A MOMENT", "info")
		end
	end
end

function Teleporter.launch(players: { Player }, roomId: string, difficulty: string)
	if RunService:IsStudio() then
		Teleporter.playHere(players, roomId, difficulty)
		return
	end
	task.spawn(function()
		local userIds = {}
		for _, player in players do
			table.insert(userIds, player.UserId)
			Announce:FireClient(player, "TELEPORTING...", "info")
		end
		local options = Instance.new("TeleportOptions")
		options.ShouldReserveServer = true
		options:SetTeleportData({ room = roomId, difficulty = difficulty, party = userIds })
		for attempt = 1, Config.TELEPORT_RETRIES do
			local group = present(players)
			if #group == 0 then
				return
			end
			local ok, err = pcall(function()
				return TeleportService:TeleportAsync(game.PlaceId, group, options)
			end)
			if ok then
				return
			end
			warn("[Block Horde] party teleport failed (attempt " .. attempt .. "): " .. tostring(err))
			task.wait(2 * attempt)
		end
		-- Teleports keep failing: play in this server instead.
		Teleporter.playHere(present(players), roomId, difficulty)
	end)
end

-- From a party's private server: send everyone back to a lobby server.
function Teleporter.sendHome(players: { Player })
	task.spawn(function()
		for attempt = 1, 10 do
			local group = present(players)
			if #group == 0 then
				return
			end
			for _, player in group do
				Announce:FireClient(player, "BACK TO THE LOBBY...", "info")
			end
			local ok, err = pcall(function()
				return TeleportService:TeleportAsync(game.PlaceId, group)
			end)
			if ok then
				return
			end
			warn("[Block Horde] teleport home failed (attempt " .. attempt .. "): " .. tostring(err))
			task.wait(5)
		end
	end)
end

function Teleporter.start()
	TeleportService.TeleportInitFailed:Connect(function(player: Player, _result: Enum.TeleportResult, message: string)
		Announce:FireClient(player, "TELEPORT FAILED: " .. message, "info")
	end)
end

return Teleporter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[--!strict
-- Checks every shot a client asks for (in a run, alive, owns the weapon, fire
-- rate, ammo) and carries it out: hitscan bullets against the enemy table and
-- barrels, thrown grenades, rockets, or dropping a placeable on the cell in
-- front. Hitscan shots are echoed to every client so they can draw tracers;
-- the shooter already drew theirs instantly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Hitscan = require(ReplicatedStorage.Shared.Hitscan)
local Net = require(ReplicatedStorage.Shared.Net)
local WeaponStats = require(ReplicatedStorage.Shared.WeaponStats)
local Arena = require(script.Parent.Arena)
local EnemyService = require(script.Parent.EnemyService)
local KillContext = require(script.Parent.KillContext)
local Loadout = require(script.Parent.Loadout)
local Placeables = require(script.Parent.Placeables)
local Projectiles = require(script.Parent.Projectiles)
local RunState = require(script.Parent.RunState)
local Scoring = require(script.Parent.Scoring)

local Fire = Net.event("Fire")
local ShotFired = Net.event("ShotFired")

local WeaponService = {}

-- Per player, per weapon: the earliest time the next shot is allowed.
local nextShotAt: { [Player]: { [string]: number } } = {}
-- Grenades thrown in quick succession fly further.
local lastThrow: { [Player]: { at: number, distance: number } } = {}

local function enemyCircle(enemy: EnemyService.Enemy): (number, number, number)
	return enemy.x, enemy.z, enemy.radius
end

local function barrelCircle(barrel: Placeables.Placeable): (number, number, number)
	return barrel.x, barrel.z, Config.BARREL_RADIUS
end

-- Fires every pellet of a hitscan shot. Returns where each visible bullet stopped.
local function fireHitscan(player: Player, stats: WeaponStats.Stats, pos: Vector3, dirX: number, dirZ: number, seed: number, context: KillContext.KillContext): { Vector3 }
	local grid = Arena.grid()
	local y = pos.Y + Config.MUZZLE_HEIGHT
	local endpoints: { Vector3 } = {}
	for _, dir in WeaponStats.pelletDirections(dirX, dirZ, stats, seed) do
		local dx, dz = dir[1], dir[2]
		local wall = grid:raycast(pos.X, pos.Z, dx, dz, stats.range)
		local enemies, _, enemyDists = Hitscan.cast(pos.X, pos.Z, dx, dz, wall, EnemyService.list(), enemyCircle, math.huge)
		local barrels, _, barrelDists = Hitscan.cast(pos.X, pos.Z, dx, dz, wall, Placeables.barrels(), barrelCircle, math.huge)

		-- Walk the hits nearest first until the bullet has gone through `pierce` things.
		local ei, bi, taken = 1, 1, 0
		local travel = wall
		while taken < stats.pierce do
			local enemyDist, barrelDist = enemyDists[ei], barrelDists[bi]
			if enemyDist == nil and barrelDist == nil then
				break
			end
			if barrelDist == nil or (enemyDist ~= nil and enemyDist <= barrelDist) then
				EnemyService.damage(enemies[ei], stats.damage, context)
				travel = enemyDist
				ei += 1
			else
				Placeables.detonate(barrels[bi], 0, player)
				travel = barrelDist
				bi += 1
			end
			taken += 1
		end
		if taken < stats.pierce then
			travel = wall
		end
		if travel > Config.MUZZLE_FORWARD then
			table.insert(endpoints, Vector3.new(pos.X + dx * travel, y, pos.Z + dz * travel))
		end
	end
	return endpoints
end

local function onFire(player: Player, weaponId: unknown, dirX: unknown, dirZ: unknown, seed: unknown)
	if typeof(weaponId) ~= "string" or typeof(dirX) ~= "number" or typeof(dirZ) ~= "number" then
		return
	end
	if not Config.WEAPONS[weaponId] or not RunState.canAct(player) or not Loadout.owns(player, weaponId) then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local length = math.sqrt(dirX * dirX + dirZ * dirZ)
	if length ~= length or length < 0.01 then
		return -- NaN or zero direction
	end
	local dx, dz = dirX / length, dirZ / length
	local shotSeed = if typeof(seed) == "number" and seed == seed then math.floor(math.abs(seed)) % 1073741824 else 1

	local stats = Loadout.stats(player, weaponId)

	-- Fire rate check, with half an interval of slack for network jitter.
	local now = os.clock()
	local times = nextShotAt[player]
	if not times then
		times = {}
		nextShotAt[player] = times
	end
	local allowedAt = times[weaponId] or 0
	if now < allowedAt - stats.fireInterval * 0.5 then
		return
	end
	times[weaponId] = math.max(allowedAt, now) + stats.fireInterval

	if not Loadout.useAmmo(player, weaponId) then
		return
	end

	local pos = root.Position
	if stats.kind == "hitscan" then
		local context = KillContext.new(player)
		local endpoints = fireHitscan(player, stats, pos, dx, dz, shotSeed, context)
		Scoring.flush(context)
		EnemyService.flush()
		local muzzle = Vector3.new(pos.X + dx * Config.MUZZLE_FORWARD, pos.Y + Config.MUZZLE_HEIGHT, pos.Z + dz * Config.MUZZLE_FORWARD)
		ShotFired:FireAllClients(player, weaponId, muzzle, endpoints, shotSeed)
	elseif stats.kind == "grenade" then
		local last = lastThrow[player]
		local distance = stats.throwDistance
		if last and now - last.at <= stats.throwComboWindow then
			distance = math.min(last.distance + stats.throwStep, stats.throwMax)
		end
		lastThrow[player] = { at = now, distance = distance }
		Projectiles.throwGrenade(player, pos.X, pos.Z, dx, dz, distance, stats)
	elseif stats.kind == "rocket" then
		Projectiles.fireRocket(player, pos.X, pos.Z, dx, dz, stats)
	elseif stats.kind == "place" then
		local grid = Arena.grid()
		local ahead = grid.cellSize * 1.1
		local c, r = grid:worldToCell(pos.X + dx * ahead, pos.Z + dz * ahead)
		if not Placeables.place(player, stats.place or "", c, r, stats) then
			Loadout.refund(player, weaponId)
		end
	end
end

function WeaponService.start()
	Fire.OnServerEvent:Connect(onFire)
	Players.PlayerRemoving:Connect(function(player)
		nextShotAt[player] = nil
		lastThrow[player] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">WorldSetup</string>
          <string name="Source"><![CDATA[--!strict
-- One-time world setup: the dark ground around every room and collision rules.

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldSetup = {}

WorldSetup.PLAYER_GROUP = "Players"

function WorldSetup.start()
	-- Players walk through each other, so co-op partners never block a corridor.
	PhysicsService:RegisterCollisionGroup(WorldSetup.PLAYER_GROUP)
	PhysicsService:CollisionGroupSetCollidable(WorldSetup.PLAYER_GROUP, WorldSetup.PLAYER_GROUP, false)

	-- Dark ground under and around the rooms, so the overhead camera never sees sky.
	local void = Instance.new("Part")
	void.Name = "Void"
	void.Anchored = true
	void.Size = Vector3.new(2048, 1, 2048)
	void.CFrame = CFrame.new(0, -2, 0)
	void.Color = Config.VOID_COLOR
	void.Material = Enum.Material.SmoothPlastic
	void.TopSurface = Enum.SurfaceType.Smooth
	void.BottomSurface = Enum.SurfaceType.Smooth
	void.CastShadow = false
	void.Parent = workspace
end

return WorldSetup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
