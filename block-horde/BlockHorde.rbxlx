        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--!strict
-- Overhead camera: high above the player, tilted a little to look north,
-- narrow field of view. Smooth follow, no zoom, no rotation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local CharacterController = require(script.Parent.CharacterController)

local CameraController = {}

local focus: Vector3? = nil

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if camera.FieldOfView ~= Config.CAMERA_FOV then
		camera.FieldOfView = Config.CAMERA_FOV
	end

	local root = CharacterController.getRoot()
	if root then
		local target = Vector3.new(root.Position.X, 0, root.Position.Z)
		if focus then
			focus = focus:Lerp(target, 1 - math.exp(-Config.CAMERA_FOLLOW_SHARPNESS * dt))
		else
			focus = target
		end
	end

	local at = focus or Vector3.zero
	local tilt = math.rad(Config.CAMERA_TILT_DEG)
	local distance = Config.CAMERA_DISTANCE
	local eye = at + Vector3.new(0, distance * math.cos(tilt), distance * math.sin(tilt))
	camera.CFrame = CFrame.lookAt(eye, at)
end

function CameraController.start()
	RunService:BindToRenderStep("BlockHordeCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">CharacterController</string>
            <string name="Source"><![CDATA[--!strict
-- Moves the local character from input and turns it to face the aim direction.
-- Jumping is off and Humanoid.AutoRotate is off; facing is set here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Input = require(script.Parent.InputController)

local player = Players.LocalPlayer

local CharacterController = {}

local humanoid: Humanoid? = nil
local root: BasePart? = nil
local align: AlignOrientation? = nil
local facing = Vector3.new(0, 0, -1)

function CharacterController.getRoot(): BasePart?
	return root
end

-- Unit vector on the floor plane the character is facing (and shooting toward).
function CharacterController.getFacing(): Vector3
	return facing
end

function CharacterController.isAlive(): boolean
	return humanoid ~= nil and humanoid.Health > 0 and humanoid.Parent ~= nil
end

local function flat(v: Vector3): Vector3?
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-3 then
		return nil
	end
	return f.Unit
end

local function setup(character: Model)
	local h = character:WaitForChild("Humanoid") :: Humanoid
	local r = character:WaitForChild("HumanoidRootPart") :: BasePart
	h.AutoRotate = false
	h:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)

	local attachment = Instance.new("Attachment")
	attachment.Name = "FacingAttachment"
	attachment.Parent = r
	local a = Instance.new("AlignOrientation")
	a.Name = "Facing"
	a.Mode = Enum.OrientationAlignmentMode.OneAttachment
	a.Attachment0 = attachment
	a.RigidityEnabled = true
	a.Parent = r

	facing = flat(r.CFrame.LookVector) or Vector3.new(0, 0, -1)
	a.CFrame = CFrame.lookAt(Vector3.zero, facing)
	humanoid, root, align = h, r, a

	-- Hide our own name tag; teammates still see it.
	task.spawn(function()
		local hero = character:WaitForChild("Hero", 10)
		local head = hero and hero:WaitForChild("Head", 10)
		local tag = head and head:WaitForChild("NameTag", 10)
		if tag and tag:IsA("BillboardGui") then
			tag.Enabled = false
		end
	end)
end

local function update()
	local h, r, a = humanoid, root, align
	if not h or not r or not a or not h.Parent then
		return
	end
	if workspace:GetAttribute("Paused") == true or h.Health <= 0 then
		h:Move(Vector3.zero, false)
		return
	end

	local move = Input.getMoveVector()
	h:Move(move, false)

	local aim: Vector3? = nil
	if Input.scheme == "Mouse" then
		local point = Input.getMouseGroundPoint(r.Position.Y + Config.MUZZLE_HEIGHT)
		if point then
			local toPoint = point - r.Position
			if Vector3.new(toPoint.X, 0, toPoint.Z).Magnitude > 0.5 then
				aim = flat(toPoint)
			end
		end
	elseif move.Magnitude > 0.1 then
		aim = flat(move)
	end
	if aim then
		facing = aim
	end
	a.CFrame = CFrame.lookAt(Vector3.zero, facing)
end

function CharacterController.start()
	player.CharacterAdded:Connect(setup)
	if player.Character then
		task.spawn(setup, player.Character)
	end
	RunService:BindToRenderStep("BlockHordeCharacter", Enum.RenderPriority.Input.Value + 1, update)
end

return CharacterController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ClientArena</string>
            <string name="Source"><![CDATA[--!strict
-- The client's copy of the current room grid, rebuilt from the RoomId attribute
-- the server sets. Used to stop instant tracers at walls.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local RoomGrid = require(Shared:WaitForChild("RoomGrid"))
local Rooms = require(Shared:WaitForChild("Rooms"))

local ClientArena = {}

local current: RoomGrid.RoomGrid? = nil

local function rebuild()
	local roomId = ReplicatedStorage:GetAttribute("RoomId")
	if typeof(roomId) == "string" and Rooms[roomId] then
		current = RoomGrid.new(Rooms[roomId], Config.CELL_SIZE)
	else
		current = nil
	end
end

function ClientArena.grid(): RoomGrid.RoomGrid?
	return current
end

function ClientArena.start()
	rebuild()
	ReplicatedStorage:GetAttributeChangedSignal("RoomId"):Connect(rebuild)
end

return ClientArena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Short-lived visual effects drawn only on this client: bullet tracers and
-- muzzle flashes. Parts are pooled and reused instead of created per shot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Effects = {}

type Active = { part: Part, expiresAt: number, life: number }

local HIDDEN = CFrame.new(0, -10000, 0)
local FLASH_COLOR = Color3.fromRGB(255, 244, 180)

local folder: Folder
local pool: { Part } = {}
local active: { Active } = {}

local function takePart(): Part
	local pooled = table.remove(pool)
	if pooled then
		return pooled
	end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Parent = folder
	return part
end

local function show(part: Part, life: number)
	part.Transparency = 0
	table.insert(active, { part = part, expiresAt = os.clock() + life, life = life })
end

function Effects.tracer(from: Vector3, to: Vector3, color: Color3)
	local length = (to - from).Magnitude
	if length < 0.05 then
		return
	end
	local part = takePart()
	part.Size = Vector3.new(Config.TRACER_WIDTH, Config.TRACER_WIDTH, length)
	part.CFrame = CFrame.lookAt((from + to) / 2, to)
	part.Color = color
	show(part, Config.TRACER_LIFETIME)
end

function Effects.muzzleFlash(at: Vector3)
	local part = takePart()
	part.Size = Vector3.new(0.7, 0.7, 0.7)
	part.CFrame = CFrame.new(at)
	part.Color = FLASH_COLOR
	show(part, Config.MUZZLE_FLASH_TIME)
end

local function update()
	local now = os.clock()
	for i = #active, 1, -1 do
		local entry = active[i]
		local left = entry.expiresAt - now
		if left <= 0 then
			entry.part.Transparency = 1
			entry.part.CFrame = HIDDEN
			table.insert(pool, entry.part)
			active[i] = active[#active]
			active[#active] = nil
		else
			entry.part.Transparency = 1 - left / entry.life
		end
	end
end

function Effects.start()
	folder = Instance.new("Folder")
	folder.Name = "ClientEffects"
	folder.Parent = workspace
	RunService.Heartbeat:Connect(update)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">EnemyView</string>
            <string name="Source"><![CDATA[--!strict
-- Where this client thinks enemies are, for instant tracer endpoints.
-- Milestone 1 reads the practice dummies; Milestone 3 replaces this with
-- interpolated enemy snapshots from the server.

local EnemyView = {}

export type Target = { x: number, z: number, radius: number }

function EnemyView.getTargets(): { Target }
	local targets: { Target } = {}
	local folder = workspace:FindFirstChild("PracticeTargets")
	if not folder then
		return targets
	end
	for _, model in folder:GetChildren() do
		local radius = model:GetAttribute("Radius")
		if model:IsA("Model") and typeof(radius) == "number" then
			local pos = model:GetPivot().Position
			table.insert(targets, { x = pos.X, z = pos.Z, radius = radius })
		end
	end
	return targets
end

function EnemyView.circleOf(target: Target): (number, number, number)
	return target.x, target.z, target.radius
end

return EnemyView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--!strict
-- Turns keyboard, mouse and touch input into game intents: a move vector,
-- whether fire is held, weapon picks and pause.
--
-- Schemes:
--   Classic (default): WASD/arrows move in 8 directions and set facing, Space fires.
--   Mouse: WASD/arrows move, the mouse aims, click (or Space) fires.
--   Touch: on-screen thumbstick and buttons (see MobileControls).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

export type Scheme = "Classic" | "Mouse" | "Touch"

local Input = {}

Input.scheme = "Classic" :: Scheme
Input.SchemeChanged = Signal.new() -- (scheme: Scheme)
Input.WeaponSlot = Signal.new() -- (slot: number), 10 is the 0 key
Input.CycleWeapon = Signal.new() -- (step: number), -1 or 1
Input.PausePressed = Signal.new()

local NORTH = Vector3.new(0, 0, -1)
local SOUTH = Vector3.new(0, 0, 1)
local WEST = Vector3.new(-1, 0, 0)
local EAST = Vector3.new(1, 0, 0)

local MOVE_KEYS: { [Enum.KeyCode]: Vector3 } = {
	[Enum.KeyCode.W] = NORTH,
	[Enum.KeyCode.Up] = NORTH,
	[Enum.KeyCode.S] = SOUTH,
	[Enum.KeyCode.Down] = SOUTH,
	[Enum.KeyCode.A] = WEST,
	[Enum.KeyCode.Left] = WEST,
	[Enum.KeyCode.D] = EAST,
	[Enum.KeyCode.Right] = EAST,
}

local SLOT_KEYS: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
	[Enum.KeyCode.Zero] = 10,
}

local touchMove = Vector3.zero
local touchFire = false
local mouseFire = false
-- Keys pressed while the game had input focus (not typed into chat or a text box).
local held: { [Enum.KeyCode]: boolean } = {}

local function releaseAll()
	table.clear(held)
	mouseFire = false
end

-- World-space move direction on the floor plane, length 0 to 1.
function Input.getMoveVector(): Vector3
	if Input.scheme == "Touch" then
		return touchMove
	end
	local sum = Vector3.zero
	for key, dir in MOVE_KEYS do
		if held[key] then
			sum += dir
		end
	end
	-- W and Up together still count once.
	local move = Vector3.new(math.clamp(sum.X, -1, 1), 0, math.clamp(sum.Z, -1, 1))
	if move.Magnitude > 0 then
		return move.Unit
	end
	return move
end

function Input.isFireHeld(): boolean
	if Input.scheme == "Touch" then
		return touchFire
	end
	if held[Enum.KeyCode.Space] then
		return true
	end
	return Input.scheme == "Mouse" and mouseFire
end

-- The point under the mouse cursor on the horizontal plane at `height`.
function Input.getMouseGroundPoint(height: number): Vector3?
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end
	local t = (height - ray.Origin.Y) / ray.Direction.Y
	if t < 0 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

function Input.setTouchMove(move: Vector3)
	touchMove = move
end

function Input.setTouchFire(held: boolean)
	touchFire = held
end

function Input.setScheme(scheme: Scheme)
	if scheme ~= Input.scheme then
		Input.scheme = scheme
		mouseFire = false
		Input.SchemeChanged:Fire(scheme)
	end
end

function Input.start()
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		Input.scheme = "Touch"
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			mouseFire = true
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		held[key] = true
		local slot = SLOT_KEYS[key]
		if slot then
			Input.WeaponSlot:Fire(slot)
		elseif key == Enum.KeyCode.Q then
			Input.CycleWeapon:Fire(-1)
		elseif key == Enum.KeyCode.E then
			Input.CycleWeapon:Fire(1)
		elseif key == Enum.KeyCode.P then
			Input.PausePressed:Fire()
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			mouseFire = false
		elseif input.UserInputType == Enum.UserInputType.Keyboard then
			held[input.KeyCode] = nil
		end
	end)

	-- Never leave a key stuck down when focus moves to chat or another window.
	UserInputService.TextBoxFocused:Connect(releaseAll)
	UserInputService.WindowFocusReleased:Connect(releaseAll)
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="34">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry point: starts each controller once the game has loaded.

local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local CameraController = require(script.Parent.CameraController)
local CharacterController = require(script.Parent.CharacterController)
local ClientArena = require(script.Parent.ClientArena)
local Effects = require(script.Parent.Effects)
local Input = require(script.Parent.InputController)
local MobileControls = require(script.Parent.MobileControls)
local PauseUI = require(script.Parent.PauseUI)
local SettingsUI = require(script.Parent.SettingsUI)
local WeaponController = require(script.Parent.WeaponController)

-- Weapons use the number keys, so hide Roblox's tool bar. CoreGui may need a moment to be ready.
task.spawn(function()
	for _ = 1, 20 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false) then
			return
		end
		task.wait(0.5)
	end
end)

Input.start()
ClientArena.start()
Effects.start()
CharacterController.start()
CameraController.start()
WeaponController.start()
MobileControls.start()
SettingsUI.start()
PauseUI.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MobileControls</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen controls for phones and tablets: a thumbstick on the left half of
-- the screen to move and face, plus FIRE and SWAP (next weapon) buttons.

local UserInputService = game:GetService("UserInputService")

local Input = require(script.Parent.InputController)
local UI = require(script.Parent.UI)

local MobileControls = {}

local STICK_RADIUS = 60
local DEADZONE = 0.15

function MobileControls.start()
	local gui = UI.screen("MobileControls", 5)

	-- Thumbstick: appears where the thumb lands anywhere on the left half.
	local zone = Instance.new("Frame")
	zone.Name = "MoveZone"
	zone.BackgroundTransparency = 1
	zone.Size = UDim2.fromScale(0.5, 1)
	zone.Parent = gui

	local base = Instance.new("Frame")
	base.Name = "Stick"
	base.AnchorPoint = Vector2.new(0.5, 0.5)
	base.Size = UDim2.fromOffset(STICK_RADIUS * 2, STICK_RADIUS * 2)
	base.BackgroundColor3 = UI.DARK
	base.BackgroundTransparency = 0.55
	UI.round(base, STICK_RADIUS)
	base.Parent = zone
	local restPosition = UDim2.new(0, 120, 1, -120)
	base.Position = restPosition

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.Size = UDim2.fromOffset(56, 56)
	knob.BackgroundColor3 = UI.WHITE
	knob.BackgroundTransparency = 0.2
	UI.round(knob, 28)
	knob.Parent = base

	local moveTouch: InputObject? = nil
	local startPos = Vector2.zero

	local function releaseStick()
		moveTouch = nil
		Input.setTouchMove(Vector3.zero)
		base.Position = restPosition
		knob.Position = UDim2.fromScale(0.5, 0.5)
	end

	zone.InputBegan:Connect(function(input: InputObject)
		if moveTouch or input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		moveTouch = input
		startPos = Vector2.new(input.Position.X, input.Position.Y)
		base.Position = UDim2.fromOffset(startPos.X - zone.AbsolutePosition.X, startPos.Y - zone.AbsolutePosition.Y)
	end)

	UserInputService.TouchMoved:Connect(function(input: InputObject)
		if input ~= moveTouch then
			return
		end
		local offset = Vector2.new(input.Position.X, input.Position.Y) - startPos
		if offset.Magnitude > STICK_RADIUS then
			offset = offset.Unit * STICK_RADIUS
		end
		knob.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
		if offset.Magnitude / STICK_RADIUS < DEADZONE then
			Input.setTouchMove(Vector3.zero)
		else
			-- Screen down is south (+Z) because the camera looks north.
			Input.setTouchMove(Vector3.new(offset.X, 0, offset.Y) / STICK_RADIUS)
		end
	end)

	-- FIRE: hold to keep shooting.
	local fireButton = UI.button(gui, "FIRE", 28)
	fireButton.AnchorPoint = Vector2.new(1, 1)
	fireButton.Position = UDim2.new(1, -36, 1, -36)
	fireButton.Size = UDim2.fromOffset(112, 112)
	fireButton.BackgroundColor3 = Color3.fromRGB(196, 58, 40)
	UI.round(fireButton, 56)

	local fireTouch: InputObject? = nil
	local function releaseFire()
		fireTouch = nil
		Input.setTouchFire(false)
	end
	fireButton.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			fireTouch = input
			Input.setTouchFire(true)
		end
	end)

	UserInputService.TouchEnded:Connect(function(input: InputObject)
		if input == moveTouch then
			releaseStick()
		elseif input == fireTouch then
			releaseFire()
		end
	end)

	-- SWAP: next owned weapon.
	local swapButton = UI.button(gui, "SWAP", 20)
	swapButton.AnchorPoint = Vector2.new(1, 1)
	swapButton.Position = UDim2.new(1, -164, 1, -36)
	swapButton.Size = UDim2.fromOffset(76, 76)
	UI.round(swapButton, 38)
	swapButton.Activated:Connect(function()
		Input.CycleWeapon:Fire(1)
	end)

	local function refresh()
		gui.Enabled = Input.scheme == "Touch"
		if not gui.Enabled then
			releaseStick()
			releaseFire()
		end
	end
	Input.SchemeChanged:Connect(refresh)
	refresh()
end

return MobileControls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PauseUI</string>
            <string name="Source"><![CDATA[--!strict
-- Sends P presses to the server and shows a PAUSED overlay while paused.
-- Pausing only works with one player on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local Input = require(script.Parent.InputController)
local UI = require(script.Parent.UI)

local PauseUI = {}

function PauseUI.start()
	local gui = UI.screen("Pause", 20)
	gui.IgnoreGuiInset = true

	local shade = Instance.new("Frame")
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BackgroundTransparency = 0.45
	shade.Visible = false
	shade.Parent = gui

	local title = UI.text(shade, "PAUSED", 80)
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.45)
	title.Size = UDim2.fromOffset(600, 90)

	local hint = UI.text(shade, "Press P to resume", 24)
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.new(0.5, 0, 0.45, 56)
	hint.Size = UDim2.fromOffset(600, 30)

	local soloNote = UI.text(gui, "Pause only works when playing solo", 22)
	soloNote.AnchorPoint = Vector2.new(0.5, 0)
	soloNote.Position = UDim2.fromScale(0.5, 0.2)
	soloNote.Size = UDim2.fromOffset(600, 30)
	soloNote.Visible = false

	local function refresh()
		shade.Visible = workspace:GetAttribute("Paused") == true
	end
	workspace:GetAttributeChangedSignal("Paused"):Connect(refresh)
	refresh()

	local PauseRequest = Net.event("PauseRequest")
	local noteToken = 0
	Input.PausePressed:Connect(function()
		if #Players:GetPlayers() == 1 then
			PauseRequest:FireServer()
			return
		end
		noteToken += 1
		local token = noteToken
		soloNote.Visible = true
		task.delay(2, function()
			if token == noteToken then
				soloNote.Visible = false
			end
		end)
	end)
end

return PauseUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SettingsUI</string>
            <string name="Source"><![CDATA[--!strict
-- A SETTINGS button in the top right that opens a panel for switching
-- between Classic (keys only) and Mouse aim controls, with a control cheat sheet.

local Input = require(script.Parent.InputController)
local UI = require(script.Parent.UI)

local SettingsUI = {}

local HELP: { [string]: string } = {
	Classic = "WASD / Arrows: move and aim\nSpace: fire\n1-9, 0: pick weapon    Q / E: cycle\nP: pause (solo only)",
	Mouse = "WASD / Arrows: move\nMouse: aim    Click or Space: fire\n1-9, 0: pick weapon    Q / E: cycle\nP: pause (solo only)",
	Touch = "Left thumb: move and aim\nFIRE: shoot    SWAP: next weapon",
}

function SettingsUI.start()
	local gui = UI.screen("Settings", 10)

	local openButton = UI.button(gui, "SETTINGS", 16)
	openButton.AnchorPoint = Vector2.new(1, 0)
	openButton.Position = UDim2.new(1, -12, 0, 12)
	openButton.Size = UDim2.fromOffset(110, 34)

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(380, 300)
	panel.BackgroundColor3 = UI.PANEL
	panel.BackgroundTransparency = 0.08
	panel.Visible = false
	UI.round(panel, 14)
	panel.Parent = gui

	local title = UI.text(panel, "SETTINGS", 30)
	title.Position = UDim2.fromOffset(0, 12)
	title.Size = UDim2.new(1, 0, 0, 36)

	local controlsLabel = UI.text(panel, "CONTROLS", 18)
	controlsLabel.Position = UDim2.fromOffset(0, 58)
	controlsLabel.Size = UDim2.new(1, 0, 0, 24)

	local classicButton = UI.button(panel, "CLASSIC", 20)
	classicButton.Position = UDim2.fromOffset(20, 90)
	classicButton.Size = UDim2.fromOffset(165, 40)

	local mouseButton = UI.button(panel, "MOUSE AIM", 20)
	mouseButton.Position = UDim2.fromOffset(195, 90)
	mouseButton.Size = UDim2.fromOffset(165, 40)

	local help = UI.text(panel, "", 16)
	help.Position = UDim2.fromOffset(20, 142)
	help.Size = UDim2.new(1, -40, 0, 100)
	help.TextWrapped = true
	help.TextYAlignment = Enum.TextYAlignment.Top

	local closeButton = UI.button(panel, "CLOSE", 20)
	closeButton.AnchorPoint = Vector2.new(0.5, 1)
	closeButton.Position = UDim2.new(0.5, 0, 1, -14)
	closeButton.Size = UDim2.fromOffset(140, 38)

	local function refresh()
		local touch = Input.scheme == "Touch"
		classicButton.Visible = not touch
		mouseButton.Visible = not touch
		controlsLabel.Text = if touch then "TOUCH CONTROLS" else "CONTROLS"
		classicButton.BackgroundColor3 = if Input.scheme == "Classic" then UI.ACCENT else UI.BUTTON
		mouseButton.BackgroundColor3 = if Input.scheme == "Mouse" then UI.ACCENT else UI.BUTTON
		help.Text = HELP[Input.scheme] or ""
	end

	openButton.Activated:Connect(function()
		panel.Visible = not panel.Visible
		refresh()
	end)
	closeButton.Activated:Connect(function()
		panel.Visible = false
	end)
	classicButton.Activated:Connect(function()
		Input.setScheme("Classic")
	end)
	mouseButton.Activated:Connect(function()
		Input.setScheme("Mouse")
	end)
	Input.SchemeChanged:Connect(refresh)
	refresh()
end

return SettingsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Shared look for every screen: chunky FredokaOne text, white with a dark outline.

local Players = game:GetService("Players")

local UI = {}

UI.FONT = Enum.Font.FredokaOne
UI.WHITE = Color3.new(1, 1, 1)
UI.DARK = Color3.fromRGB(22, 22, 28)
UI.PANEL = Color3.fromRGB(36, 36, 46)
UI.BUTTON = Color3.fromRGB(60, 60, 74)
UI.ACCENT = Color3.fromRGB(232, 170, 40)

function UI.screen(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function UI.round(object: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = object
end

function UI.text(parent: Instance, text: string, textSize: number): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = UI.FONT
	label.Text = text
	label.TextSize = textSize
	label.TextColor3 = UI.WHITE
	label.TextStrokeColor3 = UI.DARK
	label.TextStrokeTransparency = 0
	label.Parent = parent
	return label
end

function UI.button(parent: Instance, text: string, textSize: number): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = true
	button.BackgroundColor3 = UI.BUTTON
	button.Font = UI.FONT
	button.Text = text
	button.TextSize = textSize
	button.TextColor3 = UI.WHITE
	button.TextStrokeColor3 = UI.DARK
	button.TextStrokeTransparency = 0
	UI.round(button, 10)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = UI.DARK
	stroke.Thickness = 2
	stroke.Parent = button
	button.Parent = parent
	return button
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">WeaponController</string>
            <string name="Source"><![CDATA[--!strict
-- The local player's weapons: picks the equipped weapon, fires while the fire
-- input is held, draws the tracer instantly, and asks the server to shoot.
-- Also draws other players' shots when the server reports them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Hitscan = require(Shared:WaitForChild("Hitscan"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Signal"))
local CharacterController = require(script.Parent.CharacterController)
local ClientArena = require(script.Parent.ClientArena)
local Effects = require(script.Parent.Effects)
local EnemyView = require(script.Parent.EnemyView)
local Input = require(script.Parent.InputController)

local Fire = Net.event("Fire")
local ShotFired = Net.event("ShotFired")
local WeaponState = Net.event("WeaponState")

local WeaponController = {}

WeaponController.Changed = Signal.new() -- fires when the equipped weapon, owned list or ammo changes

local equipped = "pistol"
local owned: { [string]: boolean } = { pistol = true }
local ammo: { [string]: number } = {}
local nextShotAt = 0

function WeaponController.getEquipped(): string
	return equipped
end

function WeaponController.getAmmo(weaponId: string): number?
	local weapon = Config.WEAPONS[weaponId]
	if not weapon or weapon.maxAmmo == nil then
		return nil -- infinite
	end
	return ammo[weaponId] or 0
end

local function ownedInSlotOrder(): { string }
	local list = {}
	for id in owned do
		if Config.WEAPONS[id] then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		return Config.WEAPONS[a].slot < Config.WEAPONS[b].slot
	end)
	return list
end

local function equip(weaponId: string)
	if owned[weaponId] and Config.WEAPONS[weaponId] and weaponId ~= equipped then
		equipped = weaponId
		WeaponController.Changed:Fire()
	end
end

local function fire()
	local weapon = Config.WEAPONS[equipped]
	local root = CharacterController.getRoot()
	if not weapon or not root then
		return
	end
	if weapon.maxAmmo ~= nil then
		local left = ammo[equipped] or 0
		if left <= 0 then
			return
		end
		ammo[equipped] = left - 1
		WeaponController.Changed:Fire()
	end

	local dir = CharacterController.getFacing()
	local pos = root.Position
	local y = pos.Y + Config.MUZZLE_HEIGHT
	local muzzle = Vector3.new(pos.X + dir.X * Config.MUZZLE_FORWARD, y, pos.Z + dir.Z * Config.MUZZLE_FORWARD)

	-- Predict where the bullet stops, the same way the server will.
	local grid = ClientArena.grid()
	local maxDist = if grid then grid:raycast(pos.X, pos.Z, dir.X, dir.Z, weapon.range) else weapon.range
	local _, travel = Hitscan.cast(pos.X, pos.Z, dir.X, dir.Z, maxDist, EnemyView.getTargets(), EnemyView.circleOf, weapon.pierce)

	Effects.muzzleFlash(muzzle)
	if travel > Config.MUZZLE_FORWARD then
		Effects.tracer(muzzle, Vector3.new(pos.X + dir.X * travel, y, pos.Z + dir.Z * travel), weapon.tracerColor)
	end
	Fire:FireServer(equipped, dir.X, dir.Z)
end

local function update()
	if not Input.isFireHeld() or workspace:GetAttribute("Paused") == true or not CharacterController.isAlive() then
		return
	end
	local weapon = Config.WEAPONS[equipped]
	local now = os.clock()
	if weapon and now >= nextShotAt then
		nextShotAt = now + weapon.fireInterval
		fire()
	end
end

local function onWeaponState(ownedList: { string }, ammoTable: { [string]: number })
	owned = {}
	for _, id in ownedList do
		owned[id] = true
	end
	ammo = ammoTable
	if not owned[equipped] then
		equipped = "pistol"
	end
	WeaponController.Changed:Fire()
end

local function onShotFired(shooter: Player, weaponId: string, muzzle: Vector3, endpoints: { Vector3 })
	if shooter == Players.LocalPlayer then
		return -- already drawn when we fired
	end
	local weapon = Config.WEAPONS[weaponId]
	if not weapon then
		return
	end
	Effects.muzzleFlash(muzzle)
	for _, point in endpoints do
		Effects.tracer(muzzle, point, weapon.tracerColor)
	end
end

function WeaponController.start()
	Input.WeaponSlot:Connect(function(slot: number)
		for id in owned do
			local weapon = Config.WEAPONS[id]
			if weapon and weapon.slot == slot then
				equip(id)
				return
			end
		end
	end)
	Input.CycleWeapon:Connect(function(step: number)
		local list = ownedInSlotOrder()
		if #list == 0 then
			return
		end
		local index = table.find(list, equipped) or 1
		equip(list[(index - 1 + step) % #list + 1])
	end)
	WeaponState.OnClientEvent:Connect(onWeaponState)
	ShotFired.OnClientEvent:Connect(onShotFired)
	RunService.Heartbeat:Connect(update)
end

return WeaponController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
