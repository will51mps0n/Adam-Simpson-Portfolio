      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--!strict
-- Owns the room being played: builds it and keeps its grid for hit tests and spawns.
-- Clients rebuild the same grid from the RoomId attribute on ReplicatedStorage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Rooms = require(ReplicatedStorage.Shared.Rooms)
local RoomBuilder = require(script.Parent.RoomBuilder)

local Arena = {}

local current: RoomGrid.RoomGrid? = nil

function Arena.load(roomId: string): RoomGrid.RoomGrid
	local def = Rooms[roomId]
	assert(def, "Unknown room: " .. roomId)
	local grid = RoomGrid.new(def, Config.CELL_SIZE)
	RoomBuilder.build(grid)
	current = grid
	ReplicatedStorage:SetAttribute("RoomId", roomId)
	return grid
end

function Arena.grid(): RoomGrid.RoomGrid
	return assert(current, "No room loaded")
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--!strict
-- Spawns players on the room's 'P' cells and dresses them as blocky heroes:
-- the Roblox avatar is hidden and block parts are welded on top of it.
-- Each player keeps a slot (1-6) that picks their shirt color and spawn cell.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local HeroModel = require(ReplicatedStorage.Shared.Models.HeroModel)
local Arena = require(script.Parent.Arena)
local Loadout = require(script.Parent.Loadout)
local WorldSetup = require(script.Parent.WorldSetup)

local CharacterService = {}

local SPAWN_HEIGHT = 3.5 -- root part height above the floor when placed

local slots: { [Player]: number } = {}

local function takeFreeSlot(): number
	local taken: { [number]: boolean } = {}
	for _, slot in slots do
		taken[slot] = true
	end
	for slot = 1, #Config.SHIRT_COLORS do
		if not taken[slot] then
			return slot
		end
	end
	return 1
end

local LEG_PARTS = {
	LeftLeg = { "LeftUpperLeg", "Left Leg" }, -- R15, R6
	RightLeg = { "RightUpperLeg", "Right Leg" },
}

local function findLeg(character: Model, which: string): BasePart?
	for _, name in LEG_PARTS[which] do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

-- Hides one piece of the Roblox avatar. Hero parts are tagged and left alone.
local function hideAvatarPiece(instance: Instance)
	if instance:IsA("Accessory") then
		task.defer(instance.Destroy, instance)
	elseif instance:IsA("BasePart") then
		instance.CollisionGroup = WorldSetup.PLAYER_GROUP
		if not instance:GetAttribute("Hero") then
			instance.Transparency = 1
			instance.CastShadow = false
		end
	elseif instance:IsA("Decal") then
		instance.Transparency = 1
	end
end

local function addNameTag(head: BasePart, player: Player, shirt: Color3)
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(160, 24)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 18
	label.TextColor3 = shirt:Lerp(Color3.new(1, 1, 1), 0.35)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Text = player.DisplayName
	label.Parent = tag

	tag.Parent = head
end

local function dress(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart

	humanoid.WalkSpeed = Config.WALK_SPEED
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = Config.PLAYER_MAX_HEALTH
	humanoid.Health = Config.PLAYER_MAX_HEALTH

	for _, descendant in character:GetDescendants() do
		hideAvatarPiece(descendant)
	end
	character.DescendantAdded:Connect(hideAvatarPiece)

	local shirt = Config.SHIRT_COLORS[slots[player] or 1]
	local hero = Instance.new("Folder")
	hero.Name = "Hero"
	for _, spec in HeroModel.parts(shirt) do
		local part = Instance.new("Part")
		part.Name = spec.name
		part.Size = spec.size
		part.Color = spec.color
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Transparency = spec.transparency or 0
		if spec.shape then
			part.Shape = spec.shape
			part.CastShadow = false
		end
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part:SetAttribute("Hero", true)

		-- Legs ride on the avatar's legs (top edges lined up) so the walk animation swings them.
		local anchor: BasePart = root
		local offset = spec.offset
		if spec.attach ~= "Root" then
			local leg = findLeg(character, spec.attach)
			if leg then
				anchor = leg
				offset = CFrame.new(0, leg.Size.Y / 2 - spec.size.Y / 2, 0)
			end
		end
		part.CFrame = anchor.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Part0 = anchor
		weld.Part1 = part
		weld.C0 = offset
		weld.Parent = part

		part.Parent = hero
		if spec.name == "Head" then
			addNameTag(part, player, shirt)
		end
	end
	hero.Parent = character
end

local function spawnCFrame(player: Player): CFrame
	local grid = Arena.grid()
	local cells = grid:find("P")
	if #cells == 0 then
		return CFrame.new(0, SPAWN_HEIGHT, 0)
	end
	local cell = cells[((slots[player] or 1) - 1) % #cells + 1]
	local x, z = grid:cellCenter(cell.c, cell.r)
	return CFrame.new(x, SPAWN_HEIGHT, z) -- facing north
end

local function onCharacterAdded(player: Player, character: Model)
	dress(player, character)
	Loadout.sync(player)

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		task.delay(Config.RESPAWN_DELAY, function()
			if player.Parent and player.Character == character then
				player:LoadCharacterAsync()
			end
		end)
	end)

	-- Move to the spawn cell once the engine has finished placing the character.
	task.spawn(function()
		if not character:IsDescendantOf(workspace) then
			character.AncestryChanged:Wait()
		end
		task.wait()
		character:PivotTo(spawnCFrame(player))
	end)
end

local function onPlayerAdded(player: Player)
	slots[player] = takeFreeSlot()
	Loadout.reset(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	else
		player:LoadCharacterAsync()
	end
end

function CharacterService.start()
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		slots[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Enemies</string>
          <string name="Source"><![CDATA[--!strict
-- The server's enemy table. Enemies are plain data (no Humanoids), so the
-- server can run hundreds of them. Hit tests treat each one as a circle.
-- Milestone 1 only holds practice dummies; Milestone 3 adds movement and
-- replication to clients.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)

export type Enemy = {
	id: number,
	kind: string,
	x: number,
	z: number,
	radius: number,
	health: number,
	maxHealth: number,
	alive: boolean,
}

local Enemies = {}

Enemies.Hit = Signal.new() -- (enemy: Enemy, attacker: Player?)
Enemies.Killed = Signal.new() -- (enemy: Enemy, attacker: Player?)

local living: { Enemy } = {}
local lastId = 0

function Enemies.spawn(kind: string, x: number, z: number, health: number, radius: number): Enemy
	lastId += 1
	local enemy: Enemy = {
		id = lastId,
		kind = kind,
		x = x,
		z = z,
		radius = radius,
		health = health,
		maxHealth = health,
		alive = true,
	}
	table.insert(living, enemy)
	return enemy
end

-- All living enemies. Do not modify the returned list.
function Enemies.list(): { Enemy }
	return living
end

-- Applies damage and returns true if this killed the enemy.
function Enemies.damage(enemy: Enemy, amount: number, attacker: Player?): boolean
	if not enemy.alive then
		return false
	end
	enemy.health -= amount
	if enemy.health > 0 then
		Enemies.Hit:Fire(enemy, attacker)
		return false
	end
	enemy.alive = false
	local index = table.find(living, enemy)
	if index then
		living[index] = living[#living]
		living[#living] = nil
	end
	Enemies.Killed:Fire(enemy, attacker)
	return true
end

return Enemies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Loadout</string>
          <string name="Source"><![CDATA[--!strict
-- Which weapons each player owns this run, and their ammo.
-- Everyone starts with only the infinite-ammo pistol.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local WeaponState = Net.event("WeaponState")

type State = {
	owned: { [string]: boolean },
	ammo: { [string]: number },
}

local Loadout = {}

local states: { [Player]: State } = {}

-- Sends the player's owned weapons and ammo to their client.
function Loadout.sync(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local owned = {}
	for id in state.owned do
		table.insert(owned, id)
	end
	WeaponState:FireClient(player, owned, state.ammo)
end

function Loadout.reset(player: Player)
	states[player] = { owned = { pistol = true }, ammo = {} }
	Loadout.sync(player)
end

function Loadout.owns(player: Player, weaponId: string): boolean
	local state = states[player]
	return state ~= nil and state.owned[weaponId] == true
end

-- Spends one shot of ammo. Returns false if the weapon is empty.
function Loadout.useAmmo(player: Player, weaponId: string): boolean
	local weapon = Config.WEAPONS[weaponId]
	local state = states[player]
	if not weapon or not state then
		return false
	end
	if weapon.maxAmmo == nil then
		return true
	end
	local left = state.ammo[weaponId] or 0
	if left <= 0 then
		return false
	end
	state.ammo[weaponId] = left - 1
	return true
end

function Loadout.start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return Loadout
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds the world, then starts each service in order.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Arena = require(script.Parent.Arena)
local CharacterService = require(script.Parent.CharacterService)
local Loadout = require(script.Parent.Loadout)
local PauseService = require(script.Parent.PauseService)
local PracticeTargets = require(script.Parent.PracticeTargets)
local WeaponService = require(script.Parent.WeaponService)
local WorldSetup = require(script.Parent.WorldSetup)

WorldSetup.start()
local grid = Arena.load(Config.START_ROOM)
Loadout.start()
PauseService.start()
WeaponService.start()
PracticeTargets.start(grid)
CharacterService.start() -- last, because it spawns players into the room
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PauseService</string>
          <string name="Source"><![CDATA[--!strict
-- P pauses the game, but only when one player is on the server.
-- The paused state is a workspace attribute so every client can see it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local PauseService = {}

local paused = false

local function setPaused(value: boolean)
	paused = value
	workspace:SetAttribute("Paused", value)
end

function PauseService.isPaused(): boolean
	return paused
end

function PauseService.start()
	setPaused(false)
	Net.event("PauseRequest").OnServerEvent:Connect(function()
		if #Players:GetPlayers() == 1 then
			setPaused(not paused)
		end
	end)
	-- Someone joining always unpauses.
	Players.PlayerAdded:Connect(function()
		if paused then
			setPaused(false)
		end
	end)
end

return PauseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PracticeTargets</string>
          <string name="Source"><![CDATA[--!strict
-- Milestone 1 stand-ins for zombies: wooden dummies on the room's 'T' cells.
-- They flash white when hit, break when killed and come back a few seconds later.
-- Milestone 3 replaces these with real zombies.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)
local Enemies = require(script.Parent.Enemies)

local PracticeTargets = {}

local WOOD_LIGHT = Color3.fromRGB(204, 160, 102)
local WOOD_DARK = Color3.fromRGB(122, 84, 52)
local TARGET_RED = Color3.fromRGB(214, 40, 40)
local TARGET_WHITE = Color3.fromRGB(245, 245, 245)

local folder: Folder
local models: { [number]: Model } = {}

local function addPart(model: Model, size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		part.Shape = shape
	end
	part:SetAttribute("BaseColor", color)
	part.Parent = model
	return part
end

local function buildDummy(x: number, z: number): Model
	local model = Instance.new("Model")
	model.Name = "Dummy"
	local at = CFrame.new(x, 0, z)
	local up = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder to lie flat
	addPart(model, Vector3.new(2.2, 0.4, 2.2), at * CFrame.new(0, 0.2, 0), WOOD_DARK)
	local body = addPart(model, Vector3.new(1.8, 2.2, 1), at * CFrame.new(0, 1.5, 0), WOOD_LIGHT)
	addPart(model, Vector3.new(3, 0.4, 0.4), at * CFrame.new(0, 2.2, 0), WOOD_DARK)
	addPart(model, Vector3.new(1.6, 1.6, 1.6), at * CFrame.new(0, 3.4, 0), WOOD_LIGHT)
	-- A bullseye painted on top of the head, which is what the overhead camera sees.
	addPart(model, Vector3.new(0.1, 1.3, 1.3), at * CFrame.new(0, 4.22, 0) * up, TARGET_RED, Enum.PartType.Cylinder)
	addPart(model, Vector3.new(0.1, 0.85, 0.85), at * CFrame.new(0, 4.24, 0) * up, TARGET_WHITE, Enum.PartType.Cylinder)
	addPart(model, Vector3.new(0.1, 0.4, 0.4), at * CFrame.new(0, 4.26, 0) * up, TARGET_RED, Enum.PartType.Cylinder)
	model.PrimaryPart = body
	model:SetAttribute("Radius", Config.DUMMY_RADIUS)
	return model
end

local function spawnDummy(x: number, z: number)
	local enemy = Enemies.spawn("Dummy", x, z, Config.DUMMY_HEALTH, Config.DUMMY_RADIUS)
	local model = buildDummy(x, z)
	model.Parent = folder
	models[enemy.id] = model
end

local function flash(model: Model)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			part.Color = Color3.new(1, 1, 1)
		end
	end
	task.delay(Config.HIT_FLASH_TIME, function()
		for _, part in model:GetChildren() do
			local base = part:GetAttribute("BaseColor")
			if part:IsA("BasePart") and typeof(base) == "Color3" then
				part.Color = base
			end
		end
	end)
end

function PracticeTargets.start(grid: RoomGrid.RoomGrid)
	folder = Instance.new("Folder")
	folder.Name = "PracticeTargets"
	folder.Parent = workspace

	Enemies.Hit:Connect(function(enemy: Enemies.Enemy)
		local model = models[enemy.id]
		if model then
			flash(model)
		end
	end)

	Enemies.Killed:Connect(function(enemy: Enemies.Enemy)
		local model = models[enemy.id]
		if not model then
			return
		end
		models[enemy.id] = nil
		model:Destroy()
		task.delay(Config.DUMMY_RESPAWN, spawnDummy, enemy.x, enemy.z)
	end)

	for _, cell in grid:find("T") do
		spawnDummy(grid:cellCenter(cell.c, cell.r))
	end
end

return PracticeTargets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">RoomBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a RoomGrid into parts: a checkered tile floor and block walls.
-- Neighbouring wall cells are merged into large rectangles to keep part count low.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RoomGrid = require(ReplicatedStorage.Shared.RoomGrid)

local RoomBuilder = {}

local FLOOR_THICKNESS = 1
local TILE_RAISE = 0.04 -- the darker tiles sit a hair above the base floor to avoid flicker
local WALL_CAP = 0.4 -- thickness of the darker top of each wall

local function block(name: string, size: Vector3, cframe: CFrame, color: Color3, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function buildFloor(grid: RoomGrid.RoomGrid, folder: Instance)
	local size = grid.cellSize
	local w, h = grid.width * size, grid.height * size
	local base = block(
		"Floor",
		Vector3.new(w, FLOOR_THICKNESS, h),
		CFrame.new(grid.originX + w / 2, -FLOOR_THICKNESS / 2, grid.originZ + h / 2),
		Config.FLOOR_COLOR_A,
		folder
	)
	base.CastShadow = false

	for r = 1, grid.height do
		for c = 1, grid.width do
			if (c + r) % 2 == 0 and grid:cell(c, r) ~= "#" then
				local x, z = grid:cellCenter(c, r)
				local tile = block("Tile", Vector3.new(size, 0.2, size), CFrame.new(x, TILE_RAISE - 0.1, z), Config.FLOOR_COLOR_B, folder)
				tile.CanCollide = false
				tile.CanQuery = false
				tile.CanTouch = false
				tile.CastShadow = false
			end
		end
	end
end

local function buildWalls(grid: RoomGrid.RoomGrid, folder: Instance)
	local size = grid.cellSize
	local used: { [number]: boolean } = {}
	local function key(c: number, r: number): number
		return r * 10000 + c
	end
	local function free(c: number, r: number): boolean
		return grid:cell(c, r) == "#" and grid:inBounds(c, r) and not used[key(c, r)]
	end

	for r = 1, grid.height do
		for c = 1, grid.width do
			if free(c, r) then
				-- Grow the widest run on this row, then extend it down while every cell matches.
				local runW = 1
				while free(c + runW, r) do
					runW += 1
				end
				local runH = 1
				while true do
					local rowOk = true
					for cc = c, c + runW - 1 do
						if not free(cc, r + runH) then
							rowOk = false
							break
						end
					end
					if not rowOk then
						break
					end
					runH += 1
				end
				for rr = r, r + runH - 1 do
					for cc = c, c + runW - 1 do
						used[key(cc, rr)] = true
					end
				end

				local x0, z0 = grid:cellCenter(c, r)
				local cx = x0 + (runW - 1) * size / 2
				local cz = z0 + (runH - 1) * size / 2
				local footprint = Vector2.new(runW * size, runH * size)
				local bodyHeight = Config.WALL_HEIGHT - WALL_CAP
				block("Wall", Vector3.new(footprint.X, bodyHeight, footprint.Y), CFrame.new(cx, bodyHeight / 2, cz), Config.WALL_COLOR, folder)
				local cap = block(
					"WallTop",
					Vector3.new(footprint.X, WALL_CAP, footprint.Y),
					CFrame.new(cx, bodyHeight + WALL_CAP / 2, cz),
					Config.WALL_TOP_COLOR,
					folder
				)
				cap.CastShadow = false
			end
		end
	end
end

-- Builds the room into workspace.Arena, replacing whatever room was there.
function RoomBuilder.build(grid: RoomGrid.RoomGrid): Folder
	local old = workspace:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Arena"
	buildFloor(grid, folder)
	buildWalls(grid, folder)
	folder.Parent = workspace
	return folder
end

return RoomBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[--!strict
-- Checks every shot a client asks for (owned weapon, fire rate, ammo) and
-- applies hitscan damage against the enemy table. Then tells all clients so
-- they can draw the tracer; the shooter already drew theirs instantly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Hitscan = require(ReplicatedStorage.Shared.Hitscan)
local Net = require(ReplicatedStorage.Shared.Net)
local Arena = require(script.Parent.Arena)
local Enemies = require(script.Parent.Enemies)
local Loadout = require(script.Parent.Loadout)
local PauseService = require(script.Parent.PauseService)

local Fire = Net.event("Fire")
local ShotFired = Net.event("ShotFired")

local WeaponService = {}

-- Per player, per weapon: the earliest time the next shot is allowed.
local nextShotAt: { [Player]: { [string]: number } } = {}

local function circleOf(enemy: Enemies.Enemy): (number, number, number)
	return enemy.x, enemy.z, enemy.radius
end

local function onFire(player: Player, weaponId: unknown, dirX: unknown, dirZ: unknown)
	if typeof(weaponId) ~= "string" or typeof(dirX) ~= "number" or typeof(dirZ) ~= "number" then
		return
	end
	local weapon = Config.WEAPONS[weaponId]
	if not weapon or PauseService.isPaused() or not Loadout.owns(player, weaponId) then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end

	local length = math.sqrt(dirX * dirX + dirZ * dirZ)
	if length ~= length or length < 0.01 then
		return -- NaN or zero direction
	end
	local dx, dz = dirX / length, dirZ / length

	-- Fire rate check, with half an interval of slack for network jitter.
	local now = os.clock()
	local times = nextShotAt[player]
	if not times then
		times = {}
		nextShotAt[player] = times
	end
	local allowedAt = times[weaponId] or 0
	if now < allowedAt - weapon.fireInterval * 0.5 then
		return
	end
	times[weaponId] = math.max(allowedAt, now) + weapon.fireInterval

	if not Loadout.useAmmo(player, weaponId) then
		return
	end

	-- Cast from the player's center so enemies hugging the gun still get hit.
	local pos = root.Position
	local wallDist = Arena.grid():raycast(pos.X, pos.Z, dx, dz, weapon.range)
	local hits, travel = Hitscan.cast(pos.X, pos.Z, dx, dz, wallDist, Enemies.list(), circleOf, weapon.pierce)
	for _, enemy in hits do
		Enemies.damage(enemy, weapon.damage, player)
	end

	local y = pos.Y + Config.MUZZLE_HEIGHT
	local muzzle = Vector3.new(pos.X + dx * Config.MUZZLE_FORWARD, y, pos.Z + dz * Config.MUZZLE_FORWARD)
	local endpoints = {}
	if travel > Config.MUZZLE_FORWARD then
		table.insert(endpoints, Vector3.new(pos.X + dx * travel, y, pos.Z + dz * travel))
	end
	ShotFired:FireAllClients(player, weaponId, muzzle, endpoints)
end

function WeaponService.start()
	Fire.OnServerEvent:Connect(onFire)
	Players.PlayerRemoving:Connect(function(player)
		nextShotAt[player] = nil
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">WorldSetup</string>
          <string name="Source"><![CDATA[--!strict
-- One-time world setup: the dark ground around every room and collision rules.

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldSetup = {}

WorldSetup.PLAYER_GROUP = "Players"

function WorldSetup.start()
	-- Players walk through each other, so co-op partners never block a corridor.
	PhysicsService:RegisterCollisionGroup(WorldSetup.PLAYER_GROUP)
	PhysicsService:CollisionGroupSetCollidable(WorldSetup.PLAYER_GROUP, WorldSetup.PLAYER_GROUP, false)

	-- Dark ground under and around the rooms, so the overhead camera never sees sky.
	local void = Instance.new("Part")
	void.Name = "Void"
	void.Anchored = true
	void.Size = Vector3.new(2048, 1, 2048)
	void.CFrame = CFrame.new(0, -2, 0)
	void.Color = Config.VOID_COLOR
	void.Material = Enum.Material.SmoothPlastic
	void.TopSurface = Enum.SurfaceType.Smooth
	void.BottomSurface = Enum.SurfaceType.Smooth
	void.CastShadow = false
	void.Parent = workspace
end

return WorldSetup
]]></string>
        </Properties>
      </Item>
    </Item>
