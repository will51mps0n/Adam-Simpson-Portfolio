{
  "name": "BlockHorde",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false,
        "CharacterJumpPower": 0,
        "CharacterJumpHeight": 0,
        "AutoJumpEnabled": false,
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "Scriptable",
        "DevTouchMovementMode": "Scriptable"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "GlobalShadows": true,
        "Brightness": 2.5,
        "ClockTime": 13.5,
        "GeographicLatitude": 20,
        "Ambient": [
          0.45,
          0.45,
          0.47
        ],
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.57
        ],
        "ShadowSoftness": 0.4,
        "FogStart": 0,
        "FogEnd": 100000
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
