-- Block Horde installer. Generated by tools/build_installer.py: do not edit.
-- The Command Bar line downloads this file into a ModuleScript and calls the
-- function it returns. That downloads bundle.json (every script, as data)
-- and (re)installs it into the place open in Roblox Studio.

local HttpService = game:GetService("HttpService")

local REPO = "{{REPO}}"
local BRANCH = "{{BRANCH}}"
local BUNDLE_PATH = "{{BUNDLE_PATH}}"

-- GitHub's file server caches a branch's files for a few minutes after a
-- push, so ask the API for the branch's newest commit and download the
-- bundle from that exact commit (those URLs never go stale).
local function newestCommit(): string?
	local ok, sha = pcall(function()
		return HttpService:GetAsync(
			"https://api.github.com/repos/" .. REPO .. "/commits/" .. BRANCH,
			true,
			{ Accept = "application/vnd.github.sha" }
		)
	end)
	local clean = if ok and typeof(sha) == "string" then string.match(sha, "^%s*(%x+)%s*$") else nil
	if clean and #clean == 40 then
		return clean
	end
	warn("[Block Horde] couldn't ask GitHub for the newest version, using its cached copy: " .. tostring(sha))
	return nil
end

local function container(path: string): Instance
	local names = string.split(path, "/")
	local instance: Instance = game:GetService(names[1] :: any)
	for i = 2, #names do
		local child = instance:FindFirstChild(names[i])
		if not child then
			child = Instance.new(names[i] :: any)
			child.Name = names[i]
			child.Parent = instance
		end
		instance = child :: Instance
	end
	return instance
end

local function convert(kind: string, value: any): any
	if kind == "Color3" then
		return Color3.new(value[1], value[2], value[3])
	elseif kind == "Enum" then
		return (Enum :: any)[value[1]][value[2]]
	end
	return value
end

-- Moves things that clash with the game into ServerStorage instead of deleting them.
local function setAside(instance: Instance, removed: { string })
	local storage = game:GetService("ServerStorage")
	local folder = storage:FindFirstChild("BlockHordeRemoved")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "BlockHordeRemoved"
		folder.Parent = storage
	end
	table.insert(removed, instance.Name)
	instance.Parent = folder
end

return function()
	print("[Block Horde] downloading...")
	local commit = newestCommit()
	local ref = commit or ("refs/heads/" .. BRANCH)
	local url = "https://raw.githubusercontent.com/" .. REPO .. "/" .. ref .. "/" .. BUNDLE_PATH
	local bundle = HttpService:JSONDecode(HttpService:GetAsync(url, true))

	local made: { [string]: Instance } = {}
	local count = 0
	for _, entry in bundle.scripts do
		local parent = made[entry.parent] or container(entry.parent)
		if entry.replaces then
			for _, old in parent:GetChildren() do
				if old.Name == entry.name then
					old:Destroy()
				end
			end
		end
		local instance: any = Instance.new(entry.class)
		instance.Name = entry.name
		if entry.source then
			instance.Source = entry.source
			count += 1
		end
		made[entry.parent .. "/" .. entry.name] = instance
		instance.Parent = parent
	end

	for _, setting in bundle.properties do
		local ok, err = pcall(function()
			local instance: any = game:GetService(setting.path[1])
			for i = 2, #setting.path do
				instance = instance:FindFirstChild(setting.path[i])
			end
			instance[setting.property] = convert(setting.kind, setting.value)
		end)
		if not ok and not setting.optional then
			warn("[Block Horde] couldn't set " .. setting.property .. ": " .. tostring(err))
		end
	end

	-- The Baseplate template's floor, spawn pad, haze and blur would sit on top of the game.
	local removed: { string } = {}
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") or (child.Name == "Baseplate" and child:IsA("BasePart")) then
			setAside(child, removed)
		end
	end
	for _, child in game:GetService("Lighting"):GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("DepthOfFieldEffect") then
			setAside(child, removed)
		end
	end
	if #removed > 0 then
		print("[Block Horde] moved to ServerStorage.BlockHordeRemoved: " .. table.concat(removed, ", "))
	end

	pcall(function()
		game:GetService("ChangeHistoryService"):SetWaypoint("Install Block Horde")
	end)
	print(
		("[Block Horde] installed build %s%s (%d scripts). Press Play to test."):format(
			bundle.build,
			if commit then ", commit " .. string.sub(commit, 1, 7) else "",
			count
		)
	)
end
