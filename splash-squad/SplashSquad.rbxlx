        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Accessories</string>
            <string name="Source"><![CDATA[--!strict
-- Extras a kid can wear: a towel cape, swim goggles, a life ring and a chest emblem.
-- (The superhero eye mask is drawn on the face, see Face.luau.)

local Shapes = require(script.Parent.Shapes)
local HeadShape = require(script.Parent.HeadShape)
local Types = require(script.Parent.Types)
local Palette = require(script.Parent.Parent.Data.Palette)
local Outfits = require(script.Parent.Parent.Data.Outfits)

type Context = Types.Context

local Accessories = {}

-- Width of the body (a bean shape) at a height, as half-widths in X and Z.
-- `fraction` is 0 at the bottom of the body and 1 at the top.
function Accessories.bodyHalfWidths(dims: Types.Dims, fraction: number): (number, number)
	local t = (fraction - 0.5) / 0.5
	local k = math.sqrt(math.max(0, 1 - t * t))
	return dims.body.X / 2 * k, dims.body.Z / 2 * k
end

-- A thin ring hugging the body at a height (belts, stripes, waistbands).
function Accessories.band(ctx: Context, name: string, fraction: number, thickness: number, color: Color3)
	local d = ctx.dims
	local hx, hz = Accessories.bodyHalfWidths(d, fraction)
	local part = Shapes.ellipsoid(name, Vector3.new(hx * 2.07, thickness, hz * 2.07), color, ctx.model)
	ctx.addToBone(part, "Body", CFrame.new(0, d.body.Y * fraction, 0))
end

function Accessories.cape(ctx: Context, piece: Outfits.Piece)
	local d, s = ctx.dims, ctx.scale
	local color = Palette.resolve(piece.color, Palette.Cloth.Red)
	local knot = Palette.resolve(piece.accent, Palette.Cloth.Sunny)
	local length = d.shoulderY + 0.12 * s - d.leg.Y * 0.45
	local cape = Shapes.ellipsoid("Cape", Vector3.new(d.body.X * 1.5, length, 0.2 * s), color, ctx.model)
	cape.CastShadow = false
	-- The Cape bone sits behind the shoulders; tilt the cape so it flares out at the bottom.
	ctx.addToBone(cape, "Cape", CFrame.Angles(math.rad(-8), 0, 0) * CFrame.new(0, -length / 2 + 0.12 * s, 0.08 * s))
	-- Straps over the shoulders and a knot at the neck.
	for side = -1, 1, 2 do
		local strap = Shapes.ellipsoid("CapeStrap", Vector3.new(0.26 * s, 0.2 * s, d.body.Z * 0.9), color, ctx.model)
		ctx.addInRootSpace(strap, "Body", CFrame.new(side * d.body.X * 0.27, d.bodyTopY - 0.24 * s, 0))
		local tie = Shapes.ball("CapeKnot", 0.28 * s, knot, ctx.model)
		ctx.addInRootSpace(tie, "Body", CFrame.new(side * d.body.X * 0.12, d.bodyTopY - 0.24 * s, -d.body.Z * 0.4))
	end
end

function Accessories.goggles(ctx: Context, piece: Outfits.Piece)
	local s, r = ctx.scale, ctx.headRadii
	local lens = Palette.resolve(piece.color, Palette.Cloth.Glass)
	local strap = Palette.resolve(piece.accent, Palette.Cloth.Aqua)
	local lift = math.max(ctx.hairPuff, 1) + 0.04
	-- Pushed up on the forehead, just above the eyebrows.
	local centers = {}
	for side = -1, 1, 2 do
		local direction = Shapes.direction(36, side * 23)
		local point = HeadShape.surface(r, direction, lift)
		local normal = (HeadShape.normal(r, point) + Vector3.new(0, -0.15, -0.35)).Unit
		local frame = Shapes.facing(point, normal)
		ctx.addToHead(Shapes.ellipsoid("GoggleRim", Vector3.new(0.72, 0.66, 0.14) * s, strap, ctx.model), frame)
		local glass = Shapes.ellipsoid("GoggleLens", Vector3.new(0.56, 0.5, 0.14) * s, lens, ctx.model)
		glass.Reflectance = 0.15
		ctx.addToHead(glass, frame * CFrame.new(0, 0, -0.04 * s))
		ctx.addToHead(Shapes.ball("GoggleShine", 0.13 * s, Palette.Cloth.White, ctx.model), frame * CFrame.new(-0.12 * s, 0.1 * s, -0.09 * s))
		table.insert(centers, point)
	end
	ctx.addToHead(
		Shapes.ellipsoid("GoggleBridge", Vector3.new((centers[2] - centers[1]).Magnitude * 0.5, 0.1 * s, 0.1 * s), strap, ctx.model),
		CFrame.new((centers[1] + centers[2]) / 2)
	)
	-- The strap goes around the head (over the hair) at the same height.
	local y = centers[1].Y
	local cap = ctx.cap
	local rx, rz, cz
	if cap then
		local capRadii = cap.size / 2
		local t = math.clamp((y - cap.center.Y) / capRadii.Y, -0.95, 0.95)
		local k = math.sqrt(1 - t * t) * 1.02
		rx, rz, cz = capRadii.X * k, capRadii.Z * k, cap.center.Z
	else
		local t = math.clamp(y / r.Y, -0.95, 0.95)
		local k = math.sqrt(1 - t * t) * 1.03
		rx, rz, cz = r.X * k, r.Z * k, 0
	end
	ctx.addToHead(Shapes.ellipsoid("GoggleStrap", Vector3.new(rx * 2, 0.16 * s, rz * 2), strap, ctx.model), CFrame.new(0, y, cz))
end

function Accessories.lifeRing(ctx: Context, piece: Outfits.Piece)
	local d, s = ctx.dims, ctx.scale
	local color = Palette.resolve(piece.color, Palette.Cloth.Red)
	local stripe = Palette.resolve(piece.accent, Palette.Cloth.White)
	local fraction = 0.34
	local hx, hz = Accessories.bodyHalfWidths(d, fraction)
	local tube = 0.46 * s
	local rx, rz = hx + tube * 0.3, hz + tube * 0.3
	local count = 16
	for i = 0, count - 1 do
		local a = i / count * 2 * math.pi
		local position = Vector3.new(rx * math.cos(a), d.body.Y * fraction, rz * math.sin(a))
		local tangent = Vector3.new(-rx * math.sin(a), 0, rz * math.cos(a))
		local part = Shapes.ellipsoid("LifeRing", Vector3.new(tube, tube, tube * 1.3), if (i // 2) % 2 == 0 then color else stripe, ctx.model)
		ctx.addToBone(part, "Body", Shapes.facing(position, tangent))
	end
end

-- A felt badge on the chest with a letter on it.
function Accessories.emblem(ctx: Context, emblem: { letter: string, color: Outfits.ColorRef?, ink: Outfits.ColorRef? })
	local d, s = ctx.dims, ctx.scale
	local fraction = 0.6
	local _, hz = Accessories.bodyHalfWidths(d, fraction)
	local badge = Shapes.carrier("Emblem", Vector3.new(0.72, 0.72, 0.05) * s, ctx.model)
	ctx.addToBone(badge, "Body", CFrame.new(0, d.body.Y * fraction, -hz - 0.03 * s), true)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "EmblemGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(100, 100)
	gui.LightInfluence = 0.6
	gui.Adornee = badge
	gui.Parent = badge

	local disc = Instance.new("Frame")
	disc.Name = "Disc"
	disc.Size = UDim2.fromScale(1, 1)
	disc.BackgroundColor3 = Palette.resolve(emblem.color, Palette.Cloth.Sunny)
	disc.BorderSizePixel = 0
	disc.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = disc

	local label = Instance.new("TextLabel")
	label.Name = "Letter"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = emblem.letter
	label.TextScaled = true
	label.TextColor3 = Palette.resolve(emblem.ink, Palette.Cloth.Red)
	label.Parent = disc
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.14, 0)
	padding.PaddingBottom = UDim.new(0.14, 0)
	padding.Parent = label
end

return Accessories
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">CharacterBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a chibi cartoon kid from parts: a big round head with a drawn face,
-- a bean body, stubby arms and legs, mitten hands and round shoes, then
-- dresses them from an outfit (see Data/Outfits.luau).
--
-- Usage:
--   local kid = CharacterBuilder.build(outfit, CFrame.new(0, 1, 0), { name = "Pip" })
--   kid.Face:SetExpression("Win")

local Config = require(script.Parent.Parent.Config)
local Palette = require(script.Parent.Parent.Data.Palette)
local Outfits = require(script.Parent.Parent.Data.Outfits)
local Shapes = require(script.Parent.Shapes)
local KidRig = require(script.Parent.KidRig)
local Face = require(script.Parent.Face)
local Hair = require(script.Parent.Hair)
local Hats = require(script.Parent.Hats)
local Accessories = require(script.Parent.Accessories)
local Outline = require(script.Parent.Outline)
local Types = require(script.Parent.Types)

export type Dims = Types.Dims

export type Kid = {
	Model: Model,
	Root: BasePart,
	Head: BasePart,
	Rig: KidRig.Rig,
	Face: Face.Face,
	Dims: Dims,
	Outfit: Outfits.Outfit,
	Highlight: Highlight?,
}

export type BuildOptions = {
	name: string?,
	parent: Instance?, -- default: Workspace
	outline: boolean?, -- default: true
}

local CharacterBuilder = {}

function CharacterBuilder.measure(outfit: Outfits.Outfit): Dims
	local K = Config.Kid
	local proportions: { scale: number?, bodyStretch: number?, headScale: number? } = outfit.proportions or {}
	local s = proportions.scale or 1
	local stretch = proportions.bodyStretch or 1
	local headScale = proportions.headScale or 1
	local tall = Vector3.new(1, stretch, 1)

	local head = K.HeadSize * s * headScale
	local body = K.BodySize * s * tall
	local leg = K.LegSize * s * tall
	local arm = K.ArmSize * s * Vector3.new(1, stretch ^ 0.6, 1)
	local shoe = K.ShoeSize * s

	local legTopY = shoe.Y * 0.55 + leg.Y
	local bodyBottomY = legTopY - leg.Y * 0.3
	local bodyTopY = bodyBottomY + body.Y
	local neckY = bodyTopY - K.HeadSink * s * headScale
	local headCenterY = neckY + head.Y / 2
	local shoulderY = bodyTopY - K.ShoulderDrop * s * math.sqrt(stretch)
	local fromCenter = (shoulderY - (bodyBottomY + body.Y / 2)) / (body.Y / 2)
	local shoulderX = body.X / 2 * math.sqrt(math.max(0, 1 - fromCenter * fromCenter)) * 0.9

	return {
		scale = s,
		head = head,
		body = body,
		leg = leg,
		arm = arm,
		hand = K.HandSize * s,
		shoe = shoe,
		feet = K.FeetSize * s,
		legSpread = K.LegSpread * s,
		legTopY = legTopY,
		bodyBottomY = bodyBottomY,
		bodyTopY = bodyTopY,
		neckY = neckY,
		headCenterY = headCenterY,
		height = headCenterY + head.Y / 2,
		shoulderY = shoulderY,
		shoulderX = shoulderX,
	}
end

function CharacterBuilder.build(outfit: Outfits.Outfit, cframe: CFrame, options: BuildOptions?): Kid
	local opts: BuildOptions = options or {}
	local d = CharacterBuilder.measure(outfit)
	local s = d.scale

	local model = Instance.new("Model")
	model.Name = opts.name or "Kid"
	local root = Shapes.carrier("Root", Vector3.new(0.4, 0.4, 0.4) * s, model)
	model.PrimaryPart = root

	-- Skeleton. The root sits on the ground between the feet; the kid faces -Z.
	local rig = KidRig.new(root)
	local restAngle = math.rad(Config.Kid.ArmRestAngle)
	KidRig.addBone(rig, "Body", "Root", CFrame.new(0, d.bodyBottomY, 0))
	KidRig.addBone(rig, "Head", "Body", CFrame.new(0, d.neckY - d.bodyBottomY, 0))
	KidRig.addBone(rig, "ArmR", "Body", CFrame.new(d.shoulderX, d.shoulderY - d.bodyBottomY, 0) * CFrame.Angles(0, 0, restAngle))
	KidRig.addBone(rig, "ArmL", "Body", CFrame.new(-d.shoulderX, d.shoulderY - d.bodyBottomY, 0) * CFrame.Angles(0, 0, -restAngle))
	KidRig.addBone(rig, "LegR", "Root", CFrame.new(d.legSpread, d.legTopY, 0))
	KidRig.addBone(rig, "LegL", "Root", CFrame.new(-d.legSpread, d.legTopY, 0))
	KidRig.addBone(rig, "Cape", "Body", CFrame.new(0, d.shoulderY - d.bodyBottomY + 0.12 * s, d.body.Z * 0.32))

	local headCenter = CFrame.new(0, d.head.Y / 2, 0) -- head center in Head-bone space
	local ctx: Types.Context = {
		model = model,
		dims = d,
		scale = s,
		skin = Palette.resolve(outfit.skin, Palette.Skin.Peach),
		headRadii = d.head / 2,
		cap = nil,
		hairTop = d.head.Y / 2,
		hairPuff = 1,
		addToHead = function(part, headSpace)
			KidRig.attach(rig, part, "Head", headCenter * headSpace)
		end,
		addToBone = function(part, bone, boneSpace, squashBySize)
			KidRig.attach(rig, part, bone, boneSpace, squashBySize)
		end,
		addInRootSpace = function(part, bone, rootSpace)
			KidRig.attachInRootSpace(rig, part, bone, rootSpace)
		end,
	}

	-- Colors
	local skin = ctx.skin
	local topStyle = outfit.top.style
	local topColor = if topStyle == "None" then skin else Palette.resolve(outfit.top.color, Palette.Cloth.White)
	local topAccent = Palette.resolve(
		outfit.top.accent or (Outfits.find(Outfits.Tops, topStyle) or {} :: any).accent,
		Palette.Cloth.Red
	)
	local bottomStyle = outfit.bottom.style
	local bottomColor = Palette.resolve(outfit.bottom.color, Palette.Cloth.Navy)
	local armColor = if topStyle == "Suit" then topColor else skin
	local legColor = if bottomStyle == "Pants"
		then bottomColor
		elseif topStyle == "Suit" then topColor
		else skin

	-- Body and head
	local body = Shapes.ellipsoid("Body", d.body, topColor, model)
	ctx.addToBone(body, "Body", CFrame.new(0, d.body.Y / 2, 0))

	local head = Shapes.ellipsoid("Head", d.head, skin, model)
	ctx.addToBone(head, "Head", headCenter, true)
	local face = Face.new(head, {
		skin = skin,
		mask = if outfit.mask then Palette.resolve(outfit.mask) else nil,
	})

	-- Arms with mitten hands (and sleeves for t-shirts).
	for _, bone in { "ArmR", "ArmL" } do
		local inset = d.arm.X * 0.3
		local arm = Shapes.ellipsoid(bone, d.arm, armColor, model)
		ctx.addToBone(arm, bone, CFrame.new(0, -(d.arm.Y / 2 - inset), 0))
		local hand = Shapes.ellipsoid("Hand", d.hand, skin, model)
		ctx.addToBone(hand, bone, CFrame.new(0, -(d.arm.Y - inset) + d.hand.Y * 0.18, 0))
		if topStyle == "Tee" or topStyle == "Stripes" then
			local sleeve = Shapes.ellipsoid("Sleeve", d.arm * Vector3.new(1.32, 0.52, 1.32), topColor, model)
			ctx.addToBone(sleeve, bone, CFrame.new(0, -d.arm.Y * 0.16, 0))
		end
	end

	-- Legs and shoes
	local shoes = outfit.shoes
	local shoeColor = Palette.resolve(shoes.color, Palette.Cloth.Red)
	local shoeAccent = Palette.resolve(shoes.accent, Palette.Cloth.White)
	for _, bone in { "LegR", "LegL" } do
		local leg = Shapes.ellipsoid(bone, d.leg, legColor, model)
		ctx.addToBone(leg, bone, CFrame.new(0, -d.leg.Y / 2, 0))
		if bottomStyle == "Shorts" then
			local cuff = Shapes.ellipsoid("ShortsLeg", d.leg * Vector3.new(1.3, 0.55, 1.3), bottomColor, model)
			ctx.addToBone(cuff, bone, CFrame.new(0, -d.leg.Y * 0.22, 0))
		end

		if shoes.style == "Bare" then
			local foot = Shapes.ellipsoid("Foot", d.feet, skin, model)
			ctx.addToBone(foot, bone, CFrame.new(0, d.feet.Y / 2 - d.legTopY, -d.feet.Z * 0.14))
		else
			local shoe = Shapes.ellipsoid("Shoe", d.shoe, shoeColor, model)
			ctx.addToBone(shoe, bone, CFrame.new(0, d.shoe.Y / 2 - d.legTopY, -d.shoe.Z * 0.14))
			if shoes.style == "Sneakers" then
				local sole = Shapes.ellipsoid("Sole", d.shoe * Vector3.new(1.06, 0.42, 1.04), shoeAccent, model)
				ctx.addToBone(sole, bone, CFrame.new(0, d.shoe.Y * 0.2 - d.legTopY, -d.shoe.Z * 0.14))
			elseif shoes.style == "Boots" then
				local shaft = Shapes.ellipsoid("BootShaft", d.leg * Vector3.new(1.32, 0.72, 1.32), shoeColor, model)
				ctx.addToBone(shaft, bone, CFrame.new(0, -d.leg.Y * 0.68, 0))
				local cuff = Shapes.ellipsoid("BootCuff", d.leg * Vector3.new(1.34, 0.16, 1.34), shoeColor:Lerp(Palette.Cloth.White, 0.3), model)
				ctx.addToBone(cuff, bone, CFrame.new(0, -d.leg.Y * 0.36, 0))
			end
		end
	end

	-- Bottoms: a rounded overlay on the lower part of the bean.
	local trunks = Shapes.ellipsoid("Bottoms", d.body * Vector3.new(1.07, 0.56, 1.07), bottomColor, model)
	ctx.addToBone(trunks, "Body", CFrame.new(0, d.body.Y * 0.24, 0))
	local bottomAccent = outfit.bottom.accent or (Outfits.find(Outfits.Bottoms, bottomStyle) or {} :: any).accent
	if bottomAccent then
		Accessories.band(ctx, "Waistband", 0.37, d.body.Y * 0.07, Palette.resolve(bottomAccent))
	end

	-- Tops
	if topStyle == "Stripes" then
		Accessories.band(ctx, "Stripe", 0.52, d.body.Y * 0.085, topAccent)
		Accessories.band(ctx, "Stripe", 0.7, d.body.Y * 0.085, topAccent)
	elseif topStyle == "Suit" then
		Accessories.band(ctx, "Belt", 0.43, d.body.Y * 0.1, topAccent)
	end

	-- Hair, hat and extras
	Hair.build(ctx, outfit.hair, Hats.coversTop(outfit.hat))
	Hats.build(ctx, outfit.hat)
	if outfit.cape then
		Accessories.cape(ctx, outfit.cape)
	end
	if outfit.goggles then
		Accessories.goggles(ctx, outfit.goggles)
	end
	if outfit.lifeRing then
		Accessories.lifeRing(ctx, outfit.lifeRing)
	end
	if outfit.emblem then
		Accessories.emblem(ctx, outfit.emblem)
	end

	local kid: Kid = {
		Model = model,
		Root = root,
		Head = head,
		Rig = rig,
		Face = face,
		Dims = d,
		Outfit = outfit,
		Highlight = nil,
	}

	KidRig.apply(rig, { root = cframe })
	model.Parent = opts.parent or workspace
	if opts.outline ~= false then
		kid.Highlight = Outline.add(model)
	end
	return kid
end

function CharacterBuilder.destroy(kid: Kid)
	kid.Model:Destroy()
end

return CharacterBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Face</string>
            <string name="Source"><![CDATA[--!strict
-- Draws a kid's face with a SurfaceGui on the front of the head: eyes with
-- shine dots, eyebrows, blush and a mouth, all made of rounded Frames.
-- Every expression's pieces are built once and switched on and off, so
-- changing expression is instant.
--
-- Curved lines (smiles, closed eyes, dizzy spirals) are chains of short
-- rounded bars. Layout numbers live in Config.Face.

local Config = require(script.Parent.Parent.Config)
local Palette = require(script.Parent.Parent.Data.Palette)

export type Expression = {
	eyes: string,
	brows: string,
	mouth: string,
	blush: number, -- blush transparency (0 = strong, 1 = none)
}

local Face = {}
Face.__index = Face

Face.Expressions = {
	Idle = { eyes = "Open", brows = "Normal", mouth = "Smile", blush = 0.4 },
	Aiming = { eyes = "Smug", brows = "Smug", mouth = "Smirk", blush = 0.5 },
	Fire = { eyes = "Open", brows = "Determined", mouth = "Grin", blush = 0.4 },
	Hit = { eyes = "Squeezed", brows = "Worried", mouth = "O", blush = 0.25 },
	Flying = { eyes = "Spiral", brows = "Raised", mouth = "BigOpen", blush = 0.35 },
	Wet = { eyes = "Droopy", brows = "Worried", mouth = "Frown", blush = 0.55 },
	Win = { eyes = "Happy", brows = "Raised", mouth = "BigSmile", blush = 0.15 },
} :: { [string]: Expression }

Face.ExpressionOrder = { "Idle", "Aiming", "Fire", "Hit", "Flying", "Wet", "Win" }

type Spiral = { frame: Frame, direction: number }

type FaceData = {
	Gui: SurfaceGui,
	Groups: { [string]: { [string]: Frame } },
	Blush: { Frame },
	Spirals: { Spiral },
	Expression: string,
	EyesShown: string,
	BlinkToken: number,
}

export type Face = typeof(setmetatable({} :: FaceData, Face))

export type FaceOptions = {
	skin: Color3?, -- dark skin gets a soft light rim around the lines so they stay readable
	mask: Color3?, -- superhero eye mask
}

------------------------------------------------------------------------
-- Drawing helpers. All positions are in canvas pixels.

type FrameOptions = {
	transparency: number?,
	rounded: boolean?,
	rotation: number?,
	z: number?,
	name: string?,
	halo: boolean?, -- draw a light rim behind this shape (dark skin only)
}

-- Light rim color for the face being built (nil = no rims).
local halo: Color3? = nil
local HALO_WIDTH = 5

local function shape(parent: GuiObject, center: Vector2, size: Vector2, color: Color3, options: FrameOptions?): Frame
	local opts: FrameOptions = options or {}
	if opts.halo and halo then
		shape(parent, center, size + Vector2.new(HALO_WIDTH, HALO_WIDTH), halo, {
			rotation = opts.rotation,
			z = (opts.z or 1) - 1,
			name = "Rim",
		})
	end
	local frame = Instance.new("Frame")
	frame.Name = opts.name or "Shape"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromOffset(center.X, center.Y)
	frame.Size = UDim2.fromOffset(size.X, size.Y)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = opts.transparency or 0
	frame.BorderSizePixel = 0
	frame.Rotation = opts.rotation or 0
	frame.ZIndex = opts.z or 1
	if opts.rounded ~= false then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	frame.Parent = parent
	return frame
end

local function layer(parent: Instance, name: string, z: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.ZIndex = z
	frame.Parent = parent
	return frame
end

-- A rounded bar from a to b; overlapping bars make smooth curves.
local function bar(parent: GuiObject, a: Vector2, b: Vector2, thickness: number, color: Color3)
	local delta = b - a
	shape(parent, (a + b) / 2, Vector2.new(delta.Magnitude + thickness, thickness), color, {
		rotation = math.deg(math.atan2(delta.Y, delta.X)),
		name = "Line",
		z = 2,
		halo = true,
	})
end

local function polyline(parent: GuiObject, points: { Vector2 }, thickness: number, color: Color3)
	for i = 1, #points - 1 do
		bar(parent, points[i], points[i + 1], thickness, color)
	end
end

-- Points on an elliptical arc. Angles in degrees, 0 = right, 90 = up.
local function arc(center: Vector2, rx: number, ry: number, from: number, to: number, segments: number): { Vector2 }
	local points = {}
	for i = 0, segments do
		local a = math.rad(from + (to - from) * i / segments)
		table.insert(points, center + Vector2.new(rx * math.cos(a), -ry * math.sin(a)))
	end
	return points
end

-- Open mouth: the bottom half of a dark oval, with an optional tongue and teeth.
local function halfOval(parent: GuiObject, center: Vector2, width: number, depth: number, tongue: boolean, teeth: boolean)
	local clip = Instance.new("Frame")
	clip.Name = "Clip"
	clip.Position = UDim2.fromOffset(center.X - width / 2, center.Y - depth * 0.5)
	clip.Size = UDim2.fromOffset(width, depth)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = parent
	shape(clip, Vector2.new(width / 2, 0), Vector2.new(width, depth * 2), Palette.Face.MouthInside, {
		name = "Inside",
		z = 2,
		halo = true,
	})
	if tongue then
		shape(clip, Vector2.new(width / 2, depth * 0.7), Vector2.new(width * 0.5, depth * 0.44), Palette.Face.Tongue, {
			name = "Tongue",
			z = 3,
		})
	end
	if teeth then
		shape(clip, Vector2.new(width / 2, depth * 0.1), Vector2.new(width * 0.8, depth * 0.22), Palette.Face.Teeth, {
			name = "Teeth",
			z = 3,
		})
	end
end

------------------------------------------------------------------------

function Face.new(head: BasePart, options: FaceOptions?): Face
	local opts: FaceOptions = options or {}
	local F = Config.Face
	local cw = Config.Kid.HeadSize.X * F.PixelsPerStud
	local ch = Config.Kid.HeadSize.Y * F.PixelsPerStud

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Face"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(cw, ch)
	gui.LightInfluence = F.LightInfluence
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Adornee = head
	gui.Parent = head

	local self: Face = setmetatable({
		Gui = gui,
		Groups = { Eyes = {}, Brows = {}, Mouth = {} },
		Blush = {},
		Spirals = {},
		Expression = "Idle",
		EyesShown = "Open",
		BlinkToken = 0,
	} :: FaceData, Face)

	-- Dark skin: rim the lines in a lighter shade of the skin so they still read.
	halo = nil
	if opts.skin then
		local brightness = 0.299 * opts.skin.R + 0.587 * opts.skin.G + 0.114 * opts.skin.B
		local amount = math.clamp((0.55 - brightness) * 1.6, 0, 0.45)
		if amount > 0.02 then
			halo = opts.skin:Lerp(Color3.new(1, 1, 1), amount)
		end
	end

	local line = cw * F.LineThickness
	local ew, eh = cw * F.EyeWidth, ch * F.EyeHeight
	local ey = ch * F.EyeY
	local eyeColor = Palette.Face.Eye
	local shine = Palette.Face.Shine

	-- Blush
	local blushLayer = layer(gui, "Blush", 1)
	for side = -1, 1, 2 do
		local blush = shape(
			blushLayer,
			Vector2.new(cw * (0.5 + side * F.BlushSpacing / 2), ch * F.BlushY),
			Vector2.new(cw * F.BlushWidth, ch * F.BlushHeight),
			Palette.Face.Blush,
			{ transparency = 0.4, name = "Blush" }
		)
		table.insert(self.Blush, blush)
	end

	-- Superhero mask: a band behind the eyes with white eye holes.
	if opts.mask then
		local maskLayer = layer(gui, "Mask", 2)
		shape(
			maskLayer,
			Vector2.new(cw * 0.5, ey - eh * 0.02),
			Vector2.new(cw * (F.EyeSpacing + F.EyeWidth * 2.3), eh * 1.12),
			opts.mask,
			{ name = "Band" }
		)
		for side = -1, 1, 2 do
			shape(
				maskLayer,
				Vector2.new(cw * (0.5 + side * F.EyeSpacing / 2), ey),
				Vector2.new(ew * 1.6, eh * 1.18),
				shine,
				{ name = "Hole", z = 2 }
			)
		end
	end

	-- Eyes: one group per look. `side` is -1 for the eye on the viewer's left.
	local function eyeGroup(name: string, draw: (group: Frame, ex: number, side: number, inward: number) -> ())
		local group = layer(gui, "Eyes" .. name, 3)
		for side = -1, 1, 2 do
			draw(group, cw * (0.5 + side * F.EyeSpacing / 2), side, -side)
		end
		self.Groups.Eyes[name] = group
	end

	eyeGroup("Open", function(group, ex)
		shape(group, Vector2.new(ex, ey), Vector2.new(ew, eh), eyeColor, { name = "Eye", z = 2, halo = true })
		local d = ew * F.ShineSize
		shape(group, Vector2.new(ex - ew * 0.17, ey - eh * 0.2), Vector2.new(d, d), shine, { z = 3, name = "Shine" })
		shape(group, Vector2.new(ex + ew * 0.2, ey + eh * 0.22), Vector2.new(d * 0.42, d * 0.42), shine, {
			z = 3,
			name = "Shine",
		})
	end)

	eyeGroup("Closed", function(group, ex)
		polyline(group, arc(Vector2.new(ex, ey - eh * 0.05), ew * 0.6, eh * 0.18, 200, 340, 5), line, eyeColor)
	end)

	eyeGroup("Smug", function(group, ex, _side, inward)
		local cy = ey + eh * 0.18
		shape(group, Vector2.new(ex, cy), Vector2.new(ew, eh * 0.58), eyeColor, { name = "Eye", z = 2, halo = true })
		local lidY = cy - eh * 0.29 + 1
		bar(
			group,
			Vector2.new(ex - inward * ew * 0.66, lidY - 2),
			Vector2.new(ex + inward * ew * 0.62, lidY + 3),
			line * 1.1,
			eyeColor
		)
		local d = ew * 0.32
		shape(group, Vector2.new(ex - ew * 0.15, cy - eh * 0.04), Vector2.new(d, d), shine, { z = 3, name = "Shine" })
	end)

	eyeGroup("Squeezed", function(group, ex, _side, inward)
		polyline(group, {
			Vector2.new(ex - inward * ew * 0.55, ey - eh * 0.3),
			Vector2.new(ex + inward * ew * 0.5, ey + 1),
			Vector2.new(ex - inward * ew * 0.55, ey + eh * 0.3),
		}, line * 1.15, eyeColor)
	end)

	eyeGroup("Spiral", function(group, ex, side)
		local size = ew * 1.5
		local spin = Instance.new("Frame")
		spin.Name = "Spin"
		spin.AnchorPoint = Vector2.new(0.5, 0.5)
		spin.Position = UDim2.fromOffset(ex, ey)
		spin.Size = UDim2.fromOffset(size, size)
		spin.BackgroundTransparency = 1
		spin.Parent = group
		local points = {}
		local turns, maxR = 2.25, ew * 0.62
		local total = turns * 2 * math.pi
		local a = 0
		while a <= total do
			local r = 1 + (maxR - 1) * a / total
			table.insert(points, Vector2.new(size / 2 + r * math.cos(a * side), size / 2 - r * math.sin(a * side)))
			a += 0.42
		end
		polyline(spin, points, line * 0.9, eyeColor)
		table.insert(self.Spirals, { frame = spin, direction = side })
	end)

	eyeGroup("Droopy", function(group, ex, side, inward)
		local cy = ey + eh * 0.15
		shape(group, Vector2.new(ex, cy), Vector2.new(ew * 0.95, eh * 0.62), eyeColor, { name = "Eye", z = 2, halo = true })
		local lidY = cy - eh * 0.31
		bar(
			group,
			Vector2.new(ex - inward * ew * 0.66, lidY + 7),
			Vector2.new(ex + inward * ew * 0.6, lidY - 2),
			line * 1.1,
			eyeColor
		)
		local d = ew * 0.42
		shape(group, Vector2.new(ex - ew * 0.12, cy - eh * 0.02), Vector2.new(d, d), shine, { z = 3, name = "Shine" })
		shape(group, Vector2.new(ex + ew * 0.18, cy + eh * 0.14), Vector2.new(d * 0.45, d * 0.45), shine, {
			z = 3,
			name = "Shine",
		})
		if side == 1 then
			shape(group, Vector2.new(ex + ew * 0.55, ey + eh * 0.55), Vector2.new(ew * 0.3, ew * 0.48), Palette.Face.Tear, {
				name = "Tear",
			})
		end
	end)

	eyeGroup("Happy", function(group, ex)
		polyline(group, arc(Vector2.new(ex, ey + eh * 0.15), ew * 0.62, eh * 0.4, 15, 165, 6), line * 1.15, eyeColor)
	end)

	-- Eyebrows: { drop in pixels, tilt in degrees (clockwise), arch } for the left and right brow.
	local browSets: { [string]: { { number } } } = {
		Normal = { { 0, -7, 3 }, { 0, 7, 3 } },
		Smug = { { 6, 14, 1 }, { -7, 5, 5 } },
		Determined = { { 4, 18, 1 }, { 4, -18, 1 } },
		Worried = { { -4, -16, 2 }, { -4, 16, 2 } },
		Raised = { { -11, -8, 5 }, { -11, 8, 5 } },
	}
	local browLength = cw * F.BrowLength
	local browColor = Palette.Face.Brow
	for name, sides in browSets do
		local group = layer(gui, "Brows" .. name, 4)
		for i, side in { -1, 1 } do
			local spec = sides[i]
			local center = Vector2.new(cw * (0.5 + side * F.EyeSpacing / 2), ch * F.BrowY + spec[1])
			local tilt = math.rad(spec[2])
			local cos, sin = math.cos(tilt), math.sin(tilt)
			local points = {}
			for _, p in { Vector2.new(-browLength / 2, 0), Vector2.new(0, -spec[3]), Vector2.new(browLength / 2, 0) } do
				table.insert(points, center + Vector2.new(p.X * cos - p.Y * sin, p.X * sin + p.Y * cos))
			end
			polyline(group, points, line * 0.95, browColor)
		end
		self.Groups.Brows[name] = group
	end

	-- Mouths
	local mx, my = cw * 0.5, ch * F.MouthY
	local mw = cw * F.MouthWidth
	local mouthLine = Palette.Face.MouthLine
	local function mouthGroup(name: string, draw: (group: Frame) -> ())
		local group = layer(gui, "Mouth" .. name, 5)
		draw(group)
		self.Groups.Mouth[name] = group
	end

	mouthGroup("Smile", function(group)
		polyline(group, arc(Vector2.new(mx, my - mw * 0.3), mw * 0.5, mw * 0.42, 200, 340, 7), line, mouthLine)
	end)
	mouthGroup("Smirk", function(group)
		polyline(group, arc(Vector2.new(mx + mw * 0.1, my - mw * 0.28), mw * 0.46, mw * 0.36, 225, 378, 8), line, mouthLine)
	end)
	mouthGroup("Grin", function(group)
		halfOval(group, Vector2.new(mx, my), mw * 1.3, mw * 1.3 * 0.58, true, true)
	end)
	mouthGroup("O", function(group)
		shape(group, Vector2.new(mx, my + 2), Vector2.new(mw * 0.48, mw * 0.58), Palette.Face.MouthInside, {
			name = "O",
			z = 2,
			halo = true,
		})
	end)
	mouthGroup("BigOpen", function(group)
		shape(group, Vector2.new(mx, my + 5), Vector2.new(mw * 0.82, mw * 1.0), Palette.Face.MouthInside, {
			name = "Open",
			z = 2,
			halo = true,
		})
		shape(group, Vector2.new(mx, my + 5 + mw * 0.27), Vector2.new(mw * 0.48, mw * 0.3), Palette.Face.Tongue, {
			name = "Tongue",
			z = 3,
		})
	end)
	mouthGroup("Frown", function(group)
		polyline(group, arc(Vector2.new(mx, my + mw * 0.35), mw * 0.42, mw * 0.32, 25, 155, 6), line, mouthLine)
	end)
	mouthGroup("BigSmile", function(group)
		halfOval(group, Vector2.new(mx, my - 2), mw * 1.55, mw * 1.55 * 0.62, true, false)
	end)

	halo = nil
	self:SetExpression("Idle")
	return self
end

function Face._show(self: Face, category: string, name: string)
	for groupName, group in self.Groups[category] do
		group.Visible = groupName == name
	end
	if category == "Eyes" then
		self.EyesShown = name
	end
end

function Face.SetExpression(self: Face, name: string)
	local expression = Face.Expressions[name]
	if not expression then
		warn(`[Face] Unknown expression "{name}"`)
		return
	end
	self.Expression = name
	self.BlinkToken += 1 -- cancel any blink in progress
	self:_show("Eyes", expression.eyes)
	self:_show("Brows", expression.brows)
	self:_show("Mouth", expression.mouth)
	for _, blush in self.Blush do
		blush.BackgroundTransparency = expression.blush
	end
end

-- Close the eyes for a moment (only when they are open).
function Face.Blink(self: Face)
	local expression = Face.Expressions[self.Expression]
	if not expression or (expression.eyes ~= "Open" and expression.eyes ~= "Smug") then
		return
	end
	self.BlinkToken += 1
	local token = self.BlinkToken
	self:_show("Eyes", "Closed")
	task.delay(Config.Face.BlinkTime, function()
		if self.BlinkToken == token and self.Gui.Parent then
			self:_show("Eyes", expression.eyes)
		end
	end)
end

-- Spins the dizzy eyes; call every frame.
function Face.Update(self: Face, dt: number)
	if self.EyesShown ~= "Spiral" then
		return
	end
	for _, spiral in self.Spirals do
		spiral.frame.Rotation = (spiral.frame.Rotation + spiral.direction * Config.Face.SpiralSpeed * dt) % 360
	end
end

return Face
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Hair</string>
            <string name="Source"><![CDATA[--!strict
-- Hair styles, built from parts. Each style starts with a "cap" (a bigger
-- copy of the head nudged up and back, see HeadShape.cap) and adds spikes,
-- curls or a ponytail on top. To add a style: write a builder below and list
-- it in Data/Outfits.luau.

local Shapes = require(script.Parent.Shapes)
local HeadShape = require(script.Parent.HeadShape)
local Types = require(script.Parent.Types)
local Palette = require(script.Parent.Parent.Data.Palette)
local Outfits = require(script.Parent.Parent.Data.Outfits)

type Context = Types.Context
type Builder = (ctx: Context, color: Color3, accent: Color3, underHat: boolean) -> ()

local Hair = {}

local function addCap(ctx: Context, color: Color3, front: number, back: number, puff: number): HeadShape.Cap
	local cap = HeadShape.cap(ctx.headRadii, front, back, puff)
	ctx.addToHead(Shapes.ellipsoid("HairCap", cap.size, color, ctx.model), CFrame.new(cap.center))
	ctx.cap = cap
	ctx.hairTop = cap.center.Y + cap.size.Y / 2
	ctx.hairPuff = puff
	return cap
end

-- A soft spike standing on the cap and leaning outward.
-- { elevation, azimuth, length, width, lean } with angles measured from the cap's center.
local function addSpike(ctx: Context, cap: HeadShape.Cap, color: Color3, spec: { number })
	local s = ctx.scale
	local direction = Shapes.direction(spec[1], spec[2])
	local length, width, lean = spec[3] * s, spec[4] * s, spec[5] or 0.35
	local base = HeadShape.onCap(cap, direction, 0.96)
	local out = (direction + Vector3.yAxis * lean).Unit
	local part = Shapes.ellipsoid("Spike", Vector3.new(width, length, width), color, ctx.model)
	ctx.addToHead(part, Shapes.alongY(base + out * length * 0.3, out))
end

-- Cheap repeatable "random" number between 0 and 1.
local function hash(i: number): number
	local x = math.sin(i * 12.9898) * 43758.5453
	return x - math.floor(x)
end

local builders: { [string]: Builder } = {}

builders.Spiky = function(ctx, color, _accent, underHat)
	local cap = addCap(ctx, color, 0.42, -0.42, 1.05)
	local spikes: { { number } } = if underHat
		then {
			{ 0, 75, 0.7, 0.42, 0.1 },
			{ 0, -75, 0.7, 0.42, 0.1 },
			{ 5, 125, 0.68, 0.42, 0.1 },
			{ 5, -125, 0.68, 0.42, 0.1 },
			{ 8, 180, 0.66, 0.42, 0.1 },
		}
		else {
			{ 86, 10, 0.95, 0.58 },
			{ 62, 35, 0.88, 0.56 },
			{ 64, -30, 0.88, 0.56 },
			{ 52, 90, 0.8, 0.54, 0.5 },
			{ 52, -90, 0.8, 0.54, 0.5 },
			{ 48, 145, 0.78, 0.54 },
			{ 48, -145, 0.78, 0.54 },
			{ 42, 180, 0.74, 0.54 },
			{ 18, 80, 0.62, 0.48, 0.45 },
			{ 18, -80, 0.62, 0.48, 0.45 },
		}
	for _, spec in spikes do
		addSpike(ctx, cap, color, spec)
	end
	if not underHat then
		ctx.hairTop += 0.62 * ctx.scale
	end
end

builders.BowlCut = function(ctx, color, _accent, underHat)
	local cap = addCap(ctx, color, 0.4, -0.5, 1.11)
	if underHat then
		return
	end
	-- A little sprout of hair sticking up on top.
	local s = ctx.scale
	local p0 = HeadShape.onCap(cap, Shapes.direction(80, 160), 0.97)
	local d1 = Vector3.new(0.2, 1, 0.3).Unit
	ctx.addToHead(Shapes.ellipsoid("Sprout", Vector3.new(0.2, 0.42, 0.2) * s, color, ctx.model), Shapes.alongY(p0 + d1 * 0.16 * s, d1))
	local p1 = p0 + d1 * 0.34 * s
	local d2 = Vector3.new(0.3, 0.2, -1).Unit
	ctx.addToHead(Shapes.ellipsoid("Sprout", Vector3.new(0.17, 0.34, 0.17) * s, color, ctx.model), Shapes.alongY(p1 + d2 * 0.12 * s, d2))
end

builders.Ponytail = function(ctx, color, accent, _underHat)
	local cap = addCap(ctx, color, 0.42, -0.35, 1.07)
	local s = ctx.scale
	-- A high ponytail: tied on top toward the back, it arcs up and out, then falls.
	local tie = HeadShape.onCap(cap, Shapes.direction(58, 150), 0.98)
	ctx.addToHead(Shapes.ellipsoid("HairTie", Vector3.new(0.5, 0.3, 0.5) * s, accent, ctx.model), Shapes.alongY(tie, Vector3.new(0.3, 1, 0.5)))
	local point = tie
	local pieces = {
		{ Vector3.new(0.35, 1, 0.55), Vector3.new(0.62, 0.7, 0.62) },
		{ Vector3.new(0.8, 0.1, 0.6), Vector3.new(0.6, 0.75, 0.6) },
		{ Vector3.new(0.6, -0.8, 0.4), Vector3.new(0.52, 0.8, 0.52) },
		{ Vector3.new(0.3, -1, 0.15), Vector3.new(0.38, 0.6, 0.38) },
	}
	for i, piece in pieces do
		local direction = piece[1].Unit
		local size = piece[2] * s
		local name = if i == #pieces then "TailTip" else "Tail"
		ctx.addToHead(Shapes.ellipsoid(name, size, color, ctx.model), Shapes.alongY(point + direction * size.Y * 0.4, direction))
		point += direction * size.Y * 0.62
	end
end

builders.Curly = function(ctx, color, _accent, underHat)
	local cap = addCap(ctx, color, 0.44, -0.45, 1.03)
	local s = ctx.scale
	-- Spread round puffs evenly over the covered part of the head.
	local count = 64
	local golden = math.pi * (3 - math.sqrt(5))
	local highest = 0
	for i = 0, count - 1 do
		local y = 1 - 2 * (i + 0.5) / count
		local r = math.sqrt(1 - y * y)
		local direction = Vector3.new(r * math.cos(i * golden), y, r * math.sin(i * golden))
		if HeadShape.underCap(cap, direction, 0.1) and not (underHat and y > 0.45) then
			local position = HeadShape.surface(ctx.headRadii, direction, 1.04)
			local size = (0.6 + 0.16 * hash(i)) * s
			ctx.addToHead(Shapes.ball("Curl", size, color, ctx.model), CFrame.new(position))
			highest = math.max(highest, position.Y + size / 2)
		end
	end
	ctx.hairTop = math.max(ctx.hairTop, highest)
	ctx.hairPuff = 1.22
end

builders.None = function(ctx)
	ctx.hairTop = ctx.headRadii.Y
	ctx.hairPuff = 1
end

function Hair.build(ctx: Context, piece: Outfits.Piece, underHat: boolean)
	local builder = builders[piece.style]
	if not builder then
		warn(`[Hair] Unknown hair style "{piece.style}"`)
		builder = builders.None
	end
	local color = Palette.resolve(piece.color, Palette.Hair.Chestnut)
	local accent = Palette.resolve(piece.accent, Palette.Cloth.Coral)
	builder(ctx, color, accent, underHat)
end

return Hair
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Hats</string>
            <string name="Source"><![CDATA[--!strict
-- Hats, built from parts and sized to sit on top of whatever hair the kid has.
-- To add a hat: write a builder below and list it in Data/Outfits.luau.

local Shapes = require(script.Parent.Shapes)
local HeadShape = require(script.Parent.HeadShape)
local Types = require(script.Parent.Types)
local Palette = require(script.Parent.Parent.Data.Palette)
local Outfits = require(script.Parent.Parent.Data.Outfits)

type Context = Types.Context
type Builder = (ctx: Context, color: Color3, accent: Color3) -> ()

local Hats = {}

local function add(ctx: Context, name: string, size: Vector3, color: Color3, cf: CFrame)
	ctx.addToHead(Shapes.ellipsoid(name, size, color, ctx.model), cf)
end

-- How big a hat's dome must be to cover the hair.
local function domePuff(ctx: Context, extra: number): number
	return math.max(ctx.hairPuff, 1.05) + extra
end

local builders: { [string]: Builder } = {}

builders.Tricorn = function(ctx, color, accent)
	local s, r = ctx.scale, ctx.headRadii
	local puff = domePuff(ctx, 0.05)
	local dome = HeadShape.cap(r, 0.66, 0.35, puff)
	add(ctx, "Crown", dome.size, color, CFrame.new(dome.center))

	-- Three turned-up brim flaps with gold trim. The front one carries a skull badge.
	local brimY = r.Y * 0.74
	local brimRadius = r.X * puff * 0.78
	local flapWidth, flapDepth = r.X * 1.75, r.X * 0.62
	for i, azimuth in { 0, 120, 240 } do
		local flap = CFrame.Angles(0, -math.rad(azimuth), 0)
			* CFrame.new(0, brimY, -brimRadius)
			* CFrame.Angles(math.rad(62), 0, 0)
		add(ctx, "Brim", Vector3.new(flapWidth, 0.22 * s, flapDepth), color, flap)
		add(ctx, "Trim", Vector3.new(flapWidth * 0.95, 0.26 * s, 0.16 * s), accent, flap * CFrame.new(0, 0, -flapDepth * 0.46))
		if i == 1 then
			-- The flap's outer face points along its -Y axis.
			local skull = Shapes.facing((flap * CFrame.new(0, -0.1 * s, 0.02 * s)).Position, -flap.UpVector)
			add(ctx, "Skull", Vector3.new(0.42, 0.38, 0.16) * s, Palette.Cloth.White, skull)
			for side = -1, 1, 2 do
				add(ctx, "SkullEye", Vector3.new(0.1, 0.11, 0.05) * s, Palette.Cloth.Charcoal, skull * CFrame.new(side * 0.08 * s, 0.03 * s, -0.08 * s))
			end
		end
	end
end

builders.VikingHorns = function(ctx, color, accent)
	local s, r = ctx.scale, ctx.headRadii
	local puff = domePuff(ctx, 0.07)
	local helmet = HeadShape.cap(r, 0.5, -0.05, puff)
	add(ctx, "Helmet", helmet.size, color, CFrame.new(helmet.center))
	-- A gold ridge over the top, front to back.
	add(ctx, "Ridge", Vector3.new(0.32 * s, helmet.size.Y * 1.03, helmet.size.Z * 1.03), accent, CFrame.new(helmet.center))

	-- Horns that curve up, made of four shrinking pieces each.
	local hornColor = Palette.Cloth.Horn
	for side = -1, 1, 2 do
		local point = Vector3.new(side * r.X * puff * 0.88, r.Y * 0.4, 0.05 * s)
		local pieces = {
			{ Vector3.new(side * 1, 0.25, 0), Vector3.new(0.54, 0.6, 0.54) },
			{ Vector3.new(side * 0.75, 0.7, 0), Vector3.new(0.44, 0.55, 0.44) },
			{ Vector3.new(side * 0.3, 1, 0), Vector3.new(0.33, 0.5, 0.33) },
			{ Vector3.new(0, 1, 0), Vector3.new(0.21, 0.4, 0.21) },
		}
		for _, piece in pieces do
			local direction = piece[1].Unit
			local size = piece[2] * s
			add(ctx, "Horn", size, hornColor, Shapes.alongY(point + direction * size.Y * 0.4, direction))
			point += direction * size.Y * 0.62
		end
	end
end

builders.Cap = function(ctx, color, accent)
	local s, r = ctx.scale, ctx.headRadii
	local puff = domePuff(ctx, 0.04)
	local dome = HeadShape.cap(r, 0.58, 0.05, puff)
	add(ctx, "Dome", dome.size, color, CFrame.new(dome.center))
	-- The visor is worn cocked to one side so it shows from the front.
	local visor = CFrame.Angles(0, -math.rad(40), 0)
		* CFrame.new(0, r.Y * 0.56, -r.Z * puff * 0.92)
		* CFrame.Angles(math.rad(-14), 0, 0)
	add(ctx, "Visor", Vector3.new(r.X * 1.25, 0.16 * s, r.Z * 1.3), color, visor)
	add(ctx, "Button", Vector3.new(0.26, 0.16, 0.26) * s, accent, CFrame.new(dome.center + Vector3.new(0, dome.size.Y / 2 - 0.02 * s, 0)))
end

builders.Crown = function(ctx, color, accent)
	local s = ctx.scale
	local base = CFrame.new(0, ctx.hairTop - 0.14 * s, 0) * CFrame.Angles(0, 0, math.rad(-10))
	add(ctx, "Band", Vector3.new(1.2, 0.42, 1.2) * s, color, base)
	for i = 0, 4 do
		local angle = math.rad(i * 72)
		local out = Vector3.new(math.sin(angle), 0, -math.cos(angle))
		local direction = (Vector3.yAxis + out * 0.3).Unit
		local foot = Vector3.new(out.X * 0.48 * s, 0.12 * s, out.Z * 0.48 * s)
		local tip = foot + direction * 0.44 * s
		add(ctx, "Point", Vector3.new(0.2, 0.46, 0.2) * s, color, base * Shapes.alongY(foot + direction * 0.2 * s, direction))
		add(ctx, "Tip", Vector3.new(0.17, 0.17, 0.17) * s, color, base * CFrame.new(tip))
	end
	add(ctx, "Gem", Vector3.new(0.24, 0.24, 0.16) * s, accent, base * CFrame.new(0, 0, -0.6 * s))
end

builders.Flower = function(ctx, color, accent)
	local s = ctx.scale
	local direction = Shapes.direction(38, 62)
	local base = if ctx.cap
		then HeadShape.onCap(ctx.cap, direction, 1.0)
		else HeadShape.surface(ctx.headRadii, direction, 1.0)
	local facing = (base.Unit + Vector3.new(0, 0, -0.5)).Unit
	local flower = Shapes.facing(base + facing * 0.05 * s, facing)
	for i = 0, 4 do
		local angle = math.rad(i * 72 + 90)
		add(ctx, "Petal", Vector3.new(0.4, 0.4, 0.2) * s, color, flower * CFrame.new(math.cos(angle) * 0.3 * s, math.sin(angle) * 0.3 * s, 0))
	end
	add(ctx, "Middle", Vector3.new(0.3, 0.3, 0.22) * s, accent, flower * CFrame.new(0, 0, -0.07 * s))
end

function Hats.build(ctx: Context, piece: Outfits.Piece?)
	if not piece or piece.style == "None" then
		return
	end
	local builder = builders[piece.style]
	if not builder then
		warn(`[Hats] Unknown hat "{piece.style}"`)
		return
	end
	local defaults = Outfits.find(Outfits.Hats, piece.style)
	local color = Palette.resolve(piece.color or (defaults and defaults.color), Palette.Cloth.Charcoal)
	local accent = Palette.resolve(piece.accent or (defaults and defaults.accent), Palette.Cloth.Gold)
	builder(ctx, color, accent)
end

-- Hats that cover the top of the head (spiky hair hides its top spikes under these).
function Hats.coversTop(piece: Outfits.Piece?): boolean
	return piece ~= nil and piece.style ~= "None" and piece.style ~= "Flower"
end

return Hats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">HeadShape</string>
            <string name="Source"><![CDATA[--!strict
-- Geometry for things that sit on the head (hair, hats, goggles).
-- All positions are in "head space": the head's center is the origin,
-- +Y is up and the face looks toward -Z.

local HeadShape = {}

-- A hair cap is a slightly bigger copy of the head, nudged up and back so
-- that it only covers the top. Where it pokes out of the head is the hairline.
export type Cap = {
	center: Vector3, -- studs, head space
	size: Vector3, -- studs
	normal: Vector3, -- hairline plane (in "unit head" space)
	offset: number,
	puff: number,
}

-- radii: half the head size.
-- front/back: hairline height at the forehead and at the back of the head,
--   from -1 (bottom of the head) to 1 (top).
-- puff: how much bigger than the head the cap is (1.05 = thin, 1.15 = fluffy).
function HeadShape.cap(radii: Vector3, front: number, back: number, puff: number): Cap
	local sf, sb = math.sqrt(1 - front * front), math.sqrt(1 - back * back)
	local theta = math.atan2(front - back, sf + sb)
	local c, s = math.cos(theta), math.sin(theta)
	local offset = front * c - sf * s
	local distance = offset + math.sqrt(offset * offset + puff * puff - 1)
	local center = Vector3.new(0, distance * c, distance * s)
	return {
		center = center * radii,
		size = radii * 2 * puff,
		normal = Vector3.new(0, c, s),
		offset = offset,
		puff = puff,
	}
end

-- Point on the head's surface in a direction, pushed out by `lift` (1 = on the skin).
function HeadShape.surface(radii: Vector3, direction: Vector3, lift: number?): Vector3
	local d = direction.Unit
	return Vector3.new(d.X * radii.X, d.Y * radii.Y, d.Z * radii.Z) * (lift or 1)
end

-- Outward normal of the head's surface at a point.
function HeadShape.normal(radii: Vector3, point: Vector3): Vector3
	return Vector3.new(
		point.X / (radii.X * radii.X),
		point.Y / (radii.Y * radii.Y),
		point.Z / (radii.Z * radii.Z)
	).Unit
end

-- Is this direction (from the head's center) covered by the cap?
function HeadShape.underCap(cap: Cap, direction: Vector3, margin: number?): boolean
	return direction.Unit:Dot(cap.normal) >= cap.offset + (margin or 0)
end

-- Point on the cap's surface, going out from the cap's own center.
function HeadShape.onCap(cap: Cap, direction: Vector3, lift: number?): Vector3
	local d = direction.Unit
	local r = cap.size / 2
	return cap.center + Vector3.new(d.X * r.X, d.Y * r.Y, d.Z * r.Z) * (lift or 1)
end

return HeadShape
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">KidRig</string>
            <string name="Source"><![CDATA[--!strict
-- A tiny skeleton for the kids. Every part is anchored and follows a "bone"
-- (Body, Head, ArmL, ...). Each frame the animator hands us a Pose and we
-- move all the parts at once. Squash and stretch scales the whole kid
-- about their feet, so hats, hair and clothes squash along with the body.

local KidRig = {}

export type Bone = {
	name: string,
	parent: string?,
	pivot: CFrame, -- rest transform relative to the parent bone
}

export type Attached = {
	part: BasePart,
	bone: string,
	offset: CFrame, -- relative to the bone
	size: Vector3, -- rest size
	mesh: SpecialMesh?,
	-- Parts that carry a SurfaceGui (the head, emblems) squash by changing
	-- their Size so the drawing squashes with them.
	squashBySize: boolean,
}

export type Rig = {
	root: BasePart,
	bones: { [string]: Bone },
	order: { string },
	attached: { Attached },
	restSpace: { [string]: CFrame }, -- each bone at rest, in root space
	lastSquash: Vector2,
	parts: { BasePart },
	frames: { CFrame },
}

export type Pose = {
	root: CFrame, -- world CFrame of the point between the feet
	squash: Vector2?, -- X = width multiplier, Y = height multiplier (1, 1 = rest)
	bones: { [string]: CFrame }?, -- extra rotation for each bone
}

function KidRig.new(root: BasePart): Rig
	local rig: Rig = {
		root = root,
		bones = {},
		order = {},
		attached = {},
		restSpace = { Root = CFrame.identity },
		lastSquash = Vector2.new(1, 1),
		parts = { root },
		frames = { CFrame.identity },
	}
	rig.bones.Root = { name = "Root", parent = nil, pivot = CFrame.identity }
	table.insert(rig.order, "Root")
	return rig
end

-- Bones must be added parent first.
function KidRig.addBone(rig: Rig, name: string, parent: string, pivot: CFrame)
	assert(rig.bones[parent], `parent bone {parent} must be added before {name}`)
	rig.bones[name] = { name = name, parent = parent, pivot = pivot }
	rig.restSpace[name] = rig.restSpace[parent] * pivot
	table.insert(rig.order, name)
end

-- Attach a part to a bone. `offset` is in the bone's own space.
function KidRig.attach(rig: Rig, part: BasePart, bone: string, offset: CFrame, squashBySize: boolean?)
	assert(rig.bones[bone], `unknown bone {bone}`)
	table.insert(rig.attached, {
		part = part,
		bone = bone,
		offset = offset,
		size = part.Size,
		mesh = part:FindFirstChildOfClass("SpecialMesh"),
		squashBySize = squashBySize == true,
	})
	table.insert(rig.parts, part)
	table.insert(rig.frames, CFrame.identity)
end

-- Attach a part using a CFrame in root space (where the kid stands at the origin facing -Z).
function KidRig.attachInRootSpace(rig: Rig, part: BasePart, bone: string, rootSpace: CFrame, squashBySize: boolean?)
	KidRig.attach(rig, part, bone, rig.restSpace[bone]:Inverse() * rootSpace, squashBySize)
end

-- How much a part stretches along one of its own axes when the kid is squashed.
local function axisScale(axis: Vector3, squash: Vector2): number
	local x, y = axis.X * squash.X, axis.Y * squash.Y
	return math.sqrt(x * x + y * y + axis.Z * axis.Z)
end

function KidRig.apply(rig: Rig, pose: Pose)
	local squash = pose.squash or Vector2.new(1, 1)
	local boneAnim = pose.bones
	local boneSpace: { [string]: CFrame } = {}
	for _, name in rig.order do
		local bone = rig.bones[name]
		local parentSpace = if bone.parent then boneSpace[bone.parent] else CFrame.identity
		local extra = boneAnim and boneAnim[name]
		boneSpace[name] = if extra then parentSpace * bone.pivot * extra else parentSpace * bone.pivot
	end

	local squashed = math.abs(squash.X - 1) > 1e-4 or math.abs(squash.Y - 1) > 1e-4
	-- Resizing every part is the expensive bit, so skip tiny changes (idle breathing).
	local target = if squashed then squash else Vector2.one
	local squashChanged = (target - rig.lastSquash).Magnitude > 0.004
		or (not squashed and rig.lastSquash ~= Vector2.one)
	if squashChanged then
		rig.lastSquash = target
	end

	local rootCF = pose.root
	rig.frames[1] = rootCF
	for i, item in rig.attached do
		local placed = boneSpace[item.bone] * item.offset
		if squashed then
			local p = placed.Position
			placed = CFrame.new(p.X * squash.X, p.Y * squash.Y, p.Z) * placed.Rotation
		end
		rig.frames[i + 1] = rootCF * placed

		if squashChanged then
			local scale = if squashed
				then Vector3.new(
					axisScale(placed.XVector, squash),
					axisScale(placed.YVector, squash),
					axisScale(placed.ZVector, squash)
				)
				else Vector3.one
			if item.squashBySize then
				item.part.Size = item.size * scale
			elseif item.mesh then
				item.mesh.Scale = scale
			end
		end
	end

	if rig.root:IsDescendantOf(workspace) then
		workspace:BulkMoveTo(rig.parts, rig.frames, Enum.BulkMoveMode.FireCFrameChanged)
	else
		for i, part in rig.parts do
			part.CFrame = rig.frames[i]
		end
	end
end

return KidRig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Outline</string>
            <string name="Source"><![CDATA[--!strict
-- Thick dark cartoon outlines using Roblox Highlights (fill off, outline on).
-- Roblox only draws about 31 Highlights at once, so this keeps count and
-- refuses to add more than Config.Outline.MaxHighlights.

local Config = require(script.Parent.Parent.Config)

local Outline = {}

local active: { [Highlight]: boolean } = {}

-- How many outlines exist right now (forgets ones that were destroyed).
function Outline.count(): number
	local n = 0
	for highlight in active do
		if highlight.Parent then
			n += 1
		else
			active[highlight] = nil
		end
	end
	return n
end

function Outline.add(target: Instance): Highlight?
	if Outline.count() >= Config.Outline.MaxHighlights then
		warn("[Outline] Highlight limit reached; this one will have no outline")
		return nil
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "Outline"
	highlight.FillTransparency = 1
	highlight.OutlineColor = Config.Outline.Color
	highlight.OutlineTransparency = Config.Outline.Transparency
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = target
	highlight.Parent = target
	active[highlight] = true
	return highlight
end

function Outline.remove(target: Instance)
	for _, child in target:GetChildren() do
		if child:IsA("Highlight") then
			active[child] = nil
			child:Destroy()
		end
	end
end

return Outline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Shapes</string>
            <string name="Source"><![CDATA[--!strict
-- Small helpers for making the rounded cartoon parts the kids are built from.
-- Every shape is an ellipsoid (a Part with a sphere SpecialMesh), because
-- ellipsoids can be stretched in any direction and squashed while animating.

local Shapes = {}

local function basePart(name: string, size: Vector3, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = true
	return part
end

-- An egg/ball/bean shape that exactly fills `size`.
function Shapes.ellipsoid(name: string, size: Vector3, color: Color3, parent: Instance?): Part
	local part = basePart(name, size, color)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	part.Parent = parent
	return part
end

function Shapes.ball(name: string, diameter: number, color: Color3, parent: Instance?): Part
	return Shapes.ellipsoid(name, Vector3.new(diameter, diameter, diameter), color, parent)
end

-- A plain invisible box, used as the root of a kid and to carry flat drawings (SurfaceGuis).
function Shapes.carrier(name: string, size: Vector3, parent: Instance?): Part
	local part = basePart(name, size, Color3.new(1, 1, 1))
	part.Transparency = 1
	part.CastShadow = false
	part.Parent = parent
	return part
end

function Shapes.block(name: string, size: Vector3, color: Color3, parent: Instance?): Part
	local part = basePart(name, size, color)
	part.Parent = parent
	return part
end

-- A CFrame at `position` whose local Y axis points along `direction`.
function Shapes.alongY(position: Vector3, direction: Vector3): CFrame
	local up = direction.Unit
	local helper = if math.abs(up.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis
	local right = helper:Cross(up).Unit
	return CFrame.fromMatrix(position, right, up)
end

-- A CFrame at `position` whose front (-Z, where SurfaceGuis and discs face) points along `direction`.
function Shapes.facing(position: Vector3, direction: Vector3): CFrame
	local look = direction.Unit
	local helper = if math.abs(look.Y) > 0.98 then Vector3.zAxis else Vector3.yAxis
	local right = look:Cross(helper).Unit
	local up = right:Cross(look).Unit
	return CFrame.fromMatrix(position, right, up)
end

-- Direction from spherical angles, in a kid's own space where the front is -Z.
-- elevation: 0 = level, 90 = straight up. azimuth: 0 = front, +90 = the kid's right (+X).
function Shapes.direction(elevation: number, azimuth: number): Vector3
	local el, az = math.rad(elevation), math.rad(azimuth)
	return Vector3.new(math.cos(el) * math.sin(az), math.sin(el), -math.cos(el) * math.cos(az))
end

return Shapes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
-- Shared types for the character modules.

local HeadShape = require(script.Parent.HeadShape)

-- Measurements of one kid, in studs. Heights are measured up from the feet.
export type Dims = {
	scale: number,
	head: Vector3,
	body: Vector3,
	leg: Vector3,
	arm: Vector3,
	hand: Vector3,
	shoe: Vector3,
	feet: Vector3,
	legSpread: number,
	legTopY: number,
	bodyBottomY: number,
	bodyTopY: number,
	neckY: number,
	headCenterY: number,
	height: number,
	shoulderY: number,
	shoulderX: number,
}

-- Handed to the hair, hat and accessory builders.
export type Context = {
	model: Model,
	dims: Dims,
	scale: number,
	skin: Color3,
	headRadii: Vector3,
	-- Filled in by the hair builder:
	cap: HeadShape.Cap?,
	hairTop: number, -- head space height of the top of the hair
	hairPuff: number, -- how far the hair sticks out (1 = bald)
	-- Attach a part. Head space has its origin at the head's center.
	addToHead: (part: BasePart, headSpace: CFrame) -> (),
	addToBone: (part: BasePart, bone: string, boneSpace: CFrame, squashBySize: boolean?) -> (),
	addInRootSpace: (part: BasePart, bone: string, rootSpace: CFrame) -> (),
}

return {}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every number you might want to tune lives here.
-- Sizes are in studs, angles in degrees, times in seconds.

local Config = {}

Config.GameName = "Splash Squad"

Config.World = {
	WaterY = 0, -- height of the water surface
	Gravity = 55, -- studs/s^2, used for shots and knockback flights
	PlaneZ = 0, -- the fight happens on this Z plane (2.5D)
}

-- Chibi body proportions, before each kid's own scale is applied.
-- The head is about as big as the rest of the body.
Config.Kid = {
	HeadSize = Vector3.new(2.5, 2.3, 2.3), -- width, height, depth (an egg-ish ball)
	HeadSink = 0.3, -- how far the head overlaps the top of the body
	BodySize = Vector3.new(1.6, 1.7, 1.36), -- a short bean
	LegSize = Vector3.new(0.56, 0.82, 0.56),
	LegSpread = 0.38, -- hip distance from the middle
	ArmSize = Vector3.new(0.46, 1.0, 0.46),
	ArmRestAngle = 16, -- arms hang slightly away from the body
	ShoulderDrop = 0.36, -- shoulders sit this far below the top of the body
	HandSize = Vector3.new(0.52, 0.54, 0.48), -- little mittens
	ShoeSize = Vector3.new(0.64, 0.38, 0.84),
	FeetSize = Vector3.new(0.5, 0.3, 0.66), -- bare feet are a bit smaller than shoes
	FacingAngle = 16, -- kids face the camera, turned this far toward their target
}

-- Where things go on the face, as fractions of the face (0..1 across, 0..1 down).
Config.Face = {
	PixelsPerStud = 100,
	LightInfluence = 0.55, -- 0 = face drawn at full brightness, 1 = shaded like the head
	EyeY = 0.56,
	EyeSpacing = 0.34, -- distance between the eye centers
	EyeWidth = 0.15,
	EyeHeight = 0.25,
	ShineSize = 0.45, -- shine dot size, as a fraction of the eye width
	BrowY = 0.355,
	BrowLength = 0.13,
	LineThickness = 0.024, -- brows, smiles, closed eyes
	BlushY = 0.7,
	BlushSpacing = 0.56,
	BlushWidth = 0.14,
	BlushHeight = 0.075,
	MouthY = 0.765,
	MouthWidth = 0.15,
	BlinkEvery = { 2.2, 5.0 }, -- random wait between blinks
	BlinkTime = 0.11,
	SpiralSpeed = 540, -- dizzy eyes spin speed (degrees per second)
}

Config.Outline = {
	Color = Color3.fromRGB(34, 22, 36),
	Transparency = 0,
	MaxHighlights = 30, -- Roblox draws at most 31 Highlights at once
}

Config.Anim = {
	IdleBobHeight = 0.1,
	IdleBobSpeed = 2.4, -- radians per second
	IdleSway = 2.5, -- degrees
	BreathSquash = 0.025,

	AimLean = 7,
	FireTime = 0.55,
	FireLean = 12,
	FireSquash = 0.16,
	FireFaceTime = 0.75,

	HitTime = 0.55,
	HitLean = 22,
	HitHop = 0.6,
	HitFaceTime = 0.8,

	SpinSpeed = 760, -- degrees per second while flying
	FlailSpeed = 22, -- radians per second for flailing arms and legs

	WaterFloatTime = 3.0, -- how long a kid bobs in the water before sinking
	WaterBob = 0.16,
	SinkTime = 1.3,

	WinHopHeight = 1.4,
	WinHopTime = 0.42,

	LandSquash = 0.22,
	DropInHeight = 9,
}

Config.Splash = {
	Droplets = 16,
	DropletSize = { 0.25, 0.55 },
	DropletSpeed = { 10, 22 },
	RingBlobs = 18,
	RingStartRadius = 0.6,
	RingEndRadius = 3.6,
	RingTime = 0.8,
	ColumnHeight = 3.4,
	ColumnTime = 0.55,
	WaterColor = Color3.fromRGB(150, 236, 246),
	FoamColor = Color3.fromRGB(250, 255, 255),
}

Config.Camera = {
	FieldOfView = 40,
	Pitch = 7, -- looking slightly down at the water
	Smoothness = 6, -- higher = snappier camera
}

Config.Lighting = {
	ClockTime = 14.2,
	GeographicLatitude = 23,
	Brightness = 2.6,
	Ambient = Color3.fromRGB(112, 112, 128),
	OutdoorAmbient = Color3.fromRGB(170, 172, 190),
	ShadowSoftness = 0.6,
	EnvironmentDiffuseScale = 0.6,
	EnvironmentSpecularScale = 0.15,
	ExposureCompensation = 0.12,
	ColorCorrection = {
		Saturation = 0.2,
		Contrast = 0.07,
		Brightness = 0.02,
		TintColor = Color3.fromRGB(255, 251, 244),
	},
	Bloom = {
		Intensity = 0.25,
		Size = 22,
		Threshold = 1.7,
	},
	Atmosphere = {
		Density = 0.24,
		Offset = 0.2,
		Color = Color3.fromRGB(205, 232, 255),
		Decay = Color3.fromRGB(140, 196, 240),
		Glare = 0.1,
		Haze = 0.6,
	},
}

return Config
]]></string>
        </Properties>
