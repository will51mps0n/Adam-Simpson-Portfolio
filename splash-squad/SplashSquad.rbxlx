        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client entry point. For milestone 1 it opens the test stage where you can
-- meet the kids; the lobby and matches arrive in later milestones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

ReplicatedStorage:WaitForChild("Shared")

-- Players have no normal avatar, so hide the backpack, health bar and reset button.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local Showcase = require(script.Showcase)
Showcase.start()
]]></string>
        </Properties>
        <Item class="Folder" referent="27">
          <Properties>
            <string name="Name">Animation</string>
          </Properties>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Curve</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny keyframe curves for hand-made animation.
-- Curve.keys(0.3, { {0, 0}, {0.25, 1}, {1, 0} }) eases between the keys.

local Curve = {}

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

function Curve.keys(p: number, keys: { { number } }): number
	if p <= keys[1][1] then
		return keys[1][2]
	end
	for i = 2, #keys do
		local a, b = keys[i - 1], keys[i]
		if p <= b[1] then
			local t = (p - a[1]) / (b[1] - a[1])
			return a[2] + (b[2] - a[2]) * smooth(t)
		end
	end
	return keys[#keys][2]
end

function Curve.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

return Curve
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">KidAnimator</string>
              <string name="Source"><![CDATA[--!strict
-- Brings a kid to life: bobbing on the waves, blinking, aiming, throwing
-- with squash and stretch, flinching when hit, flailing through the air,
-- splashing into the water, bobbing there sadly and sinking out of view.
--
-- Everything is computed each frame from simple curves and handed to the
-- kid's rig (Shared/Character/KidRig.luau). One loop drives all kids.
--
--   local animator = KidAnimator.new(kid, { home = Vector3.new(0, 1, 0), facing = 1 })
--   animator:Aim(true)    animator:Fire()    animator:Hit(1)
--   animator:Knock(Vector3.new(-20, 18, 0))  animator:Win(true)  animator:DropIn()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local KidRig = require(ReplicatedStorage.Shared.Character.KidRig)
local CharacterBuilder = require(ReplicatedStorage.Shared.Character.CharacterBuilder)
local Curve = require(script.Parent.Curve)
local Splash = require(script.Parent.Parent.Effects.Splash)

type Kid = CharacterBuilder.Kid

type Overlay = {
	kind: string,
	t: number,
	duration: number,
	direction: number,
}

type Limb = { out: number, forward: number }

type AnimatorData = {
	Kid: Kid,
	Home: Vector3, -- point between the feet when standing
	Facing: number, -- 1 = target is to the right (+X), -1 = to the left
	ExtraYaw: number, -- degrees (used to spin the kid around for a look)
	Turntable: boolean,
	State: string, -- Idle, Aim, Win, Fly, Water, Sink, Gone, Drop
	StateTime: number,
	Clock: number,
	Phase: number,
	Overlays: { Overlay },
	Position: Vector3,
	Velocity: Vector3,
	Spin: number,
	FaceOverride: string?,
	FaceOverrideUntil: number,
	NextBlink: number,
	NextRipple: number,
	NextBubble: number,
	OnGone: (() -> ())?,
	Destroyed: boolean,
}

local KidAnimator = {}
KidAnimator.__index = KidAnimator

export type Animator = typeof(setmetatable({} :: AnimatorData, KidAnimator))

export type Options = {
	home: Vector3,
	facing: number?,
}

local active: { [Animator]: boolean } = {}
local loop: RBXScriptConnection? = nil
local random = Random.new()

local STATE_FACES = {
	Idle = "Idle",
	Aim = "Aiming",
	Win = "Win",
	Fly = "Flying",
	Water = "Wet",
	Sink = "Wet",
	Gone = "Wet",
	Drop = "Fire",
}

local function ensureLoop()
	if loop then
		return
	end
	loop = RunService.RenderStepped:Connect(function(dt)
		for animator in active do
			local ok, err = pcall(animator.Update, animator, dt)
			if not ok then
				warn("[KidAnimator] " .. tostring(err))
			end
		end
	end)
end

function KidAnimator.new(kid: Kid, options: Options): Animator
	local self = setmetatable({
		Kid = kid,
		Home = options.home,
		Facing = options.facing or 1,
		ExtraYaw = 0,
		Turntable = false,
		State = "Idle",
		StateTime = 0,
		Clock = 0,
		Phase = random:NextNumber(0, 10),
		Overlays = {},
		Position = options.home,
		Velocity = Vector3.zero,
		Spin = 0,
		FaceOverride = nil,
		FaceOverrideUntil = 0,
		NextBlink = random:NextNumber(Config.Face.BlinkEvery[1], Config.Face.BlinkEvery[2]),
		NextRipple = 0,
		NextBubble = 0,
		OnGone = nil,
		Destroyed = false,
	} :: AnimatorData, KidAnimator)
	active[self] = true
	ensureLoop()
	self:Update(0)
	return self
end

function KidAnimator.Destroy(self: Animator)
	self.Destroyed = true
	active[self] = nil
end

------------------------------------------------------------------------
-- Commands

function KidAnimator._setState(self: Animator, state: string)
	self.State = state
	self.StateTime = 0
	self.FaceOverride = nil
end

function KidAnimator._overlay(self: Animator, kind: string, duration: number, direction: number?)
	for i = #self.Overlays, 1, -1 do
		if self.Overlays[i].kind == kind then
			table.remove(self.Overlays, i)
		end
	end
	table.insert(self.Overlays, { kind = kind, t = 0, duration = duration, direction = direction or 1 })
end

-- Is the kid standing on their spot (not flying or swimming)?
function KidAnimator.IsStanding(self: Animator): boolean
	return self.State == "Idle" or self.State == "Aim" or self.State == "Win"
end

-- Show an expression for a while (or until the next action if no duration).
function KidAnimator.ShowFace(self: Animator, expression: string, duration: number?)
	self.FaceOverride = expression
	self.FaceOverrideUntil = if duration then self.Clock + duration else math.huge
end

function KidAnimator.SetHome(self: Animator, home: Vector3, facing: number?)
	self.Home = home
	if facing then
		self.Facing = facing
	end
end

function KidAnimator.Aim(self: Animator, on: boolean)
	if on and self:IsStanding() then
		self:_setState("Aim")
	elseif not on and self.State == "Aim" then
		self:_setState("Idle")
	end
end

function KidAnimator.Fire(self: Animator)
	if not self:IsStanding() then
		return
	end
	self:_setState("Idle")
	self:_overlay("Fire", Config.Anim.FireTime)
	self:ShowFace("Fire", Config.Anim.FireFaceTime)
end

-- fromSide: 1 if the hit came from the right, -1 from the left.
function KidAnimator.Hit(self: Animator, fromSide: number)
	if not self:IsStanding() then
		return
	end
	if self.State == "Aim" then
		self:_setState("Idle")
	end
	self:_overlay("Hit", Config.Anim.HitTime, fromSide)
	self:ShowFace("Hit", Config.Anim.HitFaceTime)
end

-- Send the kid flying with a velocity (studs per second). They splash into the water.
function KidAnimator.Knock(self: Animator, velocity: Vector3)
	if self.State == "Fly" or self.State == "Water" or self.State == "Sink" or self.State == "Gone" then
		return
	end
	self.Position = self.Home
	self.Velocity = velocity
	self.Spin = 0
	table.clear(self.Overlays)
	self:_setState("Fly")
end

function KidAnimator.Win(self: Animator, on: boolean)
	if on and self:IsStanding() then
		self:_setState("Win")
	elseif not on and self.State == "Win" then
		self:_setState("Idle")
	end
end

-- Drop back onto the home spot from above.
function KidAnimator.DropIn(self: Animator)
	self.Position = self.Home + Vector3.new(0, Config.Anim.DropInHeight, 0)
	self.Velocity = Vector3.zero
	self.Spin = 0
	table.clear(self.Overlays)
	self:_setState("Drop")
end

-- Snap back to standing on the home spot.
function KidAnimator.Reset(self: Animator)
	table.clear(self.Overlays)
	self.Position = self.Home
	self:_setState("Idle")
end

-- Launch speed that makes a kid standing at `from` land in the water at `targetX`.
function KidAnimator.LaunchVelocity(self: Animator, targetX: number, upSpeed: number): Vector3
	local g = Config.World.Gravity
	local pivot = self.Kid.Dims.height * 0.5
	local drop = self.Home.Y - (Config.World.WaterY - pivot)
	local t = (upSpeed + math.sqrt(upSpeed * upSpeed + 2 * g * drop)) / g
	return Vector3.new((targetX - self.Home.X) / t, upSpeed, 0)
end

------------------------------------------------------------------------
-- Per-frame update

function KidAnimator.Update(self: Animator, dt: number)
	if self.Destroyed or not self.Kid.Model.Parent then
		return
	end
	local A = Config.Anim
	local d = self.Kid.Dims
	local s = d.scale
	local facing = self.Facing
	self.Clock += dt
	self.StateTime += dt

	-- Pose pieces we build up this frame.
	local base = self.Home
	local offset = Vector3.zero
	local roll = 0 -- radians, in the screen plane; positive tips the kid's head to the left
	local pivot = 0 -- height of the point we roll around (0 = feet)
	local sx, sy = 1, 1
	local arms: { [string]: Limb } = { R = { out = 0, forward = 0 }, L = { out = 0, forward = 0 } }
	local legs: { [string]: Limb } = { R = { out = 0, forward = 0 }, L = { out = 0, forward = 0 } }
	local headRoll, headNod = 0, 0
	local cape = math.rad(4)

	-- The arm on the target's side throws.
	local front = if facing > 0 then "L" else "R"
	local back = if facing > 0 then "R" else "L"

	local state = self.State
	local t = self.Clock + self.Phase
	local standing = state == "Idle" or state == "Aim" or state == "Win"

	if standing then
		local w = A.IdleBobSpeed
		offset += Vector3.new(0, (1 - math.cos(t * w)) * 0.5 * A.IdleBobHeight * s, 0)
		roll += math.rad(A.IdleSway) * math.sin(t * w * 0.5)
		local breath = math.sin(t * w) * A.BreathSquash
		sy *= 1 + breath
		sx *= 1 - breath * 0.5
		arms.R.out += math.rad(4) * math.sin(t * 1.7)
		arms.L.out += math.rad(4) * math.sin(t * 1.7 + 1.3)
		headRoll += math.rad(3) * math.sin(t * 1.1 + 1)
		cape += math.rad(6) * math.sin(t * 3.1)
	end

	if state == "Aim" then
		local k = math.min(self.StateTime / 0.25, 1)
		roll += facing * math.rad(A.AimLean) * k
		arms[front].out = math.rad(118) * k
		arms[back].out = math.rad(40) * k
		headRoll -= facing * math.rad(6) * k
	elseif state == "Win" then
		local air, ground = A.WinHopTime, 0.22
		local u = self.StateTime % (air + ground)
		if u < air then
			local q = u / air
			offset += Vector3.new(0, 4 * A.WinHopHeight * s * q * (1 - q), 0)
			local stretch = 0.12 * math.abs(1 - 2 * q)
			sy *= 1 + stretch
			sx *= 1 - stretch * 0.6
			legs.R.out, legs.L.out = math.rad(14), math.rad(14)
		else
			local k = math.sin((u - air) / ground * math.pi)
			sy *= 1 - 0.18 * k
			sx *= 1 + 0.12 * k
		end
		arms.R.out = math.rad(122) + math.rad(18) * math.sin(self.StateTime * 14)
		arms.L.out = math.rad(122) + math.rad(18) * math.sin(self.StateTime * 14 + math.pi)
		roll += math.rad(5) * math.sin(self.StateTime * 6)
	elseif state == "Fly" then
		self.Velocity -= Vector3.new(0, Config.World.Gravity * dt, 0)
		self.Position += self.Velocity * dt
		local spinDirection = if self.Velocity.X < 0 then 1 else -1
		self.Spin += math.rad(A.SpinSpeed) * dt * spinDirection
		base = self.Position
		pivot = d.height * 0.5
		roll = self.Spin
		local flail = self.Clock * A.FlailSpeed
		arms.R.out = math.rad(110) + math.rad(45) * math.sin(flail)
		arms.L.out = math.rad(110) + math.rad(45) * math.sin(flail + math.pi)
		legs.R.out = math.rad(20) + math.rad(25) * math.sin(flail * 0.8 + 1)
		legs.L.out = math.rad(20) + math.rad(25) * math.sin(flail * 0.8 + 1 + math.pi)
		legs.R.forward = math.rad(30) * math.sin(flail * 0.7)
		legs.L.forward = -math.rad(30) * math.sin(flail * 0.7)
		cape = math.rad(35) + math.rad(15) * math.sin(flail)
		if self.Position.Y + pivot <= Config.World.WaterY and self.Velocity.Y < 0 then
			Splash.play(self.Position + Vector3.new(0, pivot, 0), math.clamp(s, 0.8, 1.3))
			self:_setState("Water")
			self.NextRipple = self.Clock + 0.6
		end
	elseif state == "Water" or state == "Sink" then
		local floatY = Config.World.WaterY - (d.headCenterY - d.head.Y * 0.38)
		local y = floatY + math.sin(self.StateTime * 3.2) * A.WaterBob * s
		local waving = math.rad(20) * math.sin(self.StateTime * 10)
		arms.R.out = math.rad(128) + waving
		arms.L.out = math.rad(128) - waving
		roll = math.rad(6) * math.sin(self.StateTime * 2.3)
		if state == "Sink" then
			local k = math.min(self.StateTime / A.SinkTime, 1)
			y = floatY - (k * k) * (d.height + 1.5)
			arms.R.out, arms.L.out = math.rad(135), math.rad(135)
			if self.Clock >= self.NextBubble and k < 0.9 then
				self.NextBubble = self.Clock + 0.1
				Splash.bubbles(Vector3.new(self.Position.X, 0, self.Position.Z), 2, s)
			end
			if k >= 1 then
				self:_setState("Gone")
				if self.OnGone then
					task.spawn(self.OnGone)
				end
			end
		else
			if self.Clock >= self.NextRipple then
				self.NextRipple = self.Clock + 0.9
				Splash.ripple(self.Position, s)
			end
			if self.StateTime >= A.WaterFloatTime then
				self:_setState("Sink")
			end
		end
		base = Vector3.new(self.Position.X, y, self.Position.Z)
	elseif state == "Gone" then
		base = Vector3.new(self.Position.X, Config.World.WaterY - 60, self.Position.Z)
	elseif state == "Drop" then
		self.Velocity -= Vector3.new(0, Config.World.Gravity * dt, 0)
		self.Position += self.Velocity * dt
		base = self.Position
		arms.R.out, arms.L.out = math.rad(125), math.rad(125)
		legs.R.out, legs.L.out = math.rad(10), math.rad(10)
		if self.Position.Y <= self.Home.Y then
			self.Position = self.Home
			base = self.Home
			self:_setState("Idle")
			self:_overlay("Land", 0.45)
		end
	end

	-- One-shot overlays on top of the state.
	for i = #self.Overlays, 1, -1 do
		local o = self.Overlays[i]
		o.t += dt
		local p = math.min(o.t / o.duration, 1)
		if o.kind == "Fire" then
			local squash = Curve.keys(p, { { 0, 0 }, { 0.22, -1 }, { 0.4, 0.85 }, { 0.62, -0.2 }, { 0.8, 0.06 }, { 1, 0 } })
				* A.FireSquash
			sy *= 1 + squash
			sx *= 1 - squash * 0.6
			roll += facing
				* math.rad(A.FireLean)
				* Curve.keys(p, { { 0, 0 }, { 0.22, 1 }, { 0.4, -0.7 }, { 0.7, 0.15 }, { 1, 0 } })
			arms[front].out =
				math.rad(Curve.keys(p, { { 0, 118 }, { 0.22, 135 }, { 0.42, 50 }, { 0.75, 32 }, { 1, 0 } }))
			arms[back].out = math.rad(Curve.keys(p, { { 0, 40 }, { 0.42, 70 }, { 1, 0 } }))
			offset += Vector3.new(0, 0.35 * s * Curve.keys(p, { { 0, 0 }, { 0.3, 0 }, { 0.45, 1 }, { 0.65, 0 }, { 1, 0 } }), 0)
		elseif o.kind == "Hit" then
			local away = -o.direction
			local k = Curve.keys(p, { { 0, 0 }, { 0.1, 1 }, { 0.35, -0.4 }, { 0.6, 0.1 }, { 1, 0 } })
			roll += -away
				* math.rad(A.HitLean)
				* Curve.keys(p, { { 0, 0 }, { 0.12, 1 }, { 0.4, -0.3 }, { 0.7, 0.1 }, { 1, 0 } })
			offset += Vector3.new(
				away * 0.45 * s * Curve.keys(p, { { 0, 0 }, { 0.2, 1 }, { 0.6, 0.6 }, { 1, 0 } })
					+ math.sin(p * 60) * 0.06 * (1 - p),
				A.HitHop * s * Curve.keys(p, { { 0, 0 }, { 0.18, 1 }, { 0.38, 0 }, { 1, 0 } }),
				0
			)
			sx *= 1 - 0.15 * k
			sy *= 1 + 0.12 * k
			local fling = math.rad(70) * Curve.keys(p, { { 0, 0 }, { 0.15, 1 }, { 0.6, 0.3 }, { 1, 0 } })
			arms.R.out += fling
			arms.L.out += fling
			headNod -= math.rad(15) * k
		elseif o.kind == "Land" then
			local k = Curve.keys(p, { { 0, 0 }, { 0.15, 1 }, { 0.45, -0.35 }, { 0.7, 0.1 }, { 1, 0 } })
			sy *= 1 - A.LandSquash * k
			sx *= 1 + A.LandSquash * 0.7 * k
		end
		if p >= 1 then
			table.remove(self.Overlays, i)
		end
	end

	-- Face: an override (from an action or a button) wins over the state's face.
	local face = self.Kid.Face
	if self.FaceOverride and self.Clock > self.FaceOverrideUntil then
		self.FaceOverride = nil
	end
	local wanted = self.FaceOverride or STATE_FACES[state] or "Idle"
	if face.Expression ~= wanted then
		face:SetExpression(wanted)
	end
	if self.Clock >= self.NextBlink then
		self.NextBlink = self.Clock + random:NextNumber(Config.Face.BlinkEvery[1], Config.Face.BlinkEvery[2])
		face:Blink()
	end
	face:Update(dt)

	if self.Turntable then
		self.ExtraYaw = (self.ExtraYaw + 45 * dt) % 360
	end

	-- Hand everything to the rig. Kids keep their face toward the camera,
	-- turned a little toward their target.
	local camera = workspace.CurrentCamera
	local toCamera = if camera then camera.CFrame.Position - base else Vector3.zAxis
	local flat = Vector3.new(toCamera.X, 0, toCamera.Z)
	local cameraYaw = if flat.Magnitude > 1e-3 then math.atan2(-flat.X, -flat.Z) else math.pi
	local yaw = cameraYaw + facing * math.rad(Config.Kid.FacingAngle) + math.rad(self.ExtraYaw)
	local rootCF = CFrame.new(base + offset + Vector3.new(0, pivot, 0))
		* CFrame.Angles(0, 0, roll)
		* CFrame.new(0, -pivot, 0)
		* CFrame.Angles(0, yaw, 0)
	KidRig.apply(self.Kid.Rig, {
		root = rootCF,
		squash = Vector2.new(sx, sy),
		bones = {
			ArmR = CFrame.Angles(arms.R.forward, 0, arms.R.out),
			ArmL = CFrame.Angles(arms.L.forward, 0, -arms.L.out),
			LegR = CFrame.Angles(legs.R.forward, 0, legs.R.out),
			LegL = CFrame.Angles(legs.L.forward, 0, -legs.L.out),
			Head = CFrame.Angles(headNod, 0, headRoll),
			Cape = CFrame.Angles(-cape, 0, 0),
		},
	})
end

return KidAnimator
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CameraRig</string>
            <string name="Source"><![CDATA[--!strict
-- A side-on camera (like the 2D original) that glides to whatever we ask it to frame.
--   CameraRig.start()
--   CameraRig.frame(Vector3.new(0, 3, 0), 20, 6)  -- center, half width, half height (studs)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local CameraRig = {}

local target = {
	center = Vector3.new(0, 3, 0),
	halfWidth = 20,
	halfHeight = 6,
}
local current: CFrame? = nil
local started = false

local function desired(camera: Camera): CFrame
	local viewport = camera.ViewportSize
	local aspect = if viewport.Y > 0 then viewport.X / viewport.Y else 16 / 9
	local tanHalf = math.tan(math.rad(Config.Camera.FieldOfView / 2))
	local distance = math.max(target.halfHeight / tanHalf, target.halfWidth / (tanHalf * aspect))
	local pitch = math.rad(Config.Camera.Pitch)
	local eye = target.center + Vector3.new(0, math.sin(pitch), math.cos(pitch)) * distance
	return CFrame.lookAt(eye, target.center)
end

function CameraRig.start()
	if started then
		return
	end
	started = true
	RunService:BindToRenderStep("SplashCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		camera.FieldOfView = Config.Camera.FieldOfView
		local goal = desired(camera)
		local alpha = 1 - math.exp(-Config.Camera.Smoothness * dt)
		current = if current then current:Lerp(goal, alpha) else goal
		camera.CFrame = current :: CFrame
	end)
end

-- Frame a region: everything within halfWidth/halfHeight of center stays on screen.
function CameraRig.frame(center: Vector3, halfWidth: number, halfHeight: number, instant: boolean?)
	target.center = center
	target.halfWidth = halfWidth
	target.halfHeight = halfHeight
	if instant then
		current = nil
	end
end

return CameraRig
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="31">
          <Properties>
            <string name="Name">Effects</string>
          </Properties>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Splash</string>
              <string name="Source"><![CDATA[--!strict
-- Cartoon water effects, all made from parts: a big splash (a water column,
-- flying droplets, a ring of foam and a puff of spray), small ripples, and
-- "blub blub" bubbles when someone sinks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Shapes = require(ReplicatedStorage.Shared.Character.Shapes)

local Splash = {}

type Effect = (dt: number) -> boolean -- return false when finished

local effects: { Effect } = {}
local connection: RBXScriptConnection? = nil
local random = Random.new()

local function folder(): Instance
	local existing = workspace:FindFirstChild("Effects")
	if existing then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "Effects"
	created.Parent = workspace
	return created
end

local function run(effect: Effect)
	table.insert(effects, effect)
	if connection then
		return
	end
	connection = RunService.RenderStepped:Connect(function(dt)
		for i = #effects, 1, -1 do
			local ok, alive = pcall(effects[i], dt)
			if not ok or not alive then
				table.remove(effects, i)
			end
		end
	end)
end

local function blob(name: string, size: Vector3, color: Color3, transparency: number): Part
	local part = Shapes.ellipsoid(name, size, color, folder())
	part.Transparency = transparency
	part.CastShadow = false
	return part
end

-- Flying droplets that stretch along their path.
local function droplets(position: Vector3, scale: number)
	local S = Config.Splash
	local gravity = Config.World.Gravity
	for _ = 1, S.Droplets do
		local size = random:NextNumber(S.DropletSize[1], S.DropletSize[2]) * scale
		local angle = random:NextNumber(0, 2 * math.pi)
		local outward = random:NextNumber(2, 8) * scale
		local velocity = Vector3.new(
			math.cos(angle) * outward,
			random:NextNumber(S.DropletSpeed[1], S.DropletSpeed[2]) * math.sqrt(scale),
			math.sin(angle) * outward * 0.4
		)
		local pos = position + Vector3.new(math.cos(angle), 0.2, math.sin(angle) * 0.4) * 0.5 * scale
		local part = blob("Droplet", Vector3.new(size, size * 1.6, size), S.WaterColor, 0.05)
		local age = 0
		run(function(dt)
			age += dt
			velocity -= Vector3.new(0, gravity * dt, 0)
			pos += velocity * dt
			if pos.Y < Config.World.WaterY and velocity.Y < 0 then
				part:Destroy()
				return false
			end
			local stretch = 1 + math.min(velocity.Magnitude / 30, 0.8)
			part.Size = Vector3.new(size, size * stretch, size)
			part.CFrame = Shapes.alongY(pos, velocity)
			return true
		end)
	end
end

-- A ring of foam blobs spreading out on the water.
local function ring(position: Vector3, scale: number, blobs: number, fromRadius: number, toRadius: number, duration: number, blobSize: number)
	local parts = {}
	for i = 1, blobs do
		parts[i] = blob("Foam", Vector3.one, Config.Splash.FoamColor, 0)
	end
	local age = 0
	run(function(dt)
		age += dt
		local p = math.min(age / duration, 1)
		local eased = 1 - (1 - p) ^ 3
		local radius = (fromRadius + (toRadius - fromRadius) * eased) * scale
		local size = blobSize * scale * (1 - 0.6 * p)
		for i, part in parts do
			local a = (i / blobs) * 2 * math.pi
			part.Size = Vector3.new(size, size * 0.45, size)
			part.Transparency = p ^ 1.5
			part.CFrame = CFrame.new(position + Vector3.new(math.cos(a) * radius, 0.05, math.sin(a) * radius))
		end
		if p >= 1 then
			for _, part in parts do
				part:Destroy()
			end
			return false
		end
		return true
	end)
end

-- The tall cartoon column of water that shoots up and falls back.
local function column(position: Vector3, scale: number)
	local S = Config.Splash
	local part = blob("Column", Vector3.one, S.WaterColor, 0.1)
	local age = 0
	run(function(dt)
		age += dt
		local p = math.min(age / S.ColumnTime, 1)
		local height = math.max(S.ColumnHeight * scale * math.sin(math.pi * p), 0.05)
		local width = (0.9 + 0.9 * p) * scale
		part.Size = Vector3.new(width, height, width * 0.8)
		part.CFrame = CFrame.new(position + Vector3.new(0, height / 2 - 0.2, 0))
		part.Transparency = 0.1 + 0.5 * p
		if p >= 1 then
			part:Destroy()
			return false
		end
		return true
	end)
end

-- A puff of spray using Roblox particles.
local function spray(position: Vector3, scale: number)
	local holder = Shapes.carrier("Spray", Vector3.one, folder())
	holder.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(6 * scale, 13 * scale)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5 * scale),
		NumberSequenceKeypoint.new(1, 1.3 * scale),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Color = ColorSequence.new(Config.Splash.FoamColor, Config.Splash.WaterColor)
	emitter.LightEmission = 0.2
	emitter.Parent = holder
	emitter:Emit(24)
	task.delay(1.5, function()
		holder:Destroy()
	end)
end

-- The big splash when a kid hits the water.
function Splash.play(position: Vector3, scale: number?)
	local s = scale or 1
	local S = Config.Splash
	local surface = Vector3.new(position.X, Config.World.WaterY, position.Z)
	column(surface, s)
	droplets(surface, s)
	ring(surface, s, S.RingBlobs, S.RingStartRadius, S.RingEndRadius, S.RingTime, 0.75)
	ring(surface, s * 0.6, math.floor(S.RingBlobs * 0.7), S.RingStartRadius, S.RingEndRadius, S.RingTime * 1.3, 0.6)
	spray(surface, s)
end

-- A small ring on the water, for kids bobbing about.
function Splash.ripple(position: Vector3, scale: number?)
	local surface = Vector3.new(position.X, Config.World.WaterY, position.Z)
	ring(surface, scale or 1, 14, 0.8, 2.4, 0.9, 0.32)
end

-- Bubbles popping on the surface while a kid sinks.
function Splash.bubbles(position: Vector3, count: number, scale: number?)
	local s = scale or 1
	for _ = 1, count do
		local offset = Vector3.new(random:NextNumber(-0.8, 0.8), 0, random:NextNumber(-0.5, 0.5)) * s
		local pos = Vector3.new(position.X, Config.World.WaterY, position.Z) + offset
		local maxSize = random:NextNumber(0.25, 0.5) * s
		local part = blob("Bubble", Vector3.one * 0.05, Config.Splash.FoamColor, 0.25)
		local age, life = 0, random:NextNumber(0.25, 0.45)
		run(function(dt)
			age += dt
			local p = math.min(age / life, 1)
			local size = math.max(maxSize * math.sin(p * math.pi * 0.5), 0.05)
			part.Size = Vector3.new(size, size * 0.8, size)
			part.CFrame = CFrame.new(pos + Vector3.new(0, size * 0.2, 0))
			if p >= 1 then
				part:Destroy()
				return false
			end
			return true
		end)
	end
end

return Splash
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Showcase</string>
            <string name="Source"><![CDATA[--!strict
-- Milestone 1 test stage: the whole cast stands on a dock so you can look
-- closely at them, try every expression and move, and dress them up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Outfits = require(ReplicatedStorage.Shared.Data.Outfits)
local Characters = require(ReplicatedStorage.Shared.Data.Characters)
local CharacterBuilder = require(ReplicatedStorage.Shared.Character.CharacterBuilder)
local KidAnimator = require(script.Parent.Animation.KidAnimator)
local CameraRig = require(script.Parent.CameraRig)
local Stage = require(script.Stage)
local ShowcaseUI = require(script.ShowcaseUI)

type Entry = {
	id: string,
	name: string,
	outfit: Outfits.Outfit,
	original: Outfits.Outfit,
	home: Vector3,
	kid: CharacterBuilder.Kid?,
	animator: KidAnimator.Animator?,
	tag: TextLabel?,
}

local Showcase = {}

local SPACING = 4.4
local random = Random.new()

local entries: { Entry } = {}
local selected = 0 -- 0 = everyone
local closeUp = false
local spinning = false
local stage: Folder
local ui: ShowcaseUI.UI

local function targets(): { Entry }
	if selected == 0 then
		return entries
	end
	return { entries[selected] }
end

local function refreshTags()
	for i, entry in entries do
		local tag = entry.tag
		if tag then
			local isSelected = i == selected
			tag.Text = if isSelected then "v " .. entry.name .. " v" else entry.name
			tag.TextColor3 = if isSelected then Color3.fromRGB(255, 214, 58) else Color3.new(1, 1, 1)
			tag.Visible = not closeUp
		end
	end
end

local function spawnKid(entry: Entry)
	if entry.animator then
		entry.animator:Destroy()
	end
	if entry.kid then
		entry.kid.Model:Destroy()
	end
	local kid = CharacterBuilder.build(entry.outfit, CFrame.new(entry.home), { name = entry.name, parent = stage :: Instance })
	local animator = KidAnimator.new(kid, { home = entry.home, facing = 1 })
	animator.Turntable = spinning and (selected == 0 or entries[selected] == entry)
	animator.OnGone = function()
		task.delay(1.0, function()
			if entry.animator == animator then
				animator:DropIn()
			end
		end)
	end
	entry.kid = kid
	entry.animator = animator

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NameTag"
	billboard.Adornee = kid.Root
	billboard.Size = UDim2.fromOffset(170, 30)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, kid.Dims.height + 1.7, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Parent = kid.Model
	local tag = Instance.new("TextLabel")
	tag.Size = UDim2.fromScale(1, 1)
	tag.BackgroundTransparency = 1
	tag.Font = Enum.Font.FredokaOne
	tag.TextSize = 22
	tag.TextColor3 = Color3.new(1, 1, 1)
	tag.TextStrokeColor3 = Color3.fromRGB(34, 22, 36)
	tag.TextStrokeTransparency = 0
	tag.Parent = billboard
	entry.tag = tag
	refreshTags()
end

------------------------------------------------------------------------
-- Wardrobe

local function cycle(list: { string }, current: string?, step: number): string
	local index = table.find(list, current or "") or 0
	return list[(index - 1 + step) % #list + 1]
end

local function ids(list: { Outfits.CatalogItem }): { string }
	local out = {}
	for _, item in list do
		table.insert(out, item.id)
	end
	return out
end

local function nameOf(list: { Outfits.CatalogItem }, id: string?): string
	local item = Outfits.find(list, id or "None")
	return if item then item.name else (id or "-")
end

local function colorName(value: Outfits.ColorRef?): string
	return if type(value) == "string" then value else "-"
end

local function onOff(value: any): string
	return if value then "On" else "Off"
end

local function wardrobeValues(outfit: Outfits.Outfit): { [string]: string }
	return {
		Skin = colorName(outfit.skin),
		Hair = nameOf(Outfits.HairStyles, outfit.hair.style),
		["Hair color"] = colorName(outfit.hair.color),
		Hat = nameOf(Outfits.Hats, if outfit.hat then outfit.hat.style else "None"),
		Top = nameOf(Outfits.Tops, outfit.top.style),
		["Top color"] = if outfit.top.style == "None" then "-" else colorName(outfit.top.color),
		Bottom = nameOf(Outfits.Bottoms, outfit.bottom.style),
		["Bottom color"] = colorName(outfit.bottom.color),
		Shoes = nameOf(Outfits.Shoes, outfit.shoes.style),
		["Shoe color"] = if outfit.shoes.style == "Bare" then "-" else colorName(outfit.shoes.color),
		Cape = onOff(outfit.cape),
		Goggles = onOff(outfit.goggles),
		["Life ring"] = onOff(outfit.lifeRing),
		Mask = onOff(outfit.mask),
	}
end

local function catalogPiece(list: { Outfits.CatalogItem }, id: string, color: Outfits.ColorRef?): Outfits.Piece
	local item = Outfits.find(list, id)
	return {
		style = id,
		color = (item and item.color) or color,
		accent = item and item.accent,
	}
end

local function randomFrom(list: { string }): string
	return list[random:NextInteger(1, #list)]
end

local function randomOutfit(): Outfits.Outfit
	local hat = randomFrom(ids(Outfits.Hats))
	local top = randomFrom(ids(Outfits.Tops))
	return {
		skin = randomFrom(Outfits.SkinTones),
		hair = { style = randomFrom(ids(Outfits.HairStyles)), color = randomFrom(Outfits.HairColors) },
		hat = if hat == "None" then nil else catalogPiece(Outfits.Hats, hat),
		top = { style = top, color = randomFrom(Outfits.ClothColors), accent = randomFrom(Outfits.ClothColors) },
		bottom = { style = randomFrom(ids(Outfits.Bottoms)), color = randomFrom(Outfits.ClothColors) },
		shoes = { style = randomFrom(ids(Outfits.Shoes)), color = randomFrom(Outfits.ClothColors) },
		cape = if random:NextNumber() < 0.25 then { style = "Cape", color = randomFrom(Outfits.ClothColors) } else nil,
		goggles = if random:NextNumber() < 0.25 then { style = "Goggles" } else nil,
		lifeRing = if random:NextNumber() < 0.2 then { style = "LifeRing" } else nil,
		mask = if random:NextNumber() < 0.15 then randomFrom(Outfits.ClothColors) else nil,
	}
end

local function changeOutfit(entry: Entry, field: string, step: number)
	local o = entry.outfit
	if field == "Random" then
		local fresh = randomOutfit()
		fresh.proportions = o.proportions
		fresh.emblem = o.emblem
		entry.outfit = fresh
	elseif field == "Reset" then
		entry.outfit = Outfits.copy(entry.original)
	elseif field == "Skin" then
		o.skin = cycle(Outfits.SkinTones, colorName(o.skin), step)
	elseif field == "Hair" then
		o.hair.style = cycle(ids(Outfits.HairStyles), o.hair.style, step)
	elseif field == "Hair color" then
		o.hair.color = cycle(Outfits.HairColors, colorName(o.hair.color), step)
	elseif field == "Hat" then
		local id = cycle(ids(Outfits.Hats), if o.hat then o.hat.style else "None", step)
		o.hat = if id == "None" then nil else catalogPiece(Outfits.Hats, id)
	elseif field == "Top" then
		o.top.style = cycle(ids(Outfits.Tops), o.top.style, step)
		o.top.color = o.top.color or "White"
	elseif field == "Top color" then
		o.top.color = cycle(Outfits.ClothColors, colorName(o.top.color), step)
	elseif field == "Bottom" then
		o.bottom.style = cycle(ids(Outfits.Bottoms), o.bottom.style, step)
	elseif field == "Bottom color" then
		o.bottom.color = cycle(Outfits.ClothColors, colorName(o.bottom.color), step)
	elseif field == "Shoes" then
		o.shoes.style = cycle(ids(Outfits.Shoes), o.shoes.style, step)
		o.shoes.color = o.shoes.color or "Red"
	elseif field == "Shoe color" then
		o.shoes.color = cycle(Outfits.ClothColors, colorName(o.shoes.color), step)
	elseif field == "Cape" then
		o.cape = if o.cape then nil else { style = "Cape", color = "Red", accent = "Sunny" }
	elseif field == "Goggles" then
		o.goggles = if o.goggles then nil else { style = "Goggles", color = "Glass", accent = "Aqua" }
	elseif field == "Life ring" then
		o.lifeRing = if o.lifeRing then nil else { style = "LifeRing", color = "Red", accent = "White" }
	elseif field == "Mask" then
		o.mask = if o.mask then nil else "Red"
	end
	spawnKid(entry)
	ui.setWardrobe(wardrobeValues(entry.outfit))
end

------------------------------------------------------------------------
-- Moves

local function doMove(move: string)
	local list = targets()
	if move == "Aim" then
		local anyIdle = false
		for _, entry in list do
			if entry.animator and entry.animator.State ~= "Aim" then
				anyIdle = true
			end
		end
		for _, entry in list do
			if entry.animator then
				entry.animator:Aim(anyIdle)
			end
		end
	elseif move == "Throw" then
		for _, entry in list do
			local animator = entry.animator
			if animator and animator:IsStanding() then
				if animator.State == "Aim" then
					animator:Fire()
				else
					animator:Aim(true)
					task.delay(0.4, function()
						animator:Fire()
					end)
				end
			end
		end
	elseif move == "Hit" then
		for _, entry in list do
			if entry.animator then
				entry.animator:Hit(1)
			end
		end
	elseif move == "Knock" then
		for i, entry in list do
			local animator = entry.animator
			if animator and animator:IsStanding() then
				task.delay((i - 1) * 0.15, function()
					animator:Hit(1)
					task.wait(0.12)
					local landX = Stage.DockLeft - 3 - random:NextNumber(0, 4)
					animator:Knock(animator:LaunchVelocity(landX, random:NextNumber(17, 22)))
				end)
			end
		end
	elseif move == "Win" then
		local anyIdle = false
		for _, entry in list do
			if entry.animator and entry.animator.State ~= "Win" then
				anyIdle = true
			end
		end
		for _, entry in list do
			if entry.animator then
				entry.animator:Win(anyIdle)
			end
		end
	elseif move == "Reset" then
		for _, entry in list do
			if entry.animator then
				entry.animator:Reset()
			end
		end
	end
end

------------------------------------------------------------------------
-- Camera

local function updateCamera()
	if closeUp and selected > 0 then
		local entry = entries[selected]
		local kid, animator = entry.kid, entry.animator
		if kid and animator then
			local position = if animator.State == "Gone" then entry.home else kid.Root.CFrame.Position
			local height = kid.Dims.height
			CameraRig.frame(Vector3.new(position.X, position.Y + height * 0.55, 0), height * 0.55, height * 0.68)
			return
		end
	end
	local left, right = Stage.DockLeft - 8, Stage.DockRight + 5
	CameraRig.frame(Vector3.new((left + right) / 2, Stage.DockY + 2.8, 0), (right - left) / 2, 6)
end

------------------------------------------------------------------------

function Showcase.start()
	stage = Stage.build()
	CameraRig.start()

	local lineup = {
		Characters.Extras[1],
		Characters.Extras[2],
		Characters.Heroes[2],
		Characters.Heroes[1],
		Characters.Extras[3],
		Characters.Extras[4],
		Characters.Extras[5],
	}
	local names = {}
	for i, character in lineup do
		local x = (i - (#lineup + 1) / 2) * SPACING
		local entry: Entry = {
			id = character.id,
			name = character.name,
			outfit = Outfits.copy(character.outfit),
			original = Outfits.copy(character.outfit),
			home = Vector3.new(x, Stage.DockY, 0),
			kid = nil,
			animator = nil,
			tag = nil,
		}
		table.insert(entries, entry)
		table.insert(names, character.name)
	end

	ui = ShowcaseUI.build(names, {
		select = function(index)
			selected = index
			ui.setSelected(index)
			ui.setWardrobe(if index > 0 then wardrobeValues(entries[index].outfit) else nil)
			for i, entry in entries do
				if entry.animator then
					entry.animator.Turntable = spinning and (index == 0 or i == index)
					if not entry.animator.Turntable then
						entry.animator.ExtraYaw = 0
					end
				end
			end
			refreshTags()
		end,
		face = function(expression)
			for _, entry in targets() do
				if entry.animator then
					entry.animator:ShowFace(expression)
				end
			end
		end,
		move = doMove,
		toggle = function(name, on)
			if name == "Close-up" then
				closeUp = on
				refreshTags()
			elseif name == "Spin" then
				spinning = on
				for i, entry in entries do
					if entry.animator then
						entry.animator.Turntable = on and (selected == 0 or i == selected)
						if not entry.animator.Turntable then
							entry.animator.ExtraYaw = 0
						end
					end
				end
			end
		end,
		wardrobe = function(field, step)
			if selected > 0 then
				changeOutfit(entries[selected], field, step)
			end
		end,
	})

	for _, entry in entries do
		spawnKid(entry)
	end
	updateCamera()
	RunService.Heartbeat:Connect(updateCamera)
end

return Showcase
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">ShowcaseUI</string>
              <string name="Source"><![CDATA[--!strict
-- On-screen buttons for the test stage: pick a kid, try every face and move,
-- and dress kids up from the wardrobe. Big chunky buttons that work by touch.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Face = require(ReplicatedStorage.Shared.Character.Face)

local ShowcaseUI = {}

export type Callbacks = {
	select: (index: number) -> (), -- 0 = everyone
	face: (expression: string) -> (),
	move: (move: string) -> (),
	toggle: (name: string, on: boolean) -> (),
	wardrobe: (field: string, step: number) -> (),
}

export type UI = {
	gui: ScreenGui,
	setSelected: (index: number) -> (),
	setWardrobe: (values: { [string]: string }?) -> (),
}

ShowcaseUI.WardrobeFields = {
	"Skin",
	"Hair",
	"Hair color",
	"Hat",
	"Top",
	"Top color",
	"Bottom",
	"Bottom color",
	"Shoes",
	"Shoe color",
	"Cape",
	"Goggles",
	"Life ring",
	"Mask",
}

ShowcaseUI.Moves = {
	{ id = "Aim", label = "Aim" },
	{ id = "Throw", label = "Throw!" },
	{ id = "Hit", label = "Get hit" },
	{ id = "Knock", label = "Splash!" },
	{ id = "Win", label = "Win dance" },
	{ id = "Reset", label = "Reset" },
}

local FONT = Enum.Font.FredokaOne
local INK = Color3.fromRGB(34, 22, 36)
local WHITE = Color3.new(1, 1, 1)
local COLORS = {
	tab = Color3.fromRGB(255, 255, 255),
	tabSelected = Color3.fromRGB(255, 214, 58),
	face = Color3.fromRGB(118, 196, 255),
	move = Color3.fromRGB(255, 120, 106),
	toggleOff = Color3.fromRGB(200, 214, 230),
	toggleOn = Color3.fromRGB(132, 232, 170),
	panel = Color3.fromRGB(255, 250, 238),
	arrow = Color3.fromRGB(255, 186, 36),
}
local REFERENCE = Vector2.new(1280, 720) -- layout is designed at this size and scaled

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent: Instance, thickness: number)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = INK
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function label(parent: Instance, text: string, size: UDim2, textSize: number, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = size
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.Text = text
	l.TextSize = textSize
	l.TextColor3 = color or WHITE
	l.TextStrokeColor3 = INK
	l.TextStrokeTransparency = if color then 1 else 0
	l.Parent = parent
	return l
end

local function button(parent: Instance, text: string, size: Vector2, color: Color3, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Name = text
	b.Size = UDim2.fromOffset(size.X, size.Y)
	b.BackgroundColor3 = color
	b.AutoButtonColor = true
	b.Font = FONT
	b.Text = text
	b.TextSize = math.min(24, size.Y * 0.48)
	b.TextColor3 = WHITE
	b.TextStrokeColor3 = INK
	b.TextStrokeTransparency = 0
	b.Parent = parent
	corner(b, math.floor(size.Y * 0.3))
	stroke(b, 3)
	local pop = Instance.new("UIScale")
	pop.Parent = b
	b.Activated:Connect(function()
		pop.Scale = 0.88
		TweenService:Create(pop, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		onClick()
	end)
	return b
end

local function row(parent: Instance, name: string, position: UDim2, anchor: Vector2, padding: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AutomaticSize = Enum.AutomaticSize.XY
	f.Size = UDim2.fromOffset(0, 0)
	f.Position = position
	f.AnchorPoint = anchor
	f.BackgroundTransparency = 1
	f.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, padding)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = f
	return f
end

function ShowcaseUI.build(names: { string }, callbacks: Callbacks): UI
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "ShowcaseUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Everything is laid out for 1280x720 and scaled to fit the screen.
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function fit()
		local camera = workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else REFERENCE
		local s = math.clamp(math.min(viewport.X / REFERENCE.X, viewport.Y / REFERENCE.Y), 0.62, 1.4)
		scale.Scale = s
		root.Size = UDim2.fromOffset(viewport.X / s, viewport.Y / s)
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end

	-- Title
	local title = label(root, Config.GameName, UDim2.fromOffset(300, 40), 34)
	title.Position = UDim2.fromOffset(18, 12)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local subtitle = label(root, "Milestone 1 - meet the kids", UDim2.fromOffset(300, 22), 18)
	subtitle.Position = UDim2.fromOffset(20, 48)
	subtitle.TextXAlignment = Enum.TextXAlignment.Left

	-- Kid tabs
	local tabs = row(root, "Tabs", UDim2.fromOffset(18, 80), Vector2.new(0, 0), 8)
	local tabButtons: { TextButton } = {}
	local allNames = { "Everyone" }
	for _, n in names do
		table.insert(allNames, n)
	end
	for i, n in allNames do
		local b = button(tabs, n, Vector2.new(30 + #n * 12, 42), COLORS.tab, function()
			callbacks.select(i - 1)
		end)
		b.LayoutOrder = i
		b.TextColor3 = INK
		b.TextStrokeTransparency = 1
		tabButtons[i] = b
	end

	-- Faces and moves along the bottom
	local faces = row(root, "Faces", UDim2.new(0.5, 0, 1, -76), Vector2.new(0.5, 1), 8)
	label(faces, "Faces", UDim2.fromOffset(78, 46), 22).LayoutOrder = 0
	for i, expression in Face.ExpressionOrder do
		button(faces, expression, Vector2.new(112, 46), COLORS.face, function()
			callbacks.face(expression)
		end).LayoutOrder = i
	end
	local moves = row(root, "Moves", UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1), 8)
	label(moves, "Moves", UDim2.fromOffset(78, 50), 22).LayoutOrder = 0
	for i, move in ShowcaseUI.Moves do
		button(moves, move.label, Vector2.new(128, 50), COLORS.move, function()
			callbacks.move(move.id)
		end).LayoutOrder = i
	end

	-- Toggles on the right
	local toggles = row(root, "Toggles", UDim2.new(1, -18, 0, 14), Vector2.new(1, 0), 8)
	local wardrobePanel: ScrollingFrame
	for i, name in { "Close-up", "Spin", "Wardrobe" } do
		local on = false
		local b: TextButton
		b = button(toggles, name, Vector2.new(124, 44), COLORS.toggleOff, function()
			on = not on
			b.BackgroundColor3 = if on then COLORS.toggleOn else COLORS.toggleOff
			if name == "Wardrobe" then
				wardrobePanel.Visible = on
			end
			callbacks.toggle(name, on)
		end)
		b.LayoutOrder = i
		b.TextColor3 = INK
		b.TextStrokeTransparency = 1
	end

	-- Wardrobe panel
	wardrobePanel = Instance.new("ScrollingFrame")
	wardrobePanel.Name = "Wardrobe"
	wardrobePanel.Visible = false
	wardrobePanel.AnchorPoint = Vector2.new(1, 0)
	wardrobePanel.Position = UDim2.new(1, -18, 0, 70)
	wardrobePanel.Size = UDim2.new(0, 330, 1, -224)
	wardrobePanel.BackgroundColor3 = COLORS.panel
	wardrobePanel.ScrollBarThickness = 8
	wardrobePanel.ScrollBarImageColor3 = INK
	wardrobePanel.AutomaticCanvasSize = Enum.AutomaticSize.Y
	wardrobePanel.CanvasSize = UDim2.new()
	wardrobePanel.Parent = root
	corner(wardrobePanel, 16)
	stroke(wardrobePanel, 3)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = wardrobePanel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = wardrobePanel

	local hint = label(wardrobePanel, "Pick one kid to dress up!", UDim2.new(1, 0, 0, 40), 20, INK)
	hint.LayoutOrder = 0
	local valueLabels: { [string]: TextLabel } = {}
	local rowsFrames: { Frame } = {}
	for i, field in ShowcaseUI.WardrobeFields do
		local r = Instance.new("Frame")
		r.Name = field
		r.Size = UDim2.new(1, 0, 0, 40)
		r.BackgroundTransparency = 1
		r.LayoutOrder = i
		r.Parent = wardrobePanel
		local name = label(r, field, UDim2.fromOffset(104, 40), 17, INK)
		name.TextXAlignment = Enum.TextXAlignment.Left
		local left = button(r, "<", Vector2.new(36, 36), COLORS.face, function()
			callbacks.wardrobe(field, -1)
		end)
		left.Position = UDim2.fromOffset(104, 2)
		local value = label(r, "-", UDim2.fromOffset(122, 40), 16, INK)
		value.Position = UDim2.fromOffset(142, 0)
		value.TextScaled = false
		value.TextWrapped = true
		valueLabels[field] = value
		local right = button(r, ">", Vector2.new(36, 36), COLORS.face, function()
			callbacks.wardrobe(field, 1)
		end)
		right.Position = UDim2.fromOffset(266, 2)
		table.insert(rowsFrames, r)
	end
	local extras = row(wardrobePanel, "Extras", UDim2.new(), Vector2.new(), 8)
	extras.LayoutOrder = #ShowcaseUI.WardrobeFields + 1
	button(extras, "Random", Vector2.new(140, 42), COLORS.move, function()
		callbacks.wardrobe("Random", 1)
	end)
	button(extras, "Undo all", Vector2.new(140, 42), COLORS.toggleOff, function()
		callbacks.wardrobe("Reset", 1)
	end).TextColor3 = INK

	gui.Parent = player:WaitForChild("PlayerGui")

	local ui: UI = {
		gui = gui,
		setSelected = function(index: number)
			for i, b in tabButtons do
				b.BackgroundColor3 = if i - 1 == index then COLORS.tabSelected else COLORS.tab
			end
		end,
		setWardrobe = function(values: { [string]: string }?)
			hint.Visible = values == nil
			extras.Visible = values ~= nil
			for _, r in rowsFrames do
				r.Visible = values ~= nil
			end
			if values then
				for field, l in valueLabels do
					l.Text = values[field] or "-"
				end
			end
		end,
	}
	ui.setSelected(0)
	ui.setWardrobe(nil)
	return ui
end

return ShowcaseUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Stage</string>
              <string name="Source"><![CDATA[--!strict
-- The milestone 1 test stage: a wooden dock over turquoise water.
-- (The real beach, rafts and sky arrive in milestone 2.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Shapes = require(ReplicatedStorage.Shared.Character.Shapes)

local Stage = {}

Stage.DockY = 1.4 -- height of the dock's deck (kids stand here)
Stage.DockLeft = -16.5
Stage.DockRight = 16.5

local WOOD = {
	Color3.fromRGB(205, 150, 94),
	Color3.fromRGB(188, 134, 82),
	Color3.fromRGB(214, 160, 104),
}
local DARK_WOOD = Color3.fromRGB(140, 92, 56)
local ROPE = Color3.fromRGB(236, 210, 150)

local function cylinder(name: string, length: number, diameter: number, color: Color3, cf: CFrame, parent: Instance): Part
	local part = Shapes.block(name, Vector3.new(length, diameter, diameter), color, parent)
	part.Shape = Enum.PartType.Cylinder
	part.CFrame = cf
	return part
end

function Stage.build(): Folder
	local folder = Instance.new("Folder")
	folder.Name = "TestStage"

	local water = Shapes.block("Water", Vector3.new(1200, 2, 1200), Color3.fromRGB(52, 196, 214), folder)
	water.CFrame = CFrame.new(0, Config.World.WaterY - 1, 0)
	water.CastShadow = false

	local length = Stage.DockRight - Stage.DockLeft
	local middle = (Stage.DockLeft + Stage.DockRight) / 2
	for i, z in { -2.1, 0, 2.1 } do
		local board = Shapes.block("Board", Vector3.new(length, 0.5, 1.95), WOOD[i], folder)
		board.CFrame = CFrame.new(middle, Stage.DockY - 0.25, z)
	end
	local beam = Shapes.block("Beam", Vector3.new(length + 0.4, 0.7, 0.5), DARK_WOOD, folder)
	beam.CFrame = CFrame.new(middle, Stage.DockY - 0.85, 3.05)

	-- Posts with rounded caps and a rope wrap.
	local posts = 7
	for i = 0, posts - 1 do
		local x = Stage.DockLeft + 0.3 + (length - 0.6) * i / (posts - 1)
		for _, z in { 3.3, -3.3 } do
			local top = Stage.DockY + 0.6
			local bottom = Config.World.WaterY - 4
			cylinder("Post", top - bottom, 0.9, DARK_WOOD, CFrame.new(x, (top + bottom) / 2, z) * CFrame.Angles(0, 0, math.rad(90)), folder)
			local cap = Shapes.ellipsoid("PostCap", Vector3.new(0.9, 0.45, 0.9), DARK_WOOD, folder)
			cap.CFrame = CFrame.new(x, top, z)
			cylinder("Rope", 0.3, 1.0, ROPE, CFrame.new(x, top - 0.5, z) * CFrame.Angles(0, 0, math.rad(90)), folder)
		end
	end

	-- A little sign standing in the water past the end of the dock.
	local signX = Stage.DockRight + 2.4
	local sign = Shapes.block("Sign", Vector3.new(4.2, 1.4, 0.25), Color3.fromRGB(250, 236, 200), folder)
	sign.CFrame = CFrame.new(signX, Stage.DockY + 1.9, 0) * CFrame.Angles(0, math.rad(-12), 0)
	for _, dx in { -1.5, 1.5 } do
		local bottom = Config.World.WaterY - 3
		local top = Stage.DockY + 1.9
		cylinder(
			"SignPost",
			top - bottom,
			0.3,
			DARK_WOOD,
			CFrame.new(signX + dx, (top + bottom) / 2, -0.2) * CFrame.Angles(0, 0, math.rad(90)),
			folder
		)
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- the side facing the camera (+Z)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.5
	gui.Parent = sign
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.Text = Config.GameName
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(255, 120, 96)
	text.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = text

	folder.Parent = workspace
	return folder
end

return Stage
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="36">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>