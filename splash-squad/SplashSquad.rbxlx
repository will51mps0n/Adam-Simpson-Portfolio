        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[--!strict
-- The kids. Each one is just an outfit (see Data/Outfits.luau), so you can
-- restyle anyone by editing this table.

local Outfits = require(script.Parent.Outfits)

export type Character = {
	id: string,
	name: string,
	blurb: string,
	outfit: Outfits.Outfit,
}

local Characters = {}

-- The two hero kids for solo play.
Characters.Heroes = {
	{
		id = "Pip",
		name = "Pip",
		blurb = "Small, brave, and always in swim trunks.",
		outfit = {
			skin = "Peach",
			hair = { style = "Spiky", color = "Chestnut" },
			top = { style = "None" },
			bottom = { style = "Trunks", color = "Coral", accent = "White" },
			shoes = { style = "Bare" },
			goggles = { style = "Goggles", color = "Glass", accent = "Aqua" },
			proportions = { scale = 0.9 },
		},
	},
	{
		id = "Max",
		name = "Captain Max",
		blurb = "Pip's big sibling, in a homemade superhero costume.",
		outfit = {
			skin = "Peach",
			hair = { style = "BowlCut", color = "Chestnut" },
			top = { style = "Suit", color = "Royal", accent = "Sunny" },
			bottom = { style = "Trunks", color = "Red", accent = "Red" },
			shoes = { style = "Boots", color = "Red" },
			cape = { style = "Cape", color = "Red", accent = "Sunny" },
			mask = "Red",
			emblem = { letter = "M", color = "Sunny", ink = "Red" },
			proportions = { scale = 1.06, bodyStretch = 1.2, headScale = 0.96 },
		},
	},
} :: { Character }

-- Extra kids that show off the outfit system on the test stage.
Characters.Extras = {
	{
		id = "Polly",
		name = "Polly",
		blurb = "Pirate fan.",
		outfit = {
			skin = "Honey",
			hair = { style = "Ponytail", color = "Ginger" },
			hat = { style = "Tricorn", color = "Charcoal", accent = "Gold" },
			top = { style = "Stripes", color = "White", accent = "Red" },
			bottom = { style = "Shorts", color = "Navy" },
			shoes = { style = "Sneakers", color = "Red", accent = "White" },
		},
	},
	{
		id = "Bjorn",
		name = "Bjorn",
		blurb = "Tiny Viking.",
		outfit = {
			skin = "Rosy",
			hair = { style = "Curly", color = "Blond" },
			hat = { style = "VikingHorns", color = "Steel", accent = "Gold" },
			top = { style = "Tee", color = "Grass" },
			bottom = { style = "Pants", color = "Brown" },
			shoes = { style = "Boots", color = "Brown" },
		},
	},
	{
		id = "Kai",
		name = "Kai",
		blurb = "Never without a life ring.",
		outfit = {
			skin = "Caramel",
			hair = { style = "Spiky", color = "Ink" },
			hat = { style = "Cap", color = "Royal", accent = "White" },
			top = { style = "Tee", color = "Tangerine" },
			bottom = { style = "Trunks", color = "Aqua", accent = "White" },
			shoes = { style = "Sneakers", color = "Sky", accent = "White" },
			lifeRing = { style = "LifeRing", color = "Red", accent = "White" },
		},
	},
	{
		id = "Rae",
		name = "Rae",
		blurb = "Beach royalty.",
		outfit = {
			skin = "Cocoa",
			hair = { style = "Ponytail", color = "Lilac" },
			hat = { style = "Crown", color = "Gold", accent = "Red" },
			top = { style = "Tee", color = "Lavender" },
			bottom = { style = "Shorts", color = "Pink" },
			shoes = { style = "Sneakers", color = "White", accent = "Pink" },
		},
	},
	{
		id = "Mo",
		name = "Mo",
		blurb = "Flower power.",
		outfit = {
			skin = "Espresso",
			hair = { style = "Curly", color = "Ink" },
			hat = { style = "Flower", color = "Pink", accent = "Sunny" },
			top = { style = "Tee", color = "Mint" },
			bottom = { style = "Trunks", color = "Coral", accent = "White" },
			shoes = { style = "Bare" },
		},
	},
} :: { Character }

function Characters.get(id: string): Character?
	for _, list in { Characters.Heroes, Characters.Extras } do
		for _, character in list do
			if character.id == id then
				return character
			end
		end
	end
	return nil
end

return Characters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Outfits</string>
            <string name="Source"><![CDATA[--!strict
-- The wardrobe: every hair style, hat, top, bottom, shoe and accessory a kid can wear.
-- To add a new color option, add it to Palette and list it here.
-- To add a new hair style or hat, add an entry here and a matching builder
-- in Character/Hair.luau or Character/Hats.luau.

local Outfits = {}

export type ColorRef = string | Color3

export type Piece = {
	style: string,
	color: ColorRef?,
	accent: ColorRef?,
}

export type Outfit = {
	skin: ColorRef,
	hair: Piece,
	hat: Piece?,
	top: Piece,
	bottom: Piece,
	shoes: Piece,
	cape: Piece?, -- style is ignored, color = cape, accent = knot
	goggles: Piece?, -- color = lenses, accent = strap
	lifeRing: Piece?, -- color = ring, accent = stripes
	mask: ColorRef?, -- superhero eye mask drawn on the face
	emblem: { letter: string, color: ColorRef?, ink: ColorRef? }?,
	proportions: {
		scale: number?, -- overall size (1 = normal)
		bodyStretch: number?, -- taller body and legs
		headScale: number?,
	}?,
}

export type CatalogItem = {
	id: string,
	name: string,
	price: number,
	color: ColorRef?,
	accent: ColorRef?,
}

Outfits.HairStyles = {
	{ id = "Spiky", name = "Spiky", price = 0 },
	{ id = "BowlCut", name = "Bowl Cut", price = 0 },
	{ id = "Ponytail", name = "Ponytail", price = 40 },
	{ id = "Curly", name = "Curly", price = 40 },
} :: { CatalogItem }

Outfits.Hats = {
	{ id = "None", name = "No Hat", price = 0 },
	{ id = "Tricorn", name = "Pirate Hat", price = 150, color = "Charcoal", accent = "Gold" },
	{ id = "VikingHorns", name = "Viking Helmet", price = 200, color = "Steel", accent = "Gold" },
	{ id = "Cap", name = "Sporty Cap", price = 80, color = "Royal", accent = "White" },
	{ id = "Crown", name = "Tiny Crown", price = 300, color = "Gold", accent = "Red" },
	{ id = "Flower", name = "Hair Flower", price = 60, color = "Pink", accent = "Sunny" },
} :: { CatalogItem }

Outfits.Tops = {
	{ id = "None", name = "No Shirt", price = 0 },
	{ id = "Tee", name = "T-Shirt", price = 0 },
	{ id = "Stripes", name = "Sailor Stripes", price = 60, accent = "Red" },
	{ id = "Suit", name = "Hero Suit", price = 250, accent = "Sunny" },
} :: { CatalogItem }

Outfits.Bottoms = {
	{ id = "Trunks", name = "Swim Trunks", price = 0, accent = "White" },
	{ id = "Shorts", name = "Shorts", price = 0 },
	{ id = "Pants", name = "Long Pants", price = 40 },
} :: { CatalogItem }

Outfits.Shoes = {
	{ id = "Bare", name = "Bare Feet", price = 0 },
	{ id = "Sneakers", name = "Sneakers", price = 50, accent = "White" },
	{ id = "Boots", name = "Boots", price = 80 },
} :: { CatalogItem }

Outfits.Accessories = {
	{ id = "Cape", name = "Towel Cape", price = 200, color = "Red", accent = "Sunny" },
	{ id = "Goggles", name = "Swim Goggles", price = 70, color = "Glass", accent = "Aqua" },
	{ id = "LifeRing", name = "Life Ring", price = 90, color = "Red", accent = "White" },
	{ id = "Mask", name = "Hero Mask", price = 120, color = "Red" },
} :: { CatalogItem }

-- Color choices offered in the wardrobe.
Outfits.SkinTones = { "Peach", "Rosy", "Honey", "Caramel", "Cocoa", "Espresso" }
Outfits.HairColors = { "Chestnut", "Ginger", "Blond", "Ink", "Mocha", "Bubblegum", "Lilac", "Seafoam" }
Outfits.ClothColors = {
	"White",
	"Navy",
	"Royal",
	"Sky",
	"Aqua",
	"Mint",
	"Grass",
	"Sunny",
	"Tangerine",
	"Coral",
	"Red",
	"Pink",
	"Lavender",
	"Grape",
	"Brown",
	"Charcoal",
}

function Outfits.find(list: { CatalogItem }, id: string): CatalogItem?
	for _, item in list do
		if item.id == id then
			return item
		end
	end
	return nil
end

-- Deep copy, so editing one kid's outfit never changes another's.
function Outfits.copy(outfit: Outfit): Outfit
	local function deep(value: any): any
		if type(value) ~= "table" then
			return value
		end
		local out = {}
		for k, v in value do
			out[k] = deep(v)
		end
		return out
	end
	return deep(outfit)
end

return Outfits
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Palette</string>
            <string name="Source"><![CDATA[--!strict
-- Named colors used by outfits and characters.
-- Outfit data refers to colors by these names (e.g. "Coral"), so you can
-- retune a color here and every kid using it updates.

local Palette = {}

Palette.Skin = {
	Peach = Color3.fromRGB(255, 214, 186),
	Rosy = Color3.fromRGB(250, 196, 170),
	Honey = Color3.fromRGB(232, 178, 128),
	Caramel = Color3.fromRGB(196, 138, 92),
	Cocoa = Color3.fromRGB(150, 100, 68),
	Espresso = Color3.fromRGB(112, 74, 52),
}

Palette.Hair = {
	Chestnut = Color3.fromRGB(122, 74, 44),
	Ginger = Color3.fromRGB(226, 112, 46),
	Blond = Color3.fromRGB(250, 206, 96),
	Ink = Color3.fromRGB(46, 40, 52),
	Mocha = Color3.fromRGB(86, 56, 40),
	Bubblegum = Color3.fromRGB(255, 130, 186),
	Lilac = Color3.fromRGB(170, 132, 236),
	Seafoam = Color3.fromRGB(96, 214, 182),
}

-- Clothes, hats, rafts and anything else.
Palette.Cloth = {
	White = Color3.fromRGB(250, 250, 248),
	Cream = Color3.fromRGB(246, 234, 204),
	Charcoal = Color3.fromRGB(52, 50, 62),
	Navy = Color3.fromRGB(38, 62, 140),
	Royal = Color3.fromRGB(52, 108, 230),
	Sky = Color3.fromRGB(118, 196, 255),
	Aqua = Color3.fromRGB(64, 214, 222),
	Mint = Color3.fromRGB(132, 232, 170),
	Grass = Color3.fromRGB(86, 192, 86),
	Leaf = Color3.fromRGB(46, 140, 82),
	Sunny = Color3.fromRGB(255, 214, 58),
	Gold = Color3.fromRGB(255, 186, 36),
	Tangerine = Color3.fromRGB(255, 140, 40),
	Coral = Color3.fromRGB(255, 106, 96),
	Red = Color3.fromRGB(230, 54, 60),
	Cherry = Color3.fromRGB(196, 30, 58),
	Pink = Color3.fromRGB(255, 150, 196),
	Lavender = Color3.fromRGB(176, 146, 240),
	Grape = Color3.fromRGB(122, 74, 196),
	Brown = Color3.fromRGB(128, 82, 52),
	Tan = Color3.fromRGB(214, 170, 114),
	Steel = Color3.fromRGB(168, 178, 192),
	Horn = Color3.fromRGB(246, 236, 206),
	Glass = Color3.fromRGB(120, 220, 255),
}

-- Face drawing colors.
Palette.Face = {
	Eye = Color3.fromRGB(38, 30, 52),
	Shine = Color3.fromRGB(255, 255, 255),
	Brow = Color3.fromRGB(58, 40, 40),
	Blush = Color3.fromRGB(255, 120, 150),
	MouthLine = Color3.fromRGB(70, 34, 40),
	MouthInside = Color3.fromRGB(120, 30, 46),
	Tongue = Color3.fromRGB(255, 120, 136),
	Teeth = Color3.fromRGB(255, 255, 255),
	Tear = Color3.fromRGB(130, 210, 255),
}

-- Every color name must be unique across the tables above.
do
	local seen = {}
	local groups: { { [string]: Color3 } } = { Palette.Skin, Palette.Hair, Palette.Cloth, Palette.Face }
	for _, group in groups do
		for name in group do
			if seen[name] then
				warn(`[Palette] Color name "{name}" is used twice; rename one of them`)
			end
			seen[name] = true
		end
	end
end

-- Look up a color by name in any of the tables above, or pass a Color3 through.
function Palette.resolve(value: string | Color3 | nil, fallback: Color3?): Color3
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "string" then
		local found = Palette.Cloth[value] or Palette.Hair[value] or Palette.Skin[value] or Palette.Face[value]
		if found then
			return found
		end
		warn(`[Palette] Unknown color name "{value}"`)
	end
	return fallback or Color3.fromRGB(255, 0, 255)
end

return Palette
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="21">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server entry point. For now (milestone 1) it only sets up the sunny lighting;
-- the match logic arrives in later milestones.

local Players = game:GetService("Players")

local LightingSetup = require(script.LightingSetup)

-- Players don't walk around: each kid is a model the game builds and places.
Players.CharacterAutoLoads = false

LightingSetup.apply()
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">LightingSetup</string>
          <string name="Source"><![CDATA[--!strict
-- Sunny beach lighting: warm sun, soft shadows, a little extra color.
-- All values come from Config.Lighting.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local LightingSetup = {}

local function effect<T>(className: string, name: string): T
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing :: any
	end
	local created = Instance.new(className :: any)
	created.Name = name
	created.Parent = Lighting
	return created :: any
end

function LightingSetup.apply()
	local L = Config.Lighting
	Lighting.ClockTime = L.ClockTime
	Lighting.GeographicLatitude = L.GeographicLatitude
	Lighting.Brightness = L.Brightness
	Lighting.Ambient = L.Ambient
	Lighting.OutdoorAmbient = L.OutdoorAmbient
	Lighting.ShadowSoftness = L.ShadowSoftness
	Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
	Lighting.ExposureCompensation = L.ExposureCompensation
	Lighting.GlobalShadows = true

	local colorCorrection = effect("ColorCorrectionEffect", "SunnyColor") :: ColorCorrectionEffect
	colorCorrection.Saturation = L.ColorCorrection.Saturation
	colorCorrection.Contrast = L.ColorCorrection.Contrast
	colorCorrection.Brightness = L.ColorCorrection.Brightness
	colorCorrection.TintColor = L.ColorCorrection.TintColor

	local bloom = effect("BloomEffect", "SoftBloom") :: BloomEffect
	bloom.Intensity = L.Bloom.Intensity
	bloom.Size = L.Bloom.Size
	bloom.Threshold = L.Bloom.Threshold

	local atmosphere = effect("Atmosphere", "BeachAir") :: Atmosphere
	atmosphere.Density = L.Atmosphere.Density
	atmosphere.Offset = L.Atmosphere.Offset
	atmosphere.Color = L.Atmosphere.Color
	atmosphere.Decay = L.Atmosphere.Decay
	atmosphere.Glare = L.Atmosphere.Glare
	atmosphere.Haze = L.Atmosphere.Haze
end

return LightingSetup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="23">
