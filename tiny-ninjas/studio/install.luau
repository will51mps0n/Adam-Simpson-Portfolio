	[[
--!strict
-- Reads a level's ASCII tile grid and answers "which tile shape is at (x, y)?".
-- x counts columns from 0 at the left, y counts rows from 0 at the top.
-- Anything outside the grid counts as a full block, so every level is walled in.

local TileShapes = require(script.Parent.TileShapes)

export type Grid = {
	levelId: string,
	width: number,
	height: number,
	cells: { { TileShapes.Shape } }, -- cells[y + 1][x + 1]
}

local LevelGrid = {}

function LevelGrid.parse(text: string, levelId: string): Grid
	-- One row per line. Spaces, tabs and blank lines are ignored, so grids can be indented.
	local rows = {}
	for line in string.gmatch(text, "[^\n]+") do
		local row = string.gsub(line, "%s", "")
		if row ~= "" then
			table.insert(rows, row)
		end
	end
	if #rows == 0 then
		error(`Level "{levelId}" has an empty grid`)
	end

	local width = #rows[1]
	local cells = {}
	for y, row in rows do
		if #row ~= width then
			error(`Level "{levelId}": row {y - 1} is {#row} tiles wide but row 0 is {width}`)
		end
		local line = table.create(width)
		for x = 1, width do
			local char = string.sub(row, x, x)
			local s = TileShapes.byChar[char]
			if not s then
				error(`Level "{levelId}": unknown tile '{char}' at column {x - 1}, row {y - 1}`)
			end
			line[x] = s
		end
		cells[y] = line
	end

	return { levelId = levelId, width = width, height = #rows, cells = cells }
end

function LevelGrid.shapeAt(grid: Grid, x: number, y: number): TileShapes.Shape
	if x < 0 or y < 0 or x >= grid.width or y >= grid.height then
		return TileShapes.FULL
	end
	return grid.cells[y + 1][x + 1]
end

return LevelGrid
]],
	[[
--!strict
-- All built-in levels. Each level is a ModuleScript in this folder that returns a LevelDef.
--
-- A level is an ASCII tile grid (see TileShapes for the characters) plus a list of
-- objects. Object positions are in tiles: x = 4, y = 7 is the middle of column 4,
-- row 7 (counting from 0 at the top-left); halves like x = 4.5 sit between two tiles.

export type ObjectDef = {
	type: string, -- "spawn", "gold", "exitSwitch", "exitDoor", ... (more in later milestones)
	x: number,
	y: number,
	[string]: any, -- extra options, such as a direction or a patrol path
}

export type LevelDef = {
	id: string,
	name: string,
	mode: string, -- "solo", "coop", "race", "goldrush", "hunters" or "test"
	order: number?, -- sort position in level lists
	camera: ("fixed" | "follow")?, -- default: fixed if it fits one 31 x 23 screen, else follow
	grid: string,
	objects: { ObjectDef },
}

local Levels = {}

local byId: { [string]: LevelDef } = {}
local all: { LevelDef } = {}

for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") then
		local def = (require :: any)(child) :: LevelDef
		if byId[def.id] then
			error(`Two levels use the id "{def.id}"`)
		end
		byId[def.id] = def
		table.insert(all, def)
	end
end

table.sort(all, function(a, b)
	local ao, bo = a.order or math.huge, b.order or math.huge
	if ao ~= bo then
		return ao < bo
	end
	return a.id < b.id
end)

function Levels.get(id: string): LevelDef
	local def = byId[id]
	if not def then
		error(`No level with id "{id}"`)
	end
	return def
end

function Levels.list(mode: string?): { LevelDef }
	local result = {}
	for _, def in all do
		if mode == nil or def.mode == mode then
			table.insert(result, def)
		end
	end
	return result
end

return Levels
