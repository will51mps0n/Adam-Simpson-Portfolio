	[[
--!strict
-- Side-on camera, far away with a narrow field of view so the level looks flat.
--  * "fixed": frames the whole one-screen level, like the original game.
--  * "follow": for big arenas; keeps every target (player) in view, zooming out as
--    they spread apart and never showing past the level's outer wall.
-- The level is always centered in the screen area below the Roblox top bar and the
-- time bar, with a little padding around it.

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Units = require(Shared.Units)
local LevelBuilder = require(Shared.LevelBuilder)

type Region = { center: Vector2, size: Vector2 }

local CameraController = {}

local level: LevelBuilder.BuiltLevel? = nil
local targetSource: (() -> { Vector3 })? = nil
local smoothed: Region? = nil -- follow mode's current view, eased toward the goal each frame

local function wholeLevel(lvl: LevelBuilder.BuiltLevel): Region
	return { center = (lvl.boundsMin + lvl.boundsMax) / 2, size = lvl.boundsMax - lvl.boundsMin }
end

-- The smallest region that holds every target with some margin around it.
local function followGoal(lvl: LevelBuilder.BuiltLevel, targets: { Vector3 }): Region
	if #targets == 0 then
		return wholeLevel(lvl)
	end
	local lo = Vector2.new(math.huge, math.huge)
	local hi = -lo
	for _, p in targets do
		local flat = Vector2.new(p.X, p.Y)
		lo = lo:Min(flat)
		hi = hi:Max(flat)
	end
	local levelSize = lvl.boundsMax - lvl.boundsMin
	local margin = Units.studs(Config.FOLLOW_MARGIN_TILES * Config.TILE_PX)
	local minTall = math.min(Units.studs(Config.FOLLOW_MIN_VIEW_TILES * Config.TILE_PX), levelSize.Y)
	local size = hi - lo + Vector2.new(margin, margin) * 2
	size = Vector2.new(math.min(size.X, levelSize.X), math.clamp(size.Y, minTall, levelSize.Y))
	return { center = (lo + hi) / 2, size = size }
end

-- Keeps the view inside the level's outer wall along each axis where the level is
-- bigger than the view; centers the level along an axis where it is smaller.
local function clampAxis(center: number, half: number, lo: number, hi: number): number
	if hi - lo <= half * 2 then
		return (lo + hi) / 2
	end
	return math.clamp(center, lo + half, hi - half)
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	local lvl = level
	if not camera or not lvl then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local viewport = camera.ViewportSize
	local top = GuiService:GetGuiInset().Y + Config.CAMERA_HUD_TOP_PX
	if viewport.X < 2 or viewport.Y <= top then
		return
	end

	local region: Region
	if lvl.cameraMode == "follow" then
		local goal = followGoal(lvl, if targetSource then targetSource() else {})
		local current = smoothed
		if current then
			local alpha = 1 - math.exp(-Config.FOLLOW_SMOOTHING * dt)
			current.center = current.center:Lerp(goal.center, alpha)
			current.size = current.size:Lerp(goal.size, alpha)
			region = current
		else
			smoothed = goal
			region = goal
		end
	else
		region = wholeLevel(lvl)
	end

	-- Scale so the region fits the usable screen area (below the top bar, inside the padding).
	local pad = Config.CAMERA_PADDING_PX
	local usableW = math.max(viewport.X - 2 * pad, 1)
	local usableH = math.max(viewport.Y - top - 2 * pad, 1)
	local pxPerStud = math.min(usableW / region.size.X, usableH / region.size.Y)

	local center = Vector2.new(
		clampAxis(region.center.X, viewport.X / 2 / pxPerStud, lvl.boundsMin.X, lvl.boundsMax.X),
		clampAxis(region.center.Y, (viewport.Y - top) / 2 / pxPerStud, lvl.boundsMin.Y, lvl.boundsMax.Y)
	)

	-- Distance that makes the whole screen height span viewport.Y / pxPerStud studs.
	local visibleHeight = viewport.Y / pxPerStud
	local distance = (visibleHeight / 2) / math.tan(math.rad(Config.CAMERA_FOV) / 2)
	-- The usable area's middle is top / 2 pixels below the screen's middle, so aim that much higher.
	local focus = Vector3.new(center.X, center.Y + (top / 2) / pxPerStud, lvl.frontZ)

	camera.FieldOfView = Config.CAMERA_FOV
	camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, 0, distance), focus)
	camera.Focus = CFrame.new(focus)
end

function CameraController.start()
	RunService:BindToRenderStep("TinyNinjasCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

function CameraController.setLevel(lvl: LevelBuilder.BuiltLevel)
	level = lvl
	smoothed = nil -- jump straight to the new level instead of gliding
end

-- `source` returns the world positions the follow camera should keep in view
-- (living players). Pass nil to show the whole level.
function CameraController.setTargets(source: (() -> { Vector3 })?)
	targetSource = source
end

return CameraController
]],
	[[
--!strict
-- Milestone 1 test helper; real ninjas replace it in milestone 2.
--  * Press 1 or 2 (or click the bar at the bottom) to switch between the test levels.
--  * In the big arena, two balls stand in for players: move the red one with WASD and
--    the blue one with the arrow keys, and the follow camera keeps both in view.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Units = require(Shared.Units)
local CameraController = require(script.Parent.CameraController)
local LevelController = require(script.Parent.LevelController)

local TEST_LEVELS = { "test_shapes", "test_arena" }
local MARKER_SPEED = 30 -- studs per second

type MarkerKeys = {
	left: Enum.KeyCode,
	right: Enum.KeyCode,
	up: Enum.KeyCode,
	down: Enum.KeyCode,
	color: Color3,
}

local MARKER_KEYS: { MarkerKeys } = {
	{
		left = Enum.KeyCode.A,
		right = Enum.KeyCode.D,
		up = Enum.KeyCode.W,
		down = Enum.KeyCode.S,
		color = Color3.fromRGB(225, 60, 60),
	},
	{
		left = Enum.KeyCode.Left,
		right = Enum.KeyCode.Right,
		up = Enum.KeyCode.Up,
		down = Enum.KeyCode.Down,
		color = Color3.fromRGB(50, 110, 230),
	},
}

local CameraTest = {}

local levelIndex = 1
local markers: { BasePart } = {}
local bar: TextButton? = nil

local function makeBar(): TextButton
	local gui = Instance.new("ScreenGui")
	gui.Name = "CameraTest"
	gui.ResetOnSpawn = false

	local button = Instance.new("TextButton")
	button.AnchorPoint = Vector2.new(0.5, 1)
	button.Position = UDim2.new(0.5, 0, 1, -8)
	button.Size = UDim2.new(0.95, 0, 0, 28)
	button.BackgroundColor3 = Color3.new(0, 0, 0)
	button.BackgroundTransparency = 0.45
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14
	button.TextScaled = false
	button.TextTruncate = Enum.TextTruncate.AtEnd
	button.Parent = gui

	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(640, 28)
	limit.Parent = button
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return button
end

local function makeMarker(color: Color3, position: Vector3, parent: Instance): BasePart
	local marker = Instance.new("Part")
	marker.Name = "TestMarker"
	marker.Shape = Enum.PartType.Ball
	marker.Size = Vector3.one * 2.5
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanTouch = false
	marker.CanQuery = false
	marker.CastShadow = false
	marker.Material = Enum.Material.SmoothPlastic
	marker.Color = color
	marker.Position = position
	marker.Parent = parent
	return marker
end

local function markerPositions(): { Vector3 }
	local list = {}
	for _, marker in markers do
		table.insert(list, marker.Position)
	end
	return list
end

local function loadLevel(index: number)
	levelIndex = index
	local built = LevelController.load(TEST_LEVELS[index])
	table.clear(markers)

	local text
	if built.cameraMode == "follow" then
		local spawns = {}
		for _, object in built.def.objects do
			if object.type == "spawn" then
				table.insert(spawns, object)
			end
		end
		for i, keys in MARKER_KEYS do
			local spawn = spawns[i] or spawns[1]
			local x = if spawn then spawn.x else built.grid.width / 2
			local y = if spawn then spawn.y else built.grid.height / 2
			local position = Units.toWorld((x + 0.5) * Config.TILE_PX, (y + 0.5) * Config.TILE_PX, built.frontZ + 1)
			markers[i] = makeMarker(keys.color, position, built.model)
		end
		CameraController.setTargets(markerPositions)
		text = `{built.def.name}: move red with WASD, blue with the arrow keys. Press 1 / 2 to switch level`
	else
		CameraController.setTargets(nil)
		text = `{built.def.name}: the whole level fits on screen. Press 1 / 2 or click here to switch level`
	end
	if bar then
		bar.Text = text
	end
end

local function moveMarkers(dt: number)
	local built = LevelController.current()
	if not built then
		return
	end
	local function axis(negative: Enum.KeyCode, positive: Enum.KeyCode): number
		return (if UserInputService:IsKeyDown(positive) then 1 else 0)
			- (if UserInputService:IsKeyDown(negative) then 1 else 0)
	end
	for i, marker in markers do
		local keys = MARKER_KEYS[i]
		local direction = Vector3.new(axis(keys.left, keys.right), axis(keys.down, keys.up), 0)
		if direction.Magnitude > 0 then
			local p = marker.Position + direction.Unit * MARKER_SPEED * dt
			marker.Position = Vector3.new(
				math.clamp(p.X, built.boundsMin.X, built.boundsMax.X),
				math.clamp(p.Y, built.boundsMin.Y, built.boundsMax.Y),
				p.Z
			)
		end
	end
end

function CameraTest.start()
	local button = makeBar()
	bar = button
	button.Activated:Connect(function()
		loadLevel(levelIndex % #TEST_LEVELS + 1)
	end)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.One then
			loadLevel(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			loadLevel(2)
		end
	end)
	RunService.Heartbeat:Connect(moveMarkers)
	loadLevel(1)
end

return CameraTest
]],
	[[
--!strict
-- Owns the level on screen: builds it on this client and points the camera at it.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Levels = require(Shared.Levels)
local LevelBuilder = require(Shared.LevelBuilder)
local CameraController = require(script.Parent.CameraController)

local LevelController = {}

local current: LevelBuilder.BuiltLevel? = nil

function LevelController.load(id: string): LevelBuilder.BuiltLevel
	if current then
		current.model:Destroy()
	end
	local built = LevelBuilder.build(Levels.get(id), Workspace)
	current = built
	CameraController.setLevel(built)
	return built
end

function LevelController.current(): LevelBuilder.BuiltLevel?
	return current
end

return LevelController
]],
	[[
--!strict
-- Applies the flat, shadowless lighting from Config.LIGHTING on this client.

local Lighting = game:GetService("Lighting")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config)

local LightingSetup = {}

function LightingSetup.apply()
	local settings = Config.LIGHTING
	Lighting.Ambient = settings.Ambient
	Lighting.OutdoorAmbient = settings.OutdoorAmbient
	Lighting.Brightness = settings.Brightness
	Lighting.EnvironmentDiffuseScale = settings.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = settings.EnvironmentSpecularScale
	Lighting.ExposureCompensation = settings.ExposureCompensation
	Lighting.GlobalShadows = settings.GlobalShadows

	-- Studio templates add haze and glow effects that would tint the flat grey look.
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") then
			child.Enabled = false
		elseif child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
end

return LightingSetup
]],
}

-- Where each script tree goes: a path of existing containers, then the tree itself.
local MOUNTS = {
	{ parent = { "ReplicatedStorage" }, node =
		{ name = "Shared", className = "Folder", children = {
			{ name = "Config", className = "ModuleScript", source = 1 },
			{ name = "LevelBuilder", className = "ModuleScript", source = 2 },
			{ name = "LevelGrid", className = "ModuleScript", source = 3 },
			{ name = "Levels", className = "ModuleScript", source = 4, children = {
				{ name = "TestArena", className = "ModuleScript", source = 5 },
				{ name = "TestShapes", className = "ModuleScript", source = 6 },
			} },
			{ name = "TileShapes", className = "ModuleScript", source = 7 },
			{ name = "Units", className = "ModuleScript", source = 8 },
		} } },
	{ parent = { "ServerScriptService" }, node =
		{ name = "Server", className = "Script", source = 9 } },
	{ parent = { "StarterPlayer", "StarterPlayerScripts" }, node =
		{ name = "Client", className = "LocalScript", source = 10, children = {
			{ name = "CameraController", className = "ModuleScript", source = 11 },
			{ name = "CameraTest", className = "ModuleScript", source = 12 },
			{ name = "LevelController", className = "ModuleScript", source = 13 },
			{ name = "LightingSetup", className = "ModuleScript", source = 14 },
		} } },
}

-- Place settings from default.project.json.
local PROPERTIES = {
	{ "Players", "CharacterAutoLoads", function() return false end },
	{ "Lighting", "GlobalShadows", function() return false end },
	{ "Lighting", "Outlines", function() return false end },
	{ "Lighting", "Technology", function() return Enum.Technology.Voxel end },
}

local function create(node, parent)
	local instance = Instance.new(node.className)
	instance.Name = node.name
	if node.source then
		(instance :: any).Source = SOURCES[node.source]
	end
	for _, child in node.children or {} do
		create(child, instance)
	end
	instance.Parent = parent
	return instance
end

return function()
	for _, mount in MOUNTS do
		local parent: Instance = game:GetService(mount.parent[1])
		for i = 2, #mount.parent do
			parent = parent:WaitForChild(mount.parent[i])
		end
		local old = parent:FindFirstChild(mount.node.name)
		if old then
			old:Destroy()
		end
		create(mount.node, parent)
	end

	for _, entry in PROPERTIES do
		local ok, err = pcall(function()
			(game:GetService(entry[1]) :: any)[entry[2]] = entry[3]()
		end)
		if not ok then
			warn(`Tiny Ninjas: could not set {entry[1]}.{entry[2]}: {err}`)
		end
	end

	-- Studio templates add haze and glow effects that would tint the flat grey look.
	local Lighting = game:GetService("Lighting")
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	-- The game itself never uses HTTP; the install command turns it on again when needed.
	game:GetService("HttpService").HttpEnabled = false

	print(`Tiny Ninjas installed (build {BUILD}, {#SOURCES} scripts). Press Play to test, then File > Save.`)
end
